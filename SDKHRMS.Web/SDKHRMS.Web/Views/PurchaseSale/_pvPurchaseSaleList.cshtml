@model SDKHRMS.Entities.ViewModels.PurchaseSalesViewModel
<div id="DataGrid" class="">
    @if (Model.PurchaseSaleList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Bill No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            HSN/SAC
                        </th>
                        @if (@ViewBag.Type == "Purchase")
                        {
                            <th class="text-center" style="vertical-align: middle;">
                                Vender Name
                            </th>
                        }
                        else
                        {
                            <th class="text-center" style="vertical-align: middle;">
                                Client Name
                            </th>
                        }
                        <th class="text-center" style="vertical-align: middle;">
                            IsIGST
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            IGST(&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            CGST(&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            SGST(&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Amount(&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PurchaseSaleList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.PurchaseSaleDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.PurchaseSaleInvoiceNo
                            </td>
                            <td class="text-center">
                                @item.HSNSAC
                            </td>
                            @if (@ViewBag.Type == "Purchase")
                            {
                                <td class="text-center">@item.VenderName</td>
                            }
                            else
                            {
                                <td class="text-center">@item.ClientName</td>
                            }
                            <td class="text-center">
                                @item.IsIGST
                            </td>
                            <td class="text-center">
                                @item.IGST
                            </td>
                            <td class="text-center">
                                @item.CGST
                            </td>
                            <td class="text-center">
                                @item.SGST
                            </td>
                            <td class="text-center">
                                @item.TaxableAmount
                            </td>
                            <td class="text-center">
                                <div>
                                    @if (@ViewBag.Type == "Purchase")
                                    {
                                        <a href="@Url.Action("AddPurchase", new { ID = item.PurchaseSaleID})" data-toggle="tooltip" data-placement="bottom" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                        <form action="PurchaseSale/DeletePurchaseSale" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("DeletePurchaseSale", new { ID = item.PurchaseSaleID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.PurchaseSaleList.Count(), Type = "Purchase" })" class="delete" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.VenderName">
                                                <i class="glyphicon glyphicon-trash"></i>
                                            </a>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("AddSale", new { ID = item.PurchaseSaleID})" data-toggle="tooltip" data-placement="bottom" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                        <form action="PurchaseSale/DeletePurchaseSale" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("DeletePurchaseSale", new { ID = item.PurchaseSaleID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.PurchaseSaleList.Count(), Type = "Sale" })" class="delete" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.ClientName">
                                                <i class="glyphicon glyphicon-trash"></i>
                                            </a>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="hidden-xs col-md-3 col-sm-3">
                Showing @Model.PurchaseSaleList.Count() of @Model.TotalRecords Record(s)

            </div>
            @if (@ViewBag.Type == "Purchase")
            {
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/PurchaseSale/PurchaseList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("PurchaseList", new { PageNo = x, }))
                </div>
            }
            else
            {
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/PurchaseSale/PurchaseList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("SaleList", new { PageNo = x, }))
                </div>
            }

        </div>
    }
    else
    {
        <h3>No record found...</h3>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
