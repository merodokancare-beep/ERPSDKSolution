@model  SDKHRMS.Entities.ViewModels.PurchaseSalesViewModel
@{
    ViewBag.Title = "Purchase Manage";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@*@{
        List<string> PSType = new List<string> { "Purchase", "Sale" };
    }*@
<link href="~/Content/datepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        <div class="page-title-icon">
            <i class="glyphicon glyphicon-shopping-cart"></i>
        </div>
        <div>
            <div class="page-title-main-text linebreak">
                Purchase Manage
            </div>
            <div class="page-title-sub-text">Add Purchase</div>
        </div>
    </div>
    <div class="page-title-actions"></div>

</div>
@using (Html.BeginForm())
{
    <div class="page-content clearfix">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        @Html.HiddenFor(m => m.utblPurchaseSale.PurchaseSaleType, new { Value = "Purchase" })
        @if (@Model.utblPurchaseSale!=null)
        {
             @Html.HiddenFor(m => m.utblPurchaseSale.PurchaseSaleID)
        }
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.utblPurchaseSale.PurchaseSaleDate, new { @class = "control-label required" })
                    @if (@ViewBag.PurchaseID != 0)
                    {
                        @Html.TextBoxFor(m => m.utblPurchaseSale.PurchaseSaleDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Date", @id = "Dt", @Value = @Model.utblPurchaseSale.PurchaseSaleDate.ToString("dd MMM yyyy") })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.utblPurchaseSale.PurchaseSaleDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Date", @id = "Dt" })
                    }
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.PurchaseSaleDate)
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.utblPurchaseSale.PurchaseSaleInvoiceNo, new { @class = "control-label required" })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.PurchaseSaleInvoiceNo, new { @class = "form-control", autocomplete = "off", @placeholder = "Bill Number", @id = "bn" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.PurchaseSaleInvoiceNo)
                </div>
            </div>
        </div>
        <div class="col-md-12 margin-top20">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.utblPurchaseSale.HSNSAC, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.HSNSAC, new { @class = "form-control", autocomplete = "off", @placeholder = "HSN/SAC", @id = "hsn" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.HSNSAC)
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.utblPurchaseSale.VenderID, new { @class = "control-label required" })
                    @Html.DropDownListFor(m => m.utblPurchaseSale.VenderID, new SelectList(@Model.VendorDDList, "VenderID", "VenderName"), "--- Select Vendor ---", new { @class = "form-control", @id = "Vendor", autocomplete = "false" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.VenderID)
                </div>
            </div>
        </div>
        <div class="col-md-12 margin-top20">
            <div class="row" id="radiosec">
                <div class="col-md-1" id="radiobtn">
                    <label class="control-label required">Is IGST:</label>
                </div>
                <div class="col-md-1" id="radiobtn">
                    @Html.RadioButtonFor(m => m.utblPurchaseSale.IsIGST, true, new { @class = "isigst", @id = "Yes" })
                    @Html.LabelFor(m => m.utblPurchaseSale.IsIGST, "Yes", new { @for = "Yes" })
                </div>
                <div class="col-md-1" id="radiobtn">
                    @Html.RadioButtonFor(m => m.utblPurchaseSale.IsIGST, false, new { @class = "isigst", @id = "NO" })
                    @Html.LabelFor(m => m.utblPurchaseSale.IsIGST, "No", new { @for = "No" })
                </div>
                @Html.ValidationMessageFor(m => m.utblPurchaseSale.IsIGST)
            </div>
        </div>
        <div class="col-md-12">
            <div class="row" id="taxsec">
                <div class="col-md-4" id="igst">
                    @Html.LabelFor(m => m.utblPurchaseSale.IGST, new { @class = "control-label " })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.IGST, new { @class = "form-control rs", autocomplete = "off", @placeholder = "IGST Amount (Rs.)", @id = "hsn" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.IGST)
                </div>
                <div class="col-md-4" id="cgst">
                    @Html.LabelFor(m => m.utblPurchaseSale.CGST, new { @class = "control-label " })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.CGST, new { @class = "form-control rs", autocomplete = "off", @placeholder = "CGST Amount (Rs.)", @id = "hsn" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.CGST)
                </div>
                <div class="col-md-4" id="sgst">
                    @Html.LabelFor(m => m.utblPurchaseSale.SGST, new { @class = "control-label " })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.SGST, new { @class = "form-control rs", autocomplete = "off", @placeholder = "SGST Amount (Rs.)", @id = "sgst" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.SGST)
                </div>
                <div class="col-md-4" id="amt">
                    @Html.LabelFor(m => m.utblPurchaseSale.TaxableAmount, new { @class = "control-label " })
                    @Html.TextBoxFor(m => m.utblPurchaseSale.TaxableAmount, new { @class = "form-control rs", autocomplete = "off", @placeholder = "Amount (Rs.)", @id = "amt" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.TaxableAmount)
                </div>
            </div>
        </div>
        <div class="col-md-12 margin-top20">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.utblPurchaseSale.Description, new { @class = "control-label" })
                    @Html.TextAreaFor(m => m.utblPurchaseSale.Description, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter  Description", @style = "resize:none" })
                    @Html.ValidationMessageFor(m => m.utblPurchaseSale.Description)
                </div>
            </div>
        </div>
    </div>
    <div class="well well-sm no-margin-bottom col-md-12 col-lg-12 text-right">
        <div class="form-horizontal">
            @Html.ActionLink("Back to List", "PurchaseList", null, new { @class = "btn btn-default pull-left" })
            <input type="submit" value="Save" id="save" class="btn btn-primary" />
        </div>
    </div>
}

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datepicker/bootstrap-datetimepicker.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            $('#taxsec').hide()
            $('.isigst').prop('checked', false);
            $('#Dt').datetimepicker({
                maxDate: '0d',
                format: "dd M yyyy",
                weekStart: 1,
                todayBtn: 1,
                autoclose: 1,
                todayHighlight: 1,
                startView: 2,
                minView: 2,
                forceParse: 0
            })
            if ('@ViewBag.IsIGST' != "") {
                if ('@ViewBag.IsIGST' == true || $("#Yes").is(":checked")) {
                    $("#taxsec").show();
                    $("#igst").show();
                    $("#cgst").hide();
                    $("#sgst").hide();
                    $("#amt").show();
                }
                else {
                    $("#taxsec").show();
                    $("#igst").hide();
                    $("#cgst").show();
                    $("#sgst").show();
                    $("#amt").show();
                }
            }
            $(function () {
                $(".isigst").on('change', function () {
                    if ($("#Yes").is(":checked")) {
                        $("#taxsec").show();
                        $("#igst").show();
                        $("#cgst").hide();
                        $("#sgst").hide();
                        $("#amt").show();
                    }
                    else {
                        $("#taxsec").show();
                        $("#igst").hide();
                        $("#cgst").show();
                        $("#sgst").show();
                        $("#amt").show();
                    }
                });

            });
        });
        $(".rs").on("blur", function () {
            if ($(this).val().trim().length == 0) {
                $(this).val("0");
            }
        });
        //trigger blur once for the initial setting:
        $(".rs").trigger("blur");
    </script>
}




