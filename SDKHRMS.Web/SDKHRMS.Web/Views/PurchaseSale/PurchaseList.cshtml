@model  SDKHRMS.Entities.ViewModels.PurchaseSalesViewModel
@{
    ViewBag.Title = "Purchase Manage";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@{
    List<string> PSType = new List<string> { "Purchase", "Sale" };
}
<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        <div class="page-title-icon">
            <i class="glyphicon glyphicon-shopping-cart"></i>
        </div>
        <div>
            <div class="page-title-main-text linebreak">
                Purchase Manage
            </div>
            <div class="page-title-sub-text">Purchase List</div>
        </div>
    </div>
    <div class="page-title-actions">
    </div>
</div>
<div class="page-content">
    <div class="well well-sm clearfix">
        <div class="col-md-9 no-horizantal-padding pull-left">
            <form method="get" action="@Url.Action("PurchaseList")" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid">
                <div class="input-group">
                    <input type="text" name="searchTerm" autocomplete="off" class="form-control" placeholder="Search by Vender name..." />
                    <span class="input-group-btn">
                        <button class="btn btn-success pull-left" id="search-btn" value="Search By Name"> <i class="glyphicon glyphicon-search"></i> </button>
                    </span>
                </div>

            </form>
        </div>
        <div class="col-md-3 no-horizantal-padding pull-right">
            &nbsp;&nbsp;<a href="@Url.Action("PurchaseList")" class="btn btn-success hidden" id="clearSearchBtn">Clear !</a>
            @Html.ActionLink("Add Purchase", "AddPurchase", null, new { @class = "btn btn-danger pull-right" })
        </div>
    </div>

    @*<div class="well well-sm clearfix">
        <div class="row">
            <div class="col-md-9">
                @Html.LabelFor(m => m.utblPurchaseSale.PurchaseSaleType, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.utblPurchaseSale.PurchaseSaleType, new SelectList(PSType, @ViewBag.Type), "----Select Type----", new { @class = "form-control", id = "PSType" })
            </div>
            <div class="col-md-3 pull-right" style="margin-top: 23px;">
                @Html.ActionLink("Add Purchasse & Sale", "AddPurchaseSale", null, new { @class = "btn btn-danger pull-right" })
            </div>
        </div>
    </div>*@
    <div class="" id="DataGrid">
        @Html.Partial("_pvPurchaseSaleList", Model)
    </div>
</div>
@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
    @*<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('change', '#PSType', function () {    // for on change
            $('#DataGrid').show();
            $.ajax({
                type: 'GET',
