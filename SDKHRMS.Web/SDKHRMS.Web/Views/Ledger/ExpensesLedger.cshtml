@model  SDKHRMS.Entities.ViewModels.ExpensesLedgerVM
@{
    ViewBag.Title = "Expenses Ledger";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Expenses Head Ledger</h5>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="card ribbon-wrapper">
            <div class="card-header card-buttons">
                <form method="get" action="/Ledger/ExpensesLedger" class="row" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid" id="sForm">
                    <div class="form-group mb-0 row">
                        <div class="col-md-4 mb-3">
                            @Html.DropDownList("ExpHead", new SelectList(Model.ExpenseTypeDD, "ExpenseTypeID", "ExpenseType", ViewBag.ExpHead), "----Select Expenses Head----", new { @class = "form-control ddSelect2", id = "exp" })
                        </div>
                        <div class="col-md-3 mb-3">
                            <input class="form-control dtp" type="text" placeholder="Start Date" id="startdate" value="@(Model.StartDate=="--"?"":Model.StartDate)" name="StartDate" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <input class="form-control dtp" type="text" placeholder="End Date" id="enddate" value="@(Model.EndDate=="--"?"":Model.EndDate)" name="EndDate" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <button onclick="location.href='/Ledger/ExpensesLedger'" type="button" class="btn btn-primary" id="clearSearchBtn">Clear Results</button>
                        </div>
                    </div>

                </form>
            </div>
            <div class="card-body">
                @Html.Partial("_pvExpenseLedger", Model)
            </div>

        </div>
    </div>
</div>
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $(document).on('change', '#exp', function () {
                $('#sForm').submit();
            })
            $('.dtp').datetimepicker({
                theme: 'light',
                timepicker: false,
                format: 'd M Y',
                scrollMonth: false,
                scrollInput: false
            }).on('change', function () {
                $('#sForm').submit();
            });
        });
    </script>
}





