@model SDKHRMS.Entities.ViewModels.PettyCashVM
@{
    ViewBag.Title = "Petty cash Book";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Petty Cash Details</h5>
        <div class="list-btn">
            <ul class="filter-list">
                <li>
                    <a class="btn btn-primary" href="/PettyCash/AddPettyCash">
                        <i class="fa fa-plus-circle me-2" aria-hidden="true"></i>Add New Petty Cash
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header card-buttons">
                <form method="get" action="/PettyCash/PettyCashBook" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid" id="sForm">
                    <div class="form-group mb-0 row">
                        <div class="col-md-5">
                            @Html.DropDownList("YearNo", new SelectList(Model.YearDD, "YearNo", "YearNo", @ViewBag.YearNo), "----Select Year----", new { @class = "form-control ddSelect2", id = "yr" })
                        </div>
                        <div class="col-md-5">
                            @Html.DropDownList("MonthNo", new List<SelectListItem>{
                                new SelectListItem{Text="January", Value="1"},
                                new SelectListItem{Text="February", Value="2"},
                                new SelectListItem{Text="March", Value="3"},
                                new SelectListItem{Text="April", Value="4"},
                                new SelectListItem{Text="May", Value="5"},
                                new SelectListItem{Text="June", Value="6"},
                                new SelectListItem{Text="July", Value="7"},
                                new SelectListItem{Text="August", Value="8"},
                                new SelectListItem{Text="September", Value="9"},
                                new SelectListItem{Text="October", Value="10"},
                                new SelectListItem{Text="November", Value="11"},
                                new SelectListItem{Text="December", Value="12"}, }, "--- Select Month ---", new { @class = "form-control ddSelect2", Value = @ViewBag.MonNo, @id = "month" })
                        </div>
                        <div class="col-md-2">
                            <button onclick="location.href='@Url.Action("PettyCashBook")'" type="button" class="btn btn-primary" id="clearSearchBtn">Clear Results</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body">
                @Html.Partial("_pvPettyCashBook", Model)
            </div>
        </div>
    </div>
</div>




