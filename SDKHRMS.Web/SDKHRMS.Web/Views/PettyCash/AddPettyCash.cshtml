                            @Html.ValidationMessageFor(m => m.PettyCash.CreditAmt)
                        </div>
                        <div class="col-md-6  margin-top10 hidden" id="bankdiv">
                            <label class="required">Bank Name</label>
                            @Html.DropDownListFor(m => m.PettyCash.BankID, new SelectList(Model.BankDD, "BankID", "BankName"), "---Select Bank Name---", new { @class = "form-control ddSelect2", @id = "BankID" })
