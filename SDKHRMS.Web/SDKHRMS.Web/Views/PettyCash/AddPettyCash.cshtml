                        </div>
                        <div class="col-md-12 margin-top10">
                            <label class="required">Remarks</label>
                            @Html.TextAreaFor(m => m.PettyCash.Remarks, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PettyCash.Remarks)
                        </div>
                        <input type="hidden" name="ExpHeadName" value="" id="ExpHead" />
                    </div>
                </div>
            </div>
        </div>
        <div class="well well-sm no-margin-bottom col-md-12 col-lg-12 text-right">
            <div class="form-horizontal">
                <a class="btn btn-default pull-left" href="/PaymentReceivable/index">Back to List</a>
                <input type="submit" value="Save" id="save" class="btn btn-primary" />
            </div>
        </div>
    </form>*@

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>

@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#txtdate').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                //minDate: 0
            });

            @*loadPaySection('@mode');*@
            var ChangeMode = function () {
                if ($('#ddExpense').val() != "") {
                    var SelectType = $("#ddExpense").find('option:selected').text();
                    $('#ExpHead').val(SelectType)
                    if (SelectType == 'Bank') {
                        $('#bankdiv').removeClass("hidden");
                    }
                    else {
                        $('#bankdiv').addClass("hidden");
                    }
                }
            }
            $(document).on('change', '#ddExpense', ChangeMode);
            ChangeMode();

        });
    </script>
}



