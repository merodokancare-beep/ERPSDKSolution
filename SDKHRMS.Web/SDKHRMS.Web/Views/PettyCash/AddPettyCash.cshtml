                            @Html.ValidationMessageFor(m => m.PettyCash.ExpenseTypeID)
                        </div>
                        <div class="col-md-3 margin-top10">
                            <label class="required">Payment Receive Date</label>
                            @Html.TextBoxFor(m => m.PettyCash.TransDate, new { @class = "form-control", @id = "txtdate", @Value = Model.PettyCash != null ? Model.PettyCash.TransDate.ToString("dd MMM yyyy") : "" })
                            @Html.ValidationMessageFor(m => m.PettyCash.TransDate)
                        </div>
