@model  SDKHRMS.Entities.ViewModels.DirectPaymentdAdd
@{
    ViewBag.Title = "Direct Payment";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/Plugins/Select2/select2.min.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        @*<h5>Payment Manager</h5>*@
        <h5>Direct Payment Disburse</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Edit Direct Payment Disbursed Details</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("edit", "DirectPayment", FormMethod.Post, new { data_toggle = "validator", @novalidate = true, enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(m => m.DirectPayment.DirectPaymentID)
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Expense Head</label>
                                @Html.DropDownListFor(m => m.DirectPayment.ExpenseTypeID, new SelectList(Model.ExpenseTypeDD, "ExpenseTypeID", "ExpenseType"), "-- Select Expense Head --", new { @class = "form-control ddSelect2", @id = "ddExpense" })
                                @Html.ValidationMessageFor(m => m.DirectPayment.ExpenseTypeID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="required">Payment Date</label>
                                @Html.TextBoxFor(m => m.DirectPayment.PaymentDate, new { @class = "form-control", @id = "txtdate", @Value = Model.DirectPayment.PaymentDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.DirectPayment.PaymentDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Project Name (<span class="text-muted">If Applicable</span>)</label>
                                @Html.DropDownListFor(m => m.DirectPayment.ProjectID, new SelectList(Model.ProjectDD, "ProjectID", "ProjectName"), "-- Select Project --", new { @class = "form-control ddSelect2", @id = "ddProject" })
                                @Html.ValidationMessageFor(m => m.DirectPayment.ProjectID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="required">Payment Amount</label>
                                @Html.TextBoxFor(m => m.DirectPayment.PaymentAmt, new { @class = "form-control", @Value = Model.DirectPayment.PaymentAmt.ToString("0.00") })
                                @Html.ValidationMessageFor(m => m.DirectPayment.PaymentAmt)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="required">Payment Purpose</label>
                                @Html.TextAreaFor(m => m.DirectPayment.Purpose, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.DirectPayment.Purpose)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="required">Payment Remarks</label>
                                @Html.TextAreaFor(m => m.DirectPayment.Remarks, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.DirectPayment.Remarks)
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("index")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>

@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            //$('.ddSelect2').select2({ width: '100%' });
            $('#txtdate').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                //minDate: 0
            });
        });
    </script>
}



