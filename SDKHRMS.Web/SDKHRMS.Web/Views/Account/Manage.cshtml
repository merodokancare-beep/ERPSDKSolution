@using SDKHRMS.Web.Models;
@using Microsoft.AspNetCore.Identity;
@{
    ViewBag.Title = "Manage Account";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        @*<div class="page-title-icon">
                <i class="glyphicon glyphicon-user"></i>
            </div>*@
        <div>
            <div class="page-title-main-text linebreak">
                Change Password
            </div>
            <div class="page-title-sub-text">
                <p>You're changing password for <strong>@User.Identity.GetUserName()</strong>.</p>
            </div>
        </div>
    </div>
    <div class="page-title-actions"></div>

</div>

<div class="page-content clearfix">
    <div class="col-md-12">
        @if (ViewBag.HasLocalPassword)
        {
            @Html.Partial("_ChangePasswordPartial")
        }
        else
        {
            @Html.Partial("_SetPasswordPartial")
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
