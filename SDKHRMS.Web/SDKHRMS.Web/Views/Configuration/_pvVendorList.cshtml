@model SDKHRMS.Entities.ViewModels.VendorClientVM

<div id="DataGrid" class="">
    @if (Model.VendorDetailsList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Client/Vendor Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            GST No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Contact Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Contact No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Email ID
                        </th>
                        @*<th class="text-center" style="vertical-align: middle;">
                                Client/Vendor Address
                            </th>*@
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.VendorDetailsList)
                    {
                        <tr>
                            <td class="text-left">
                                @item.VenderName
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(@item.GSTNo))
                                {
                                    @item.GSTNo
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(@item.ContactName))
                                {
                                    @item.ContactName
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(@item.ContactNo))
                                {
                                    @item.ContactNo
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(@item.Email))
                                {
                                    @item.Email
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            @*<td class="text-left">
                                    @item.VenderAddress
                                </td>*@
                            <td class="text-center" style="width: 100px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        <a href="@Url.Action("editVendor", new { id = item.VenderID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray">
                                            <i class="fe fe-edit-2"></i>
                                        </a>
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <form action="Cofiguration/DeleteVendor" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("deleteVendor", new { id = item.VenderID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.VendorDetailsList.Count() })" class="delete btn-action-icon bg-danger-light" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.VenderName">
                                                <i class="fe fe-trash-2"></i>
                                            </a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.VendorDetailsList.Count() of @Model.TotalRecords Record(s)

                </div>
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/Vendorlist">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("VendorList", new { PageNo = x }))
                </div>*@
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/Vendorlist">
                <span class="badge bg-warning text-dark">Showing @Model.VendorDetailsList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("VendorList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>

