@model SDKHRMS.Entities.ViewModels.ReferenceNoVM

<div id="DataGrid" class="">
    @if (Model.MstReferenceNumberList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Financial Year
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Prefix
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Sufix
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Start No
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Current No
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MstReferenceNumberList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.FiscalYearSymbol
                            </td>
                            <td class="text-center">
                                @item.Prefix
                            </td>
                            <td class="text-center">
                                @item.Suffix
                            </td>
                            <td class="text-center">
                                @item.StartNo
                            </td>
                            <td class="text-center">
                                @item.CurrentNo
                            </td>
                            <td class="text-center" style="width: 20px;">
                                <div class="text-center">
                                    <a href="@Url.Action("EditMstReferenceNumber", new { id = item.RefID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit"  class="btn-action-icon bg-light-gray ms-2">
                                        <i class="fe fe-edit-2"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.MstReferenceNumberList.Count() of @Model.TotalRecords Record(s)

                </div>
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/MstReferenceNumberList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("MstReferenceNumberList", new { PageNo = x }))
                </div>*@
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/MstReferenceNumberList">
                <span class="badge bg-warning text-dark">Showing @Model.MstReferenceNumberList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("MstReferenceNumberList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <h3>No record found...</h3>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>



