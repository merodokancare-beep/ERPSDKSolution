@model  SDKHRMS.Entities.ViewModels.ExpenseTypeADD
@{
    ViewBag.Title = "Configuration : ExpenseType Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        <h5>Expense Type Master</h5>
    </div>
</div>


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Configure Expense Type</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("AddExpenseType", "Configuration", FormMethod.Post, new {  }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                <div class="row">
                    <div class="col-xl-12">
                        <div class="form-group row">
                            @Html.LabelFor(m => m.utblMstExpenseType.ExpenseType, new { @class = "control-label required" })
                            @Html.TextBoxFor(m => m.utblMstExpenseType.ExpenseType, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter ExpenseType Name" })
                            @Html.ValidationMessageFor(m => m.utblMstExpenseType.ExpenseType)
                        </div>
                    </div>
                    <div class="col-xl-12">
                        <div class="form-group row">
                            @Html.LabelFor(m => m.utblMstExpenseType.Description, new { @class = "control-label required" })
                            @Html.TextAreaFor(m => m.utblMstExpenseType.Description, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Description" })
                            @Html.ValidationMessageFor(m => m.utblMstExpenseType.Description)
                        </div>
                    </div>
                    <div class="col-xl-12">
                        <label class="me-4">@Html.CheckBoxFor(m => m.utblMstExpenseType.IsProjectRelated) Is Project Related</label>
                        <label>@Html.CheckBoxFor(m => m.utblMstExpenseType.CanReceiveDirectPayment, new { @id = "chkPayment" })  Receive Direct Payments</label>
                    </div>
                    <div class="col-xl-12">
                        <div class="form-group row  d-none" id="opening-div">
                            <div class="col-md-4 m-0 ps-0">
                                <label class="required">Opening Amount</label>
                                @Html.TextBoxFor(m => m.utblMstExpenseType.OpeningAmount, new { @class = "form-control", @id = "txtAmount" })
                                @Html.ValidationMessageFor(m => m.utblMstExpenseType.OpeningAmount)
                            </div>
                            <div class="col-md-4 m-0">
                                <label class="required">Opening Date</label>
                                @Html.TextBoxFor(m => m.utblMstExpenseType.OpeningDate, new { @class = "form-control", @id = "txtdate" })
                                @Html.ValidationMessageFor(m => m.utblMstExpenseType.OpeningDate)
                            </div>
                            <div class="col-md-4 m-0">
                                <figure class="mt-5">
                                    <figcaption class="blockquote-footer text-info">
                                        Opening amount can be either <cite title="Source Title">in positive(payable) or negative(receivable) values.</cite>
                                    </figcaption>
                                </figure>
                            </div>
                        </div>
                    </div>

                </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("ExpenseTypelist")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>

@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            $('#txtdate').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                minDate: 0
            });

            if ($('#chkPayment').is(':checked')) {
                $('#opening-div').removeClass('d-none');
            }

            $('#chkPayment').on('click', function () {
                if ($(this).is(':checked')) {
                    $('#opening-div').removeClass('d-none');
                } else {
                    $('#opening-div').addClass('d-none');
                    $('#txtAmount').val('');
                    $('#txtdate').val('');
                }
            });
        });
    </script>
}



