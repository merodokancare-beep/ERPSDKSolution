@model SDKHRMS.Entities.ViewModels.MstConfigurationViewModel
<div id="DataGrid" class="">
    @if (Model.EmpAttDevMappingList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align:middle">
                            Employee ID
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Employee Name
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Device ID
                        </th>
                        @*<th class="text-center" style="vertical-align:middle">
                            Action
                        </th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.EmpAttDevMappingList)
                    {
                        <tr>
                            <td class="text-center" style="vertical-align:middle">
                                @item.EmployeeID
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.EmployeeName
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.EmpDeviceID
                            </td>
                            @*<td class="text-center" style="width: 70px;">
                                <div style="float:left; padding-right: 10px;">
                                    <form action="Cofiguration/DeleteEmpAttMap" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                        @Html.AntiForgeryToken()
                                        <a href="@Url.Action("DeleteEmpAttMap", new { id = item.EmpDeviceMappingID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.EmpAttDevMappingList.Count() })" class="delete" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.EmployeeName">
                                            <i class="glyphicon glyphicon-trash"></i>
                                        </a>
                                    </form>
                                </div>
                            </td>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="hidden-xs col-md-3 col-sm-3">
                Showing @Model.EmpAttDevMappingList.Count() of @Model.TotalRecords Record(s)
            </div>
            <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/EmpAttendanceMapping">
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("EmpAttendanceMapping", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <h3 class="pull-left">No record found...</h3>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
