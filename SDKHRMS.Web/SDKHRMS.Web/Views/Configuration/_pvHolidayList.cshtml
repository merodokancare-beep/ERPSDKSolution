@model SDKHRMS.Entities.ViewModels.HolidayVM

<div id="DataGrid" class="">
    @if (Model.HolidayList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Holiday Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Date From
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Date To
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            No Of Days
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HolidayList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.HolidayName
                            </td>
                            <td class="text-center">
                                @item.DateFrom.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.DateTo.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.NoofDays
                            </td>
                            <td class="text-center" style="width: 100px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        <a href="@Url.Action("editHoliday", new { id = item.HolidayID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray">
                                            <i class="fe fe-edit-2"></i>
                                        </a>
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <form action="Cofiguration/Delete" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("deleteHoliday", new { id = item.HolidayID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage,SearchTerm=ViewBag.SearchTerm, ListCount = Model.HolidayList.Count() })" class="delete btn-action-icon bg-danger-light" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.HolidayName">
                                                <i class="fe fe-trash-2"></i>
                                            </a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-lg-3 col-sm-3 ms-2 text-white">
                    Showing @Model.HolidayList.Count() of @Model.TotalRecords Record(s)
                </div>*@
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/HolidayList">
                <span class="badge bg-warning text-dark">Showing @Model.HolidayList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("HolidayList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
</div>
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>

