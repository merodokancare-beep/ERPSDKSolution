@model SDKHRMS.Entities.ViewModels.FinancialYearVM

<div id="DataGrid" class="">
    @if (Model.FinancialYearList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Financial Year
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Start Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            End Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Active
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FinancialYearList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.FiscalYearSymbol
                            </td>
                            <td class="text-center">
                                @item.StartDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @if (@item.Active == true)
                                {
                                    <i class="fe fe-check-circle text-success"></i>
                                }
                                else
                                {
                                    <i class="fe fe-minus text-danger-light"></i>
                                }
                            </td>
                            <td class="text-center" style="width: 20px;">
                                <div class="text-center">
                                    <a href="@Url.Action("EditFinancialYear", new { id = item.FiscalID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="ms-2 btn-action-icon bg-light-gray">
                                        <i class="fe fe-edit-2"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.FinancialYearList.Count() of @Model.TotalRecords Record(s)

                </div>
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/FinancialYearList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("FinancialYearList", new { PageNo = x }))
                </div>*@

            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/FinancialYearList">
                <span class="badge bg-warning text-dark">Showing @Model.FinancialYearList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("FinancialYearList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>



