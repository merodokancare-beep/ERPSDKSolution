@model SDKHRMS.Entities.ViewModels.MstConfigurationViewModel

<div id="DataGrid" class="">
    @if (Model.ClientList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Client Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            GSTNo
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Contact No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Address
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClientList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.ClientName
                            </td>
                            <td class="text-center">
                                @item.GSTNo
                            </td>
                            <td class="text-center">
                                @item.ContactNo
                            </td>
                            <td class="text-center">
                                @item.ClientAddress
                            </td>
                            <td class="text-center" style="width: 70px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        <a href="@Url.Action("editClient", new { id = item.ClientID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </a>
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <form action="Cofiguration/Delete" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("deleteClient", new { id = item.ClientID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage,SearchTerm=ViewBag.SearchTerm, ListCount = Model.ClientList.Count() })" class="delete" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.ClientName">
                                                <i class="glyphicon glyphicon-trash"></i>
                                            </a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="hidden-xs col-md-3 col-sm-3">
                Showing @Model.ClientList.Count() of @Model.TotalRecords Record(s)

            </div>
            <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/ClientList">
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("ClientList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <h3>No record found...</h3>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>

