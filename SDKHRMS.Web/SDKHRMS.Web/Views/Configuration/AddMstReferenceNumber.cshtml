@model  SDKHRMS.Entities.ViewModels.ReferenceNoAdd
@{
    ViewBag.Title = "Configuration : Reference Number Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<div class="page-header">
    <div class="content-page-header">
        <h5>Ref. No. Master</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Configure Reference Number</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("addmstreferencenumber", "Configuration", FormMethod.Post, new { data_toggle = "validator", @novalidate = true }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.MstReferenceNumber.FiscalYearSymbol, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.MstReferenceNumber.FiscalYearSymbol, new { @class = "form-control", @autocomplete = "off", @placeholder = "FiscalYear Symbol E.g: 2020-21" })
                                @Html.ValidationMessageFor(m => m.MstReferenceNumber.FiscalYearSymbol)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.MstReferenceNumber.Prefix, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.MstReferenceNumber.Prefix, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Prefix  E.g: SDK" })
                                @Html.ValidationMessageFor(m => m.MstReferenceNumber.Prefix)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.MstReferenceNumber.Suffix, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.MstReferenceNumber.Suffix, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Suffix  E.g: Inv" })
                                @Html.ValidationMessageFor(m => m.MstReferenceNumber.Suffix)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.MstReferenceNumber.StartNo, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.MstReferenceNumber.StartNo, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Start No.  E.g: 1" })
                                @Html.ValidationMessageFor(m => m.MstReferenceNumber.StartNo)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.MstReferenceNumber.CurrentNo, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.MstReferenceNumber.CurrentNo, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Current No.  E.g: 5" })
                                @Html.ValidationMessageFor(m => m.MstReferenceNumber.CurrentNo)
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("MstReferenceNumberlist")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@*@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
}*@






