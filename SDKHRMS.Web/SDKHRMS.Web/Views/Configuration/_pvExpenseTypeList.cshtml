@model SDKHRMS.Entities.ViewModels.ExpenseTypeViewModel

<div id="DataGrid" class="">
    @if (Model.ExpenseTypeList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            ExpenseType Name
                        </th>
                        <th class="text-center" style="vertical-align: middle; ">
                            ExpenseType Details
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Opening Amount
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExpenseTypeList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.ExpenseType
                            </td>
                            <td class="">
                                <span>
                                    Project Related:
                                    @if (item.IsProjectRelated)
                                    {
                                        <label class="bg-success-light"> Yes</label>
                                    }
                                    else
                                    {
                                        <label class="bg-danger-light"> No</label>
                                    }
                                </span>
                                <br />
                                <span>
                                    Receive Direct Payments:
                                    @if (item.CanReceiveDirectPayment)
                                    {
                                        <label class="bg-success-light"> Yes</label>
                                    }
                                    else
                                    {
                                        <label class="bg-danger-light"> No</label>
                                    }
                                </span>
                                <br />
                                <span>Description: <label class="text-primary">@item.Description</label></span>
                            </td>
                            <td class="text-center">
                                @if (item.CanReceiveDirectPayment)
                                {
                                    <p>Rs. @item.OpeningAmount.Value.ToString("0.00")</p><br />
                                    <p>As On : @item.OpeningDate.Value.ToString("dd MMM yyyy")</p>
                                }
                                else
                                {
                                    <p class="badge bg-secondary">N/A</p>
                                }
                            </td>
                            <td class="text-center" style="width: 100px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        <a href="@Url.Action("editExpenseType", new { id = item.ExpenseTypeID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray">
                                            <i class="fe fe-edit-2"></i>
                                        </a>
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <form action="Cofiguration/Delete" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("deleteExpenseType", new { id = item.ExpenseTypeID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage,SearchTerm=ViewBag.SearchTerm, ListCount = Model.ExpenseTypeList.Count() })" class="delete btn-action-icon bg-danger-light" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.ExpenseType">
                                                <i class="fe fe-trash-2"></i>
                                            </a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.ExpenseTypeList.Count() of @Model.TotalRecords Record(s)

                </div>
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/ExpenseTypeList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("ExpenseTypeList", new { PageNo = x }))
                </div>*@
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/ExpenseTypeList">
                <span class="badge bg-warning text-dark">Showing @Model.ExpenseTypeList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("ExpenseTypeList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>

