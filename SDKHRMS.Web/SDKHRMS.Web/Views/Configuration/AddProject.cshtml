@model  SDKHRMS.Entities.ViewModels.ProjectAdd
@{
    ViewBag.Title = "Configuration : Project Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
@*<link href="~/Content/Plugins/Select2/select2.min.css" rel="stylesheet" />*@
<div class="page-header">
    <div class="content-page-header">
        <h5>Project Master</h5>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Add Project Details</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("AddProject", "Configuration", FormMethod.Post, new { id = "Proj", role = "form", enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.VendorID, new { @class = "control-label required" })
                                @Html.DropDownListFor(m => m.ProjectModelAdd.VendorID, new SelectList(@Model.VendorDDList, "VenderID", "VenderName"), "--- Select Client/Vendor ---", new { @class = "form-control  ddSelect2", @id = "Vendor", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.VendorID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.ProjectName, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.ProjectName, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Project Name" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.ProjectName)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.ProjStartDate, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.ProjStartDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Start Date", @id = "dtpstart" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.ProjStartDate)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.WODate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.WODate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Work Order Date", @id = "dtpwo" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.WODate)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.WOPath, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.WOFile, new { @type = "file", @accept = ".pdf,.jpg,.png,.jpeg", @class = "btn btn-primary col-lg-6", @id = "WO" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.WOPath)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.ProjValue, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.ProjValue, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Project Cost" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.ProjValue)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.ProjEndDate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.ProjEndDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select End Date", @id = "dtpend" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.ProjEndDate)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.WONo, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.ProjectModelAdd.WONo, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Work Order No." })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.WONo)
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.PCCPath, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.PCCFile, new { @type = "file", @accept = ".pdf,.jpg,.png,.jpeg", @class = "btn btn-primary col-lg-6", @id = "PCC" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.PCCPath)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ProjectModelAdd.ProjDescription, new { @class = "control-label required" })
                                @Html.TextAreaFor(m => m.ProjectModelAdd.ProjDescription, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Description", @style = "resize:none;" })
                                @Html.ValidationMessageFor(m => m.ProjectModelAdd.ProjDescription)
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        @*<button type="submit" class="btn btn-primary">
                                Submit
                            </button>*@
                        <button type="reset" onclick="location.href='@Url.Action("ProjectOverView", "Projects", new { Area = "" })'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>

                }

            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#dtpstart').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            })
            $('#dtpend').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                //minDate: 0
            })
            $('#dtpwo').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                //minDate: 0
            })
        });

    </script>
}


