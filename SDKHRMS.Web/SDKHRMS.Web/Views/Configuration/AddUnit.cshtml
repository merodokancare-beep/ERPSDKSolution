@model  SDKHRMS.Entities.Models.utblMstUnit
@{
    ViewBag.Title = "Configuration : Unit Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<div class="page-header">
    <div class="content-page-header">
        <h5>Unit Master</h5>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Add Units</h5>
            </div>
            <div class="card-body">
                <form action="/Configuration/AddUnit" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @if (Model != null)
                    {
                        @Html.HiddenFor(m => m.UnitID)
                    }
                    <div class="form-group row">
                        <label class="col-form-label col-md-2">Unit Name</label>
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.UnitName, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Unit Name" })
                            @Html.ValidationMessageFor(m => m.UnitName)
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-form-label col-md-2">Textarea</label>
                        <div class="col-md-10">
                            @Html.TextAreaFor(m => m.UnitDescription, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Unit Description", @row = 5, @col = 5 })
                            @Html.ValidationMessageFor(m => m.UnitDescription)
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("Unitlist")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
