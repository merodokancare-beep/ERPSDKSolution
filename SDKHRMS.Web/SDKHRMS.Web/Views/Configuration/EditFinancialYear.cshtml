@model  SDKHRMS.Entities.ViewModels.FinancialYearAdd
@{
    ViewBag.Title = "Configuration : Financial Year Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Financial Year Master</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Configure Financial Year</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("EditFinancialYear", "Configuration", FormMethod.Post, new { data_toggle = "validator", @novalidate = true }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(m => m.FinancialYear.FiscalID)
                    @Html.HiddenFor(m => m.PageParameter.PageNo)
                    @Html.HiddenFor(m => m.PageParameter.PageSize)
                    @Html.HiddenFor(m => m.PageParameter.SearchTerm)
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.FinancialYear.StartDate, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.FinancialYear.StartDate, new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Start date", @id = "startdt", @Value = @Model.FinancialYear.StartDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.FinancialYear.StartDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.FinancialYear.EndDate, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.FinancialYear.EndDate, new { @class = "form-control", @autocomplete = "off", @placeholder = "Select End Date", @id = "enddt", @Value = @Model.FinancialYear.EndDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.FinancialYear.EndDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.FinancialYear.FiscalYearSymbol, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.FinancialYear.FiscalYearSymbol, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Financial Year Symbol" })
                                @Html.ValidationMessageFor(m => m.FinancialYear.FiscalYearSymbol)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-check mt-3">

                                @Html.CheckBoxFor(m => m.FinancialYear.Active, new { @checked = "true", @class = "form-check-input" })
                                <label class="form-check-label"
                                       for="validationFormCheck1">Is Active</label>
                                @Html.ValidationMessageFor(m => m.FinancialYear.Active)
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("FinancialYearlist")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $('#startdt').datetimepicker({
            theme: 'light',
            format: 'd M Y',
            timepicker: false,
            scrollInput: false
            /*minDate: 0*/
        })
        $('#enddt').datetimepicker({
            theme: 'light',
            format: 'd M Y',
            timepicker: false,
            scrollInput: false
            /*minDate: 0*/
        })
    </script>
}








