@model  List<SDKHRMS.Entities.ViewModels.DirectPaymentView>
<div id="DataGrid">
    @if (Model.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered" id="saleinvtable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Expense Head
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Remarks/Purpose
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Status
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Total Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Amount Released (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Due Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;width:60px;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" style="vertical-align:middle">
                                @item.PaymentDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.ExpenseTypeName
                            </td>
                            <td class="" style="vertical-align:middle">
                                <b>Purpose: </b>@item.Purpose<br />
                                <b>Remarks: </b>@item.Remarks
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @if (item.Status == "Settled")
                                {
                                    <span class="badge badge-soft-success text-dark rounded-pill">Settled</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge badge-soft-info text-dark rounded-pill">Pending</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning text-dark rounded-pill">@item.Status</span>
                                }
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.PaymentAmt.ToString("0.00")
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.PaidAmount.ToString("0.00")
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.Balance.ToString("0.00")
                            </td>
                            <td>
                                <div class="dropdown dropdown-action me-3">
                                    <a href="#"
                                       class="btn-action-icon bg-primary-light"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <ul>
                                            <li>
                                                <a href="/DirectPayment/Settlement?id=@item.DirectPaymentID" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="View PO Details" target="_blank">
                                                    <i class="fe fe-eye "></i> View
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="text-center"><b>Total</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.PaymentAmt).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.PaidAmount).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.Balance).ToString("0.00")</b></td>
                        <td class="text-center"><b>-</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched record in not available..</span>
        </div>
    }
</div>
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
