@model SDKHRMS.Entities.ViewModels.ProjectViewModel
<div id="DataGrid" class="">
    @if (Model.ProjectViewList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed" width="100%">
                <thead>
                    <tr>
                        <th style="text-align:left;">
                            Project Details
                        </th>
                        <th style="text-align:left;">
                            Work Order Details
                        </th>
                        <th style="text-align:left; width:10%;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ProjectViewList)
                    {
                        <tr>
                            <td>
                                <table class="table">
                                    <tbody>
                                        <tr>
                                            <td>
                                                Project Name:  <span class="text-primary">@item.ProjectName</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Client Name:  <span class="text-primary">@item.VendorName</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Start Date:  <span class="text-primary">@item.ProjStartDate.ToString("dd MMM yyyy") </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                End Date:
                                                @if (@item.ProjEndDate != null)
                                                {
                                                    <span class="text-primary">
                                                        @item.ProjEndDate.Value.ToString("dd MMM yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-primary">NA</span>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td>
                                <table class="table">
                                    <tbody>
                                        <tr>
                                            <td>
                                                Project Cost:  <span class="text-primary badge bg-light-gray">Rs.@item.ProjValue.ToString("0.00")</span>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                Project Status: @if (item.ProjStatus == "Open")
                                                {<span class="badge bg-success-light">@item.ProjStatus</span>}
                                            else
                                            {<span class="badge bg-secondary">@item.ProjStatus</span>}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Order No.:
                                                @if (!string.IsNullOrEmpty(@item.WONo))
                                                {
                                                    <span class="text-primary">@item.WONo</span>
                                                }
                                                else
                                                {
                                                    <span class="text-primary">NA</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Order Date:
                                                @if (@item.WODate != null)
                                                {
                                                    <span class="text-primary">@item.WODate.Value.ToString("dd MMM yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-primary">NA</span>
                                                }
                                            </td>

                                        </tr>

                                    </tbody>
                                </table>

                            </td>
                            <td>
                                <div class="row">
                                    <div class="col-md-2">
                                        <a class="btn-action-icon bg-light-gray mb-2"
                                           href="/projects/ProjectInDetails?id=@item.ProjectID"
                                           data-toggle="tooltip" data-placement="bottom" title="View In Details">
                                            <i class="fe fe-eye"></i>
                                        </a>
                                        <a class="btn-action-icon bg-light-gray mb-2"
                                           href="@Url.Action("editproject","Configuration",new { id = item.ProjectID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })"
                                           data-toggle="tooltip" data-placement="bottom" title="Edit">
                                            <i class="fe fe-edit-2"></i>
                                        </a>
                                        <form action="/Cofiguration/Delete" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("DeleteProject","Configuration", new { ID = item.ProjectID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.ProjectViewList.Count() })" class="delete btn-action-icon bg-danger-light mb-2" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.ProjectName">
                                                <i class="fe fe-trash-2"></i>
                                            </a>
                                        </form>
                                        <div class="dropdown dropdown-action me-3 mb-2">
                                            <a href="#"
                                               class="btn-action-icon bg-primary-light"
                                               data-bs-toggle="dropdown"
                                               aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <ul>
                                                    <li>
                                                        @if (!string.IsNullOrEmpty(@item.WOPath))
                                                        {
                                                            <a href="~/UploadFile/WorkOrder/@item.WOPath" class="dropdown-item" target="_blank"> <i class="fe fe-file me-2"></i>View Work Order</a>
                                                        }
                                                    </li>
                                                    <li>
                                                        @if (@item.PCCPath != null)
                                                        {
                                                            <a href="~/UploadFile/CompletionCertificate/@item.PCCPath" class="dropdown-item" target="_blank"> <i class="fe fe-file-text me-2"></i>View Certificate</a>
                                                        }
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/Projects/ProjectOverView">
                <span class="badge bg-warning text-dark">Showing @Model.ProjectViewList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("ProjectOverView", "Projects", new { PageNo = x, PageSize = Model.PagingInfo.ItemsPerPage }))
            </div>

        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
</div>
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>