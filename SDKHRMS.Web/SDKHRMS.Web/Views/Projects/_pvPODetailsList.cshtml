@model  List<SDKHRMS.Entities.ViewModels.POView>
<div id="DataGrid">
    @if (Model.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered" id="saleinvtable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Bill/Ref No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Vendor Name
                        </th>
                        @*<th class="text-center" style="vertical-align: middle;">
                            Status
                        </th>*@
                        <th class="text-center" style="vertical-align: middle;">
                            GST Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Net Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Total Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Amount Released (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Due Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;width:60px;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @item.BillNoRefNo
                            </td>
                            <td class="text-center">
                                @item.PurchaseDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.VendorName
                            </td>
                            <td class="text-center">
                                @item.GSTAmt.ToString("0.00")
                            </td>
                            <td class="text-center">
                                @item.NetAmt.ToString("0.00")
                            </td>
                            <td class="text-center">
                                @item.TotalAmt.ToString("0.00")
                            </td>
                            <td class="text-center">
                                @item.PaymentReleased.ToString("0.00")
                            </td>
                            <td class="text-center">
                                @item.DueAmt.ToString("0.00")
                            </td>
                            <td>
                                <div class="dropdown dropdown-action me-3">
                                    <a href="#"
                                       class="btn-action-icon bg-primary-light"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <ul>
                                            <li>
                                                <a href="/POPayment/PODetails?ID=@item.PurchaseInvoiceID" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="View PO Details" target="_blank">
                                                    <i class="fe fe-eye "></i> View
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3" class="text-center"><b>Total</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.GSTAmt).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.NetAmt).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.TotalAmt).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.PaymentReleased).ToString("0.00")</b></td>
                        <td class="text-center"><b>@Model.Sum(x => x.DueAmt).ToString("0.00")</b></td>
                        <td class="text-center"><b>-</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched record in not available..</span>
        </div>
    }
</div>
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
