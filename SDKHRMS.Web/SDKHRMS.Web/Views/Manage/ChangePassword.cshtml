@model SDKHRMS.Web.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        <div class="page-title-icon">
            <i class="glyphicon glyphicon-lock"></i>
        </div>
        <div>
            <div class="page-title-main-text linebreak">
                My Profile
            </div>
            <div class="page-title-sub-text">Change Password</div>
        </div>
    </div>
    <div class="page-title-actions"></div>
</div>

<div class="page-content clearfix">
    @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form", data_toggle = "validator", @novalidate = true }))
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="form-group has-feedback">
                @Html.LabelFor(m => m.OldPassword, new { @class = "col-md-3 control-label" })
                <div class="col-md-9">
                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", autocomplete = "false", id = "oldpass" })
                    <span class="glyphicon form-control-feedback" aria-hidden="true"></span>
                    @Html.ValidationMessageFor(m => m.OldPassword)
                </div>
            </div>
            <div class="form-group has-feedback">
                @Html.LabelFor(m => m.NewPassword, new { @class = "col-md-3 control-label" })
                <div class="col-md-9">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "false", id = "newpass" })
                    <span class="glyphicon form-control-feedback" aria-hidden="true"></span>
                    @Html.ValidationMessageFor(m => m.NewPassword)
                </div>
            </div>
            <div class="form-group has-feedback">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-3 control-label" })
                <div class="col-md-9">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "false", id = "confirmpass" })
                    <span class="glyphicon form-control-feedback" aria-hidden="true"></span>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                </div>
            </div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger row" })
        </div>
        <div class="well well-sm no-margin-bottom col-md-12 col-lg-12 text-right">
            <div class="form-horizontal">
                <input type="button" value="Change password" id="Changepass" class="btn btn-success" />
                <input type="submit" id="LogInBtn" class="btn hidden" hidden />
                @*<input type="submit" value="Change password" class="btn btn-success" />*@
            </div>
        </div>
    }
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
<script src="~/Scripts/aes.js"></script>
<script src="~/Scripts/core-min.js"></script>
<script src="~/Scripts/enc-utf16-min.js"></script>
<script type="text/javascript">
    $('#Changepass').click(function () {
        var txtOldpass = $('#oldpass').val();
        var txtNewpass = $('#newpass').val();
        var textConfpass = $('#confirmpass').val();
        if (textConfpass != "" && txtNewpass != "" && txtOldpass != "") {
            var key = CryptoJS.enc.Utf8.parse('8080808080808080');
            var iv = CryptoJS.enc.Utf8.parse('8080808080808080');
            var oldpass = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(txtOldpass), key,
            {
                keySize: 128 / 8,
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            });
            var newpass = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(txtNewpass), key,
            {
                keySize: 128 / 8,
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            });
            var Confpass = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(textConfpass), key,
            {
                keySize: 128 / 8,
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            });
            $('#oldpass').val(oldpass);
            $('#newpass').val(newpass);
            $('#confirmpass').val(Confpass);
            $('#LogInBtn').click();
        }
        else {
            $('#LogInBtn').click();
        }
    });
    $(window).keydown(function (event) {
        if (event.keyCode == 13) {
            event.preventDefault();
            $('#Changepass').click();
            return false;
        }
    });

    $(document).ready(function () {
        function disableBack() { window.history.forward() }

        window.onload = disableBack();
        window.onpageshow = function (evt) { if (evt.persisted) disableBack() }
    });
</script>
}

