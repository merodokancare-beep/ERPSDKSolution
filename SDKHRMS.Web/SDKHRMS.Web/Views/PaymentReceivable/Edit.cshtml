@model  SDKHRMS.Entities.ViewModels.PaymentReceivedAdd
@{
    ViewBag.Title = "Payment: Receivables";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    List<string> modes = new List<string>() { "Cash", "Cheque", "Netbanking", "Others" };
    string mode = Model.PaymentReceived != null ? Model.PaymentReceived.ReceivedMode : "";
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        @*<h5>Payment Manager</h5>*@
        <h5>Direct Payment Receive</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Edit Direct Payment Details</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("edit", "PaymentReceivable", FormMethod.Post, new { data_toggle = "validator", @novalidate = true, enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(m => m.PaymentReceived.ReceivedID);
                    @Html.HiddenFor(m => m.PaymentReceived.UploadedFile);
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Expense Head</label>
                                @Html.DropDownListFor(m => m.PaymentReceived.ExpenseTypeID, new SelectList(Model.ExpenseTypeDD, "ExpenseTypeID", "ExpenseType"), "-- Select Expense Head --", new { @class = "form-control ddSelect2", @id = "ddExpense" })
                                @Html.ValidationMessageFor(m => m.PaymentReceived.ExpenseTypeID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="required">Payment Receive Date</label>
                                @Html.TextBoxFor(m => m.PaymentReceived.ReceivedDate, new { @class = "form-control", @id = "txtdate", @Value = Model.PaymentReceived.ReceivedDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.PaymentReceived.ReceivedDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="required">Payment Receive Amount</label>
                                @Html.TextBoxFor(m => m.PaymentReceived.AmtReceived, new { @class = "form-control", @Value = Model.PaymentReceived.AmtReceived.ToString("0.00") })
                                @Html.ValidationMessageFor(m => m.PaymentReceived.AmtReceived)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="required">Payment Receive Mode</label>
                                @Html.DropDownListFor(m => m.PaymentReceived.ReceivedMode, new SelectList(modes), "-- Select Mode --", new { @class = "form-control ddSelect2", @id = "ddMode" })
                                @Html.ValidationMessageFor(model => model.PaymentReceived.ReceivedMode)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="required">Payment Receive Remarks</label>
                                @Html.TextAreaFor(m => m.PaymentReceived.Remarks, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.PaymentReceived.Remarks)
                            </div>
                        </div>
                        <div class="d-none row" id="bankdiv">
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="control-label required">Bank NAme <i class="fe fe-info" title="Payment deposit into"></i></label>
                                    @Html.DropDownListFor(model => model.PaymentReceived.BankID, new SelectList(Model.BankDD, "BankID", "BankName"), "-- Select Bank --", new { @class = "form-control ddSelect2", @id = "txtbank" })
                                    @Html.ValidationMessageFor(model => model.PaymentReceived.BankID)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="control-label required">Cheque/Transaction No.</label>
                                    @Html.TextBoxFor(model => model.PaymentReceived.TransactionNo, new { @class = "form-control", @id = "txttransno" })
                                    @Html.ValidationMessageFor(model => model.PaymentReceived.TransactionNo)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="control-label">Upload File (allowed formats: image/pdf)</label>
                                    @Html.TextBoxFor(m => m.UploadFile, new { @class = "btn btn-sm btn-primary", type = "file", @id = "txtfile" })
                                    @Html.ValidationMessageFor(m => m.UploadFile)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("index")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>

@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#txtdate').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            });

            loadPaySection('@mode');

            $('#ddMode').on('change', function () {
                loadPaySection($(this).val());
            });
            function loadPaySection(value) {
                if (value == 'Cash') {
                    $('#txtbank').val('');
                    $('#txttransno').val('');
                    $('#txtfile').val();
                    $('#bankdiv').addClass('d-none');
                } else if (value == '') {
                    $('#bankdiv').addClass('d-none');
                } else {
                    $('#bankdiv').removeClass('d-none');
                }
            }
            $('#chkPayment').on('click', function () {
                if ($(this).is(':checked')) {
                    $('#opening-div').removeClass('d-none');
                } else {
                    $('#opening-div').addClass('d-none');
                    $('#txtAmount').val('');
                    $('#txtdate').val('');
                }
            });
        });
    </script>
}



