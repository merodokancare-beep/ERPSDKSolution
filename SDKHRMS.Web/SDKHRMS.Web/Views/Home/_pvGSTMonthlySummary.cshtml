@model IEnumerable<SDKHRMS.Entities.ViewModels.GSTMonthlySummaryRow>

<div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
    <table class="table table-sm table-hover align-middle mb-0 dashboard-table w-100" style="font-size: 0.76rem;">
        <thead class="table-light sticky-top" style="z-index: 2;">
            <tr style="height: 38px;">
                <th class="ps-3">Month</th>
                <th class="text-end">Output Tax (&#8377;)</th>
                <th class="text-end">Input Tax (&#8377;)</th>
                <th class="text-end">Net GST Payable (&#8377;)</th>
                <th class="text-end pe-3">GST Paid (&#8377;)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr style="height: 36px;">
                        <td class="fw-semibold ps-3">@item.MonthName</td>
                        <td class="text-end">@item.OutputTax.ToString("N0")</td>
                        <td class="text-end">@item.InputTax.ToString("N0")</td>
                        <td class="text-end fw-semibold @(item.NetGSTPayable < 0 ? "text-info" : (item.NetGSTPayable > 0 ? "text-primary" : "text-muted"))">
                            @(item.NetGSTPayable < 0 ? "(" + Math.Abs(item.NetGSTPayable).ToString("N0") + ")" : item.NetGSTPayable.ToString("N0"))
                        </td>
                        <td class="text-end pe-3 fw-medium">@item.GSTPaid.ToString("N0")</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot class="table-light fw-bold sticky-bottom">
            <tr style="height: 38px;">
                <td class="text-primary ps-3">Total</td>
                <td class="text-end text-primary">@((Model != null && Model.Any()) ? Model.Sum(x => x.OutputTax).ToString("N0") : "0")</td>
                <td class="text-end text-primary">@((Model != null && Model.Any()) ? Model.Sum(x => x.InputTax).ToString("N0") : "0")</td>
                <td class="text-end text-primary">@((Model != null && Model.Any()) ? Model.Sum(x => x.NetGSTPayable).ToString("N0") : "0")</td>
                <td class="text-end text-primary pe-3">@((Model != null && Model.Any()) ? Model.Sum(x => x.GSTPaid).ToString("N0") : "0")</td>
            </tr>
        </tfoot>
    </table>
</div>
