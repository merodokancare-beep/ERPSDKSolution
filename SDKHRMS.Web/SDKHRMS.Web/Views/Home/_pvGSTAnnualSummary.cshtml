@model SDKHRMS.Entities.ViewModels.GSTAnnualSummaryModel

<div class="row align-items-start g-3">
    <!-- Donut Chart & Legend -->
    <div class="col-md-5 text-center">
        <div class="position-relative d-inline-block" style="margin-top: -6px;">
            <div id="gstAnnualDonutChart" data-cgst="@(Model?.CGSTAmount ?? 0)" data-sgst="@(Model?.SGSTAmount ?? 0)" data-igst="@(Model?.IGSTAmount ?? 0)" style="min-height: 200px;"></div>
            <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none; margin-top: -6px;">
                <div class="text-uppercase donut-center-title fw-semibold text-muted" style="font-size: 0.65rem; letter-spacing: 0.05em;">Total GST</div>
                <div class="fw-extrabold donut-center-value" style="font-size: 1.05rem; color: var(--erp-text-main, #f8fafc);">
                    &#8377; @(Model?.TotalGSTAmount.ToString("N0") ?? "0")
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 flex-wrap mt-2" style="font-size: 0.72rem; font-weight: 600;">
            <span class="d-flex align-items-center gap-1 text-muted"><i class="fa-solid fa-circle text-primary" style="font-size: 8px;"></i> CGST (&#8377;)</span>
            <span class="d-flex align-items-center gap-1 text-muted"><i class="fa-solid fa-circle text-success" style="font-size: 8px;"></i> SGST (&#8377;)</span>
            <span class="d-flex align-items-center gap-1 text-muted"><i class="fa-solid fa-circle text-warning" style="font-size: 8px;"></i> IGST (&#8377;)</span>
        </div>
    </div>

    <!-- Annual Table -->
    <div class="col-md-7">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 dashboard-table" style="font-size: 0.76rem;">
                <thead class="table-light">
                    <tr style="height: 38px;">
                        <th class="ps-2">GST Type</th>
                        <th class="text-end">Taxable Value (&#8377;)</th>
                        <th class="text-end">Tax Amount (&#8377;)</th>
                        <th class="text-end pe-2">Total (&#8377;)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="height: 36px;">
                        <td class="fw-semibold text-primary ps-2">CGST</td>
                        <td class="text-end">@(Model?.CGSTTaxable.ToString("N0") ?? "0")</td>
                        <td class="text-end">@(Model?.CGSTAmount.ToString("N0") ?? "0")</td>
                        <td class="text-end fw-semibold pe-2">@(Model?.CGSTTotal.ToString("N0") ?? "0")</td>
                    </tr>
                    <tr style="height: 36px;">
                        <td class="fw-semibold text-success ps-2">SGST</td>
                        <td class="text-end">@(Model?.SGSTTaxable.ToString("N0") ?? "0")</td>
                        <td class="text-end">@(Model?.SGSTAmount.ToString("N0") ?? "0")</td>
                        <td class="text-end fw-semibold pe-2">@(Model?.SGSTTotal.ToString("N0") ?? "0")</td>
                    </tr>
                    <tr style="height: 36px;">
                        <td class="fw-semibold text-warning ps-2">IGST</td>
                        <td class="text-end">@(Model?.IGSTTaxable.ToString("N0") ?? "0")</td>
                        <td class="text-end">@(Model?.IGSTAmount.ToString("N0") ?? "0")</td>
                        <td class="text-end fw-semibold pe-2">@(Model?.IGSTTotal.ToString("N0") ?? "0")</td>
                    </tr>
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr style="height: 38px;">
                        <td class="text-primary ps-2">Total</td>
                        <td class="text-end text-primary">@(Model?.TotalTaxable.ToString("N0") ?? "0")</td>
                        <td class="text-end text-primary">@(Model?.TotalTax.ToString("N0") ?? "0")</td>
                        <td class="text-end text-primary pe-2">@(Model?.GrandTotal.ToString("N0") ?? "0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
