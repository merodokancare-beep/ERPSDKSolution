@model SDKHRMS.Entities.ViewModels.DashboardViewModel
<div id="DataGrid" class="col-md-12">
    @if (Model.PurchaseSaleList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered">
                <tbody>
                    @foreach (var group in Model.PurchaseSaleList.GroupBy(x => x.PurchaseSaleType))
                    {
                        <tr class="">
                            <th colspan="8" class="" style="background: white; text-align: left; vertical-align: middle;">
                                <span class="text-info" style="font-size:18px;">@group.Select(x => x.PurchaseSaleType).FirstOrDefault() Details of SDK Solutions For @ViewBag.MonName, @DateTime.Now.Year</span>
                            </th>
                        </tr>
                        <tr>
                            <th class="text-center" style="vertical-align: middle;">Date</th>
                            <th class="text-center" style="vertical-align: middle;">Bill No.</th>
                            <th class="text-center" style="vertical-align: middle;">Vender/Client Name</th>
                            <th class="text-center" style="vertical-align: middle;">IsIGST</th>
                            <th class="text-center" style="vertical-align: middle;">IGST(&#8377;) </th>
                            <th class="text-center" style="vertical-align: middle;">CGST(&#8377;) </th>
                            <th class="text-center" style="vertical-align: middle;">SGST(&#8377;)</th>
                            <th class="text-center" style="vertical-align: middle;">Amount(&#8377;)</th>
                        </tr>
                        foreach (var item in group)
                        {
                            <tr>
                                <td class="text-center">@item.PurchaseSaleDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.PurchaseSaleInvoiceNo </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(@item.VenderName))
                                    {
                                        @item.VenderName
                                    }
                                    else
                                    {
                                        @item.ClientName
                                    }
                                </td>
                               
                                <td class="text-center">@item.IsIGST</td>
                                <td class="text-center">@item.IGST</td>
                                <td class="text-center">@item.CGST</td>
                                <td class="text-center">@item.SGST</td>
                                <td class="text-center">@item.TaxableAmount</td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    }
    else
    {
        <h3>No Purchase &amp; Sale Details of SDK Solutions For @DateTime.Now.Month, @DateTime.Now.Year</h3>
    }
</div>
