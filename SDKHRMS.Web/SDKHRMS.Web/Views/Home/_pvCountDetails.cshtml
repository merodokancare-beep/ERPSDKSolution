@model SDKHRMS.Entities.ViewModels.FiscalWiseCount

<div class="row g-3">
    <!-- Card 1: Total Invoices Generated -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100" style="background: var(--erp-bg-card, #ffffff); border: 1px solid var(--erp-border, rgba(0,0,0,0.08));">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%); font-size: 1.2rem; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size: 0.68rem; font-weight: 600;">
                        @(ViewBag.FYLabel ?? "Custom Range")
                    </span>
                </div>
                <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Invoices Generated</div>
                <div class="fw-extrabold stat-value-text my-1" style="font-size: 1.4rem;">
                    &#8377; @(ViewBag.TotalSales ?? "0")
                </div>
                <div class="pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 0.75rem;">
                    <a href="/invoice/saleinvoicelist" class="text-primary fw-bold text-decoration-none">
                        View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Total Purchase Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100" style="background: var(--erp-bg-card, #ffffff); border: 1px solid var(--erp-border, rgba(0,0,0,0.08));">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #10b981 0%, #34d399 100%); font-size: 1.2rem; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size: 0.68rem; font-weight: 600;">
                        @(ViewBag.FYLabel ?? "Custom Range")
                    </span>
                </div>
                <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Purchase Orders</div>
                <div class="fw-extrabold stat-value-text my-1" style="font-size: 1.4rem;">
                    &#8377; @(ViewBag.TotalPO ?? "0")
                </div>
                <div class="pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 0.75rem;">
                    <a href="/invoice/purchaseinvoicelist" class="text-success fw-bold text-decoration-none">
                        View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Total Payable to Vendors -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100" style="background: var(--erp-bg-card, #ffffff); border: 1px solid var(--erp-border, rgba(0,0,0,0.08));">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); font-size: 1.2rem; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size: 0.68rem; font-weight: 600;">
                        Unpaid / Outstanding
                    </span>
                </div>
                <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Payable to Vendors</div>
                <div class="fw-extrabold stat-value-text my-1" style="font-size: 1.4rem;">
                    &#8377; @(ViewBag.TotalPayable ?? "0")
                </div>
                <div class="pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 0.75rem;">
                    <a href="/popayment/index" class="text-warning fw-bold text-decoration-none">
                        View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Total Receivable from Clients -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100" style="background: var(--erp-bg-card, #ffffff); border: 1px solid var(--erp-border, rgba(0,0,0,0.08));">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #8b5cf6 0%, #c084fc 100%); font-size: 1.2rem; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);">
                        <i class="fa-solid fa-users-viewfinder"></i>
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size: 0.68rem; font-weight: 600;">
                        Unpaid / Outstanding
                    </span>
                </div>
                <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Receivable from Clients</div>
                <div class="fw-extrabold stat-value-text my-1" style="font-size: 1.4rem;">
                    &#8377; @(ViewBag.TotalReceivable ?? "0")
                </div>

                <div class="pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 0.75rem;">
                    <a href="/paymentreceivable/index" class="text-purple fw-bold text-decoration-none" style="color: #8b5cf6;">
                        View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    if ('@ViewBag.TotalSalesFormatted') {
        $('#quickTotalSales').text('\u20B9 ' + '@ViewBag.TotalSalesFormatted');
    }
    if ('@ViewBag.NetMargin' !== '') {
        $('#quickNetMargin').text('@ViewBag.NetMargin%');
    }
    if ('@ViewBag.FYLabel') {
        $('#selectedFY').text('@ViewBag.FYLabel');
        $('.gst-annual-fy-title').text('(' + '@ViewBag.FYLabel' + ')');
    }
</script>