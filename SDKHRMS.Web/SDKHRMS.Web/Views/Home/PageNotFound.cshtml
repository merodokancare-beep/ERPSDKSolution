@model dynamic
@{
    Layout = null;
    Context.Response.StatusCode = 404;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 Page Not Found - SDK ERP</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/Content/Images/smalllogo.png" />
    <link rel="stylesheet" href="~/Content/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/assets/plugins/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/assets/css/style.css" />
    <link rel="stylesheet" href="~/Content/custom-erp.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100 justify-content-center align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                        <img src="~/Content/Images/LOGOSDK1.png" style="max-height: 45px;" alt="SDK Solutions Logo" />
                        <a href="@Url.Action("Login","Account")" class="btn btn-primary btn-sm px-4 rounded-pill">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Go To Login
                        </a>
                    </div>
                    <div class="card-body p-5 text-center">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-circle p-4 mb-3" style="width: 80px; height: 80px;">
                            <i class="fa-solid fa-magnifying-glass fa-3x"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Page Not Found (404)</h2>
                        <p class="text-muted fs-6 mb-4">The requested page or URL could not be found on this server.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="@Url.Action("NewDashboard", "Home")" class="btn btn-primary rounded-pill px-4">
                                <i class="fa-solid fa-house me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Content/assets/js/bootstrap.bundle.min.js"></script>
</body>
</html>


