@model SDKHRMS.Entities.ViewModels.NewDashboardVM

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@*<style type="text/css">
</style>*@
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/apexchart/apexcharts.css" rel="stylesheet" />
<div class="page-header">
    <div class="d-flex align-items-start align-items-sm-center justify-content-between flex-column flex-sm-row gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-1 dashboard-title" style="color: #F8FAFC; font-size: 1.3rem;">
                <i class="fa-solid fa-chart-pie me-2" style="color: #7539FF;"></i>ERP Dashboard
            </h4>
            <p class="mb-0 dashboard-subtitle" style="color: #94A3B8; font-size: 0.82rem;">Welcome back, @User.Identity.Name &mdash; here's your business overview</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap dashboard-filters">
            <input class="form-control form-control-sm dashboarddate" type="text" placeholder="Start Date" id="startdate"
                   value="@(Model.StartDate != null ? Model.StartDate.Value.ToString("dd MMM yyyy") : "")"
                   style="background: #1A2030; border: 1px solid rgba(255,255,255,0.12); color: #F8FAFC; border-radius: 8px; width: 130px;" />
            <input class="form-control form-control-sm dashboarddate" type="text" placeholder="End Date" id="enddate"
                   value="@(Model.EndDate != null ? Model.EndDate.Value.ToString("dd MMM yyyy") : "")"
                   style="background: #1A2030; border: 1px solid rgba(255,255,255,0.12); color: #F8FAFC; border-radius: 8px; width: 130px;" />
            <a class="btn btn-sm fw-semibold" href="javascript:void(0)" id="btnsubmit"
               style="background: linear-gradient(135deg, #7539FF 0%, #A855F7 100%); color: #fff; border: none; border-radius: 8px; padding: 6px 16px; box-shadow: 0 4px 12px rgba(117,57,255,0.35);">
                <i class="fa-solid fa-check me-1"></i>Submit
            </a>
            <a class="btn btn-sm fw-semibold" href="/home/newdashboard"
               style="background: rgba(255,255,255,0.06); color: #94A3B8; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 6px 12px;">
                <i class="fa-solid fa-rotate me-1"></i>Clear
            </a>
        </div>
    </div>
    <i><span id="DateErrMsg" class="text-danger" style="font-size: 0.8rem;"></span></i>
</div>

<div class="row" id="countdtls">
    @*Count Details*@
</div>
<div class="clearfix">&nbsp;</div>
<div class="row no-padding">
    <div class="col-md-8 d-flex">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title"> Direct Payment Details for <span id="DirectText"></span></h5>
                </div>
            </div>
            <div class="card-body">
                <div id="directpaymentgraph">
                    @*Direct Payment*@
                </div>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <div class="justify-content-between align-items-center">
                    <h5 class="card-title">GST Payable for <span id="PayableText"></span></h5>
                </div>
            </div>
            <div class="card-body">
                <div id="gstpayablegraph">
                    @*GST Payable*@
                </div>
            </div>
        </div>
    </div>
</div>
<div class="clearfix">&nbsp;</div>
<div class="row no-padding">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <div class="justify-content-between align-items-center">
                    <h5 class="card-title"> Project Wise Details <span id="ProjwiseText"></span></h5>
                </div>
            </div>
            <div class="card-body">
                <div id="projectwisegraph">
                    @*project wise Payment*@
                </div>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card ">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title">GST Input for <span id="InputText"></span></h5>
                </div>
            </div>
            <div class="card-body">
                <div id="gstinputgraph">
                    @*GST Input*@

                </div>
            </div>
        </div>
    </div>

</div>
<div class="clearfix">&nbsp;</div>
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
