                        $('#projectwise').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    }
                }
                else {
                    $('#DateErrMsg').text('Please select both a Start & End Date, then click the Submit button..');
                    $('#countdtls').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    $('#directpayment').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    $('#gstinput').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    $('#gstpayable').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    $('#directpayment').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                    $('#projectwise').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
                }
            }
            daterange();
            $(document).on('click', "#btnsubmit", daterange);
