            var loadcountdetails = function (sdate, edate) {
                if (typeof sdate !== 'string') {
                    sdate = $('#startdate').val();
                    edate = $('#enddate').val();
                }
                if (sdate != "" && edate != "") {
                    $('#countdtls').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif" /><h2>Please wait....</h2></div>');
                    $.ajax({
                        type: 'GET',
                        url: '/Home/GetCountDetails',
                        data: { SDate: sdate, EDate: edate },
                        success: function (data) {
                            $('#countdtls').empty().append(data);
                        },
                        error: function () {
                            $('#countdtls').empty().append('<div class="panel-body"><img src="/Content/Images/img-warning.png" height="50" width="50"/><b>Could not load data. Please click here to reload...</b><button id="btncountdetails"> <i class="fa fa-refresh"></i> Reload</button></div>');
                        }
                    });
                }
            }
            $(document).on('click', "#btncountdetails", function () { daterange(); });

            var daterange = function () {
                if ($('#startdate').val() != "" && $('#enddate').val() != "") {
                    var d1 = Date.parse($('#startdate').val());
                    var d2 = Date.parse($('#enddate').val());
                    if (isNaN(d1) || isNaN(d2) || d1 <= d2) {
                        var FromDate = $('#startdate').val();
                        var ToDate = $('#enddate').val();
                        $('#PayableText').text(FromDate + " - " + ToDate);
                        $('#InputText').text(FromDate + " - " + ToDate);
                        $('#DirectText').text(FromDate + " - " + ToDate);
                        $('#ProjwiseText').text(FromDate + " - " + ToDate);
                        loadcountdetails(FromDate, ToDate)
                        GstPayableChart(FromDate, ToDate);
                        GstInputChart(FromDate, ToDate);
                        DirectPaymentChart(FromDate, ToDate);
                        ProjwiseDetails(FromDate,ToDate);
                    }
                    else {
                        $('#DateErrMsg').text('End date must be greater then start date. Please check and tyr again..');
                        $('#countdtls').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif"/><h2>Please wait....</h2></div>');
