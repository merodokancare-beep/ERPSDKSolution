@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

<div id="DataGrid" class="">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered align-middle">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 80px;">Sl. No</th>
                        <th>Role Name</th>
                        <th>Access &amp; Permissions</th>
                        <th class="text-center" style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int slNo = 0;
                    }
                    @foreach (var item in Model)
                    {
                        slNo++;
                        var roleName = item.Name ?? "";
                        var isSystemRole = roleName.Equals("Super Admin", StringComparison.OrdinalIgnoreCase) || 
                                           roleName.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
                                           roleName.Equals("Accountant", StringComparison.OrdinalIgnoreCase) ||
                                           roleName.Equals("Employee", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td class="text-center fw-semibold">@slNo</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (roleName.Equals("Super Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="icon-badge icon-badge-danger me-2"><i class="fa-solid fa-crown"></i></span>
                                        <div>
                                            <span class="fw-bold text-danger">@roleName</span>
                                            <span class="badge bg-danger-light text-danger ms-2">Full System Access</span>
                                        </div>
                                    }
                                    else if (roleName.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="icon-badge icon-badge-indigo me-2"><i class="fa-solid fa-user-shield"></i></span>
                                        <div>
                                            <span class="fw-bold text-info">@roleName</span>
                                            <span class="badge bg-info-light text-info ms-2">Administrator</span>
                                        </div>
                                    }
                                    else if (roleName.Equals("Accountant", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="icon-badge icon-badge-success me-2"><i class="fa-solid fa-calculator"></i></span>
                                        <div>
                                            <span class="fw-bold text-success">@roleName</span>
                                            <span class="badge bg-success-light text-success ms-2">Finance &amp; Accounts</span>
                                        </div>
                                    }
                                    else if (roleName.Equals("Employee", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="icon-badge icon-badge-primary me-2"><i class="fa-solid fa-user"></i></span>
                                        <div>
                                            <span class="fw-bold text-primary">@roleName</span>
                                            <span class="badge bg-primary-light text-primary ms-2">Staff Portal</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="icon-badge icon-badge-purple me-2"><i class="fa-solid fa-shield-halved"></i></span>
                                        <div>
                                            <span class="fw-bold">@roleName</span>
                                            <span class="badge bg-purple-light text-purple ms-2">Custom Role</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (roleName.Equals("Super Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="text-muted">Unrestricted access to all modules, financial transactions, user controls, and system configurations.</small>
                                }
                                else if (roleName.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="text-muted">Access to employee management, configurations, project management, and operational views.</small>
                                }
                                else if (roleName.Equals("Accountant", StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="text-muted">Access to Payments, Invoices, Petty Cash, Ledgers, and financial records.</small>
                                }
                                else if (roleName.Equals("Employee", StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="text-muted">Standard staff access to personal dashboard and attendance features.</small>
                                }
                                else
                                {
                                    <small class="text-muted">Custom role with user-defined application privileges.</small>
                                }
                            </td>
                            <td class="text-center">
                                @if (isSystemRole)
                                {
                                    <span class="badge bg-light text-muted" title="System roles cannot be removed" data-bs-toggle="tooltip">
                                        <i class="fa-solid fa-lock me-1"></i>System
                                    </span>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("DeleteRole", "RoleCreator")" data-otf-ajax="true" data-otf-target="#DataGrid" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <a href="@Url.Action("DeleteRole", "RoleCreator", new { id = item.Id })" class="delete btn-action-icon bg-danger-light" data-bs-toggle="tooltip" data-placement="bottom" title="Delete Role">
                                            <i class="fe fe-trash-2"></i>
                                        </a>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <i class="fa-solid fa-shield-halved fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No roles defined yet</h5>
        </div>
    }
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>