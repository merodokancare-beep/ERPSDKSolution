@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewBag.Title = "Configuration : Users & Roles";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="page-header">
    <div class="content-page-header">
        <h5><i class="fa-solid fa-user-shield text-primary me-2"></i>Users &amp; Roles Management</h5>
        <div class="list-btn">
            <ul class="filter-list">
                <li>
                    <a class="btn btn-primary" href="@Url.Action("AddRole", "RoleCreator")">
                        <i class="fa-solid fa-plus-circle me-2"></i>Add New Role
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">System Defined Roles</h5>
                <span class="badge bg-primary-light text-primary fs-12">@Model.Count() Roles Configured</span>
            </div>
            <div class="card-body">
                @Html.Partial("_pvRoleList", Model)
            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>