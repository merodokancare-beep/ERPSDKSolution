            var RefNo = function () {
                //var DateVal = new Date();
                //var fullDate = new Date()
                //var twoDigitMonth = ((fullDate.getMonth().length + 1) === 1) ? (fullDate.getMonth() + 1) : '0' + (fullDate.getMonth() + 1);
                //var currentDate = fullDate.getDate() + "/" + twoDigitMonth + "/" + fullDate.getFullYear();
                //if ($('#invdt').val() != "") {
                //    DateVal = $('#invdt').val();
                //}
                //else {
                //    DateVal = currentDate;
                //}
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("GetRefNumber", "Invoice")', // we are calling json method
                    dataType: 'json',
                    data: { Datevalue: $('#invdt').val() },
                    // here we are get value of selected property and passing same value as inputto json method getJsonSectionList.
                    success: function (data) {
                        var msg = data.OperationMsg;
                        if (msg.includes("Error:")) {
                            $('#RefSection').addClass('d-none');
                            $('#ErrorMsg').removeClass('d-none');
                            $('#msg').text(msg);
                        }
                        else {
                            $('#RefSection').removeClass('d-none');
                            $('#ErrorMsg').addClass('d-none');
                            $('#RefNo').text(data.InvoiceNO);
                            $('#Fiscal').text(data.FiscalYear);
                            $('#RefNoVal').val(data.InvoiceNO);
                        }
                    },
                });
            }
            $(document).on('change', '#invdt', RefNo);
            RefNo();
            //Project Details
            var ddProject = function () {
                if ($('#proj').val() != "" || $('#proj').val() != 0) {
                    var SelectType = $("#proj").find('option:selected').val();
                    $.ajax({
                        type: 'GET',
                        url: "/Invoice/GetProjectClientDetails",
                        data: { id: SelectType },
                        success: function (data) {
                            $('#DataGrid').html(data);
                            $('#DataGrid').removeClass("d-none");
                            OrderDTNo();
                            //changeProject($(".member-data-row").length);
                        }
                    })
                }
                else {
                    $('#DataGrid').addClass("d-none");
                    $('#orderdt').val('');
                    $('#orderno').val('');
                    $('#ClientID').val('');
                }
            };
            $(document).on('change', '#proj', ddProject);
            ddProject();

            var OrderDTNo = function () {
                if (($('#proj').val() != "" || $('#proj').val() != 0)) {
                    var ProjectID = $("#proj").find('option:selected').val();
                    //alert(ProjectID);
                    $.ajax({
                        type: 'GET',
                        url: "/Invoice/WorkingOrderDTNo",
                        dataType: 'json',
                        data: { ProjID: ProjectID },
                        // here we are get value of selected property and passing same value as inputto json method getJsonSectionList.
                        success: function (data) {
                                 //$('#WorkingOrderSec').removeClass('hidden');
                                $('#orderdt').val(data.WODate);
                                $('#orderno').val(data.WONo);
                                $('#ClientID').val(data.VendorID);
                                //$('#ClientID').text(data.ClientID);
                            },
                        });
                }
            }

