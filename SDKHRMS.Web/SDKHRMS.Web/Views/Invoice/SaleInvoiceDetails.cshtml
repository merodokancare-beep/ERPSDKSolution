@model SDKHRMS.Entities.ViewModels.SaleInvoiceKeyView
@{
    ViewBag.Title = " Procurement Details";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var InvID = Model.SaleInvoiceID;
    decimal GSTAmt = Model.IncludingTaxAmt - Model.ExcludingTaxAmt;
}

<link href="~/Content/Plugins/Select2/select2.min.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Sale Invoice Details</h5>
    </div>
</div>

<div class="row">
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Date</div>
                        <div class="dash-counts">
                            <p>@Model.InvoiceDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-primary-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Total GST</div>
                        <div class="dash-counts">
                            <p>@GSTAmt.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-success-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Total Invoice Amount <i class="fe fe-info" title="Including GST/Tax"></i></div>
                        <div class="dash-counts">
                            <p>@Model.IncludingTaxAmt.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-info-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">@(!string.IsNullOrEmpty(Model.ReceivedRemarks)? Model.ReceivedRemarks:"Advance/Payment Received")</div>
                        <div class="dash-counts">
                            <p>@Model.AdvanceReceived.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-danger-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Net Receivable Amount</div>
                        <div class="dash-counts">
                            <p>@Model.BalanceAmount.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Invoive To</div>
                        <div class="dash-counts">
                            <p>@Model.InvoiceTo</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Project</div>
                        <div class="dash-counts">
                            <p>@(Model.ProjectName ?? "Not Linked")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Order Reference NO.</div>
                        <div class="dash-counts">
                            <p>@(Model.OrderNo??"N/A")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Order Date</div>
                        <div class="dash-counts">
                            <p>@(Model.OrderDate??"N/A")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Status</div>
                        <div class="dash-counts">
                            @if (!@Model.IsCancelled)
                            {
                                <p> Status: <span class="badge badge-soft-success">Active</span></p>
                            }
                            else
                            {
                                <p>Status: <span class="badge badge-soft-danger">Cancelled</span></p>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Invoice Reference No.</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceNo</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Client Name</div>
                        <div class="dash-counts">
                            <p>@Model.VenderName</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-12 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Remarks</div>
                        <div class="dash-counts">
                            <p>@Model.Remarks</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
<div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Sale Invoice Items Details</h5>
                </div>
                <div class="card-body card-buttons" id="items">

                </div>

            </div>
        </div>
    </div>
@*<div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Procurement's Payment Release</h5>
                </div>
                <div class="card-body card-buttons" id="paymenttrans">

                </div>


            </div>
        </div>
    </div>*@


@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            @*var loadpayment = function () {
                $('#paymenttrans').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif" /><h2>Please wait....</h2></div>');
            $.ajax({
                type: 'GET',
                url: '/POPayment/GetPaymentTransByProjID',
                data: { ID: '@POID' },
