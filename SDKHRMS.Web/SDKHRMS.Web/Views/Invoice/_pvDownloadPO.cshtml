@model SDKHRMS.Entities.ViewModels.POExportVM
@{
    Layout = null;
    decimal IGST = Model.POItemsList != null ? Model.POItemsList.Sum(x => x.IGSTAmt) : 0;
    decimal CGST = Model.POItemsList != null ? Model.POItemsList.Sum(x => x.CGSTAmt) : 0;
    decimal SGST = Model.POItemsList != null ? Model.POItemsList.Sum(x => x.SGSTAmt) : 0;
    decimal TTax = CGST + SGST + IGST;
    decimal totalAmt = Model.POItemsList != null ? Model.POItemsList.Sum(x => x.TotalAmt) : 0;
    decimal baseAmt = Model.PODetails != null ? Model.PODetails.IncludingTaxAmt : totalAmt;
    decimal roundOfAmount = Math.Round(baseAmt);
    decimal roundOfValue = roundOfAmount - baseAmt;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>SDK Solutions ||PURCHASE ORDER </title>
    @Styles.Render("~/Content/css")
    <style>
        .fontsize18 {
            font-size: 18px !important;
        }

        .fontsize16 {
            font-size: 16px !important;
            color: #000;
        }

        .custom-table, .custom-table-all {
            border-collapse: collapse;
            border-spacing: 0;
            width: 100%;
            display: table;
        }

        .custom-table-all {
            border: 1px solid #ccc;
        }

        .mt-30 {
            margin-top: 30px;
        }

        pre {
            /*display: block !important;*/
            padding: 2px;
            /*font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;*/
            margin: 0;
            font-size: 13px !important;
            line-height: 1.5 !important;
            /*color: #333333 !important;*/
            word-break: break-all !important;
            word-wrap: break-word !important;
            border: none;
        }

        .header-color {
            color: #0092cb;
        }

        .inv-header-right {
            text-align: right;
        }

        .inv-details {
            position: relative;
        }

        .inv-date:last-child {
            margin-right: 0;
            /*margin-bottom: 20px;*/
        }

        .inv-date {
            width: 100%;
            float: right;
            color: #000;
            font-size: 18px;
            font-weight: normal;
        }

        img {
            max-width: 200px;
            height: auto;
        }
    </style>
</head>
<body style="background:#fff;">
    <div class="col-md-12">
        @*<div class="col-md-12 text-center">
                <h2 class="font-bold"><u>TAX INVOICE</u></h2>
            </div>*@
        <div class="col-md-12 margin-top10">
            <div class="row">
                <div class="col-md-6 pull-left" style="margin-top:-10px;">
                    <img src="~/Content/Images/LOGOSDK.png" class="" /><br />
                    <strong class="fontsize18 header-color"> M/S SDK Solutions</strong><br />
                    <span class="fontsize16">3057/3/11/N, Jyoti Nagar, P.O Sevok Road, Siliguri, WB - 734001 </span><br />
                    <span class="fontsize16">Email: info@sdksolutions.in || Mobile No.: +91 97331 16514 || GSTIN: 19AMVPA4565H1ZM</span><br />
                </div>
                <div class="col-md-6 pull-right">
                    <strong class="fontsize18"><span class="header-color">PURCHASE ORDER</span></strong><br />
                    <span class="fontsize16">PO No.: @Model.PODetails.PORefNo </span><br />
                    <span class="fontsize16">Date: @Model.PODetails.PurchaseDate.ToString("dd MMM yyyy")</span><br />
                </div>
            </div>
        </div>
        <hr />
        <div class="col-md-12 margin-top10">
            <table class="" width="100%" style="width:100%;page-break-inside: avoid">
                <tr style="page-break-inside: avoid">
                    <td class="text-left" style="width:60%;">
                        <strong class="fontsize18 header-color">Supplier: </strong>
                    </td>
                    <td class="text-left" style="width:5%">
                        &nbsp;
                    </td>
                    <td class="text-left" style="width:35%;">
                        <strong class="fontsize18 header-color">Ship To: </strong>
                    </td>
                </tr>
                <tr style="color: #000;">
                    <td class="text-left" style="width:60%;">
                        <span class="fontsize16">@Model.VendorDetails.VenderName</span><br />
                        <span class="fontsize16">@Model.VendorDetails.VenderAddress</span><br />
                        @if (!string.IsNullOrEmpty(@Model.VendorDetails.GSTNo) && @Model.VendorDetails.GSTNo.Length > 5)
                        {
                            <span class="fontsize16">GSTIN: @Model.VendorDetails.GSTNo</span><br />
                        }
                    </td>
                    <td class="text-left" style="width:5%">
                        &nbsp;
                    </td>
                    <td class="text-left" style="width:35%;">
                        <pre class="fontsize16">@Model.PODetails.ShipTo</pre>
                    </td>
                </tr>
            </table>
        </div>
        <hr />
    </div>

    @if (Model.POItemsList.Count() > 0)
    {
        <div class="col-md-12" style="margin-top:20px;">
            <table class="table table-bordered" width="100%">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align:middle">
                            Sl No.
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Item Name
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            HSN Code
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            GST %
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Qty
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Rate (&#8377)
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Amount (&#8377)
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            IGST (&#8377)
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            CGST (&#8377)
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            SGST (&#8377)
                        </th>
                        <th class="text-center" style="vertical-align:middle">
                            Total (&#8377)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model.POItemsList)
                    {
                        <tr style="page-break-inside: avoid; color: #000;">
                            <td class="text-center" style="vertical-align:middle">
                                @i
                            </td>
                            <td class="text-left" style="vertical-align:middle">
                                @item.ItemName
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.ItemHSNCode
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.GSTPercentage
                            </td>
                            <td class="text-center" style="vertical-align:middle">
                                @item.Qty
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.Rate.ToString("0.00")
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.Amount.ToString("0.00")
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.IGSTAmt.ToString("0.00")
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.CGSTAmt.ToString("0.00")
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.SGSTAmt.ToString("0.00")
                            </td>
                            <td class="text-right" style="vertical-align:middle">
                                @item.TotalAmt.ToString("0.00")
                            </td>
                        </tr>
                        i++;
                    }

                    <tr style="background:#ccc;color:#000; page-break-inside: avoid">
                        <td colspan="6" class="text-right">Total</td>
                        <td class="text-right">@Model.POItemsList.Sum(x => x.Amount).ToString("0.00")</td>
                        <td class="text-right">@Model.POItemsList.Sum(x => x.IGSTAmt).ToString("0.00")</td>
                        <td class="text-right">@Model.POItemsList.Sum(x => x.CGSTAmt).ToString("0.00")</td>
                        <td class="text-right">@Model.POItemsList.Sum(x => x.SGSTAmt).ToString("0.00")</td>
                        <td class="text-right">@Model.POItemsList.Sum(x => x.TotalAmt).ToString("0.00")</td>
                    </tr>
                </tbody>
            </table>
            <hr />
            <div class="col-md-12 inv-header-right">
                <div class="inv-details">
                    <div class="inv-date">Total Net Amount: &#8377 @Model.POItemsList.Sum(x => x.Amount).ToString("0.00")</div>
                    @*<strong class="text-info pull-right">Total Tax Amount: &#8377 @Model.POItemsList.Sum(x => x.IGSTAmt).ToString("0.00")</strong>*@
                    <div class="inv-date">Total Tax Amount: &#8377 @TTax.ToString("0.00")</div>
                    @if (roundOfValue != 0)
                    {
                        <div class="inv-date">Total Amount: &#8377 @Model.POItemsList.Sum(x => x.TotalAmt).ToString("0.00")</div>
                        <div class="inv-date">Round Of Value: &#8377  @roundOfValue.ToString("0.00")</div>
                        <div class="inv-date">Total Value of PO: &#8377 @roundOfAmount.ToString("0.00")</div>
                    }
                    else
                    {
                        <div class="inv-date">Total Value of PO: &#8377 @Model.POItemsList.Sum(x => x.TotalAmt).ToString("0.00")</div>
                    }
                </div>
            </div>
            <br />
            <strong style="color:#000">(Rupees @Model.FigureAmount Only)</strong>
        </div>
        <hr />
    }
    else
    {
        <div class="col-md-12" style="margin-top:30px; margin-bottom:20px;">
            <h3>No record found...</h3>
        </div>
    }
    <div class="clearfix"></div>
    @if (!string.IsNullOrEmpty(Model.PODetails.TermsConditions))
    {
        <div class="col-md-12">
            <h5 class="font-bold">Terms &amp; Conditions</h5>
            <pre>@Model.PODetails.TermsConditions</pre>
        </div>
    }
    <div class="clearfix"></div>
    <div class="col-md-12 margin-top20 pull-right">
        <img src="~/Content/Images/sdksign.png" height="100" style="margin-top:5px; margin-bottom:5px" /><br />
        <span class="">Authorised Signatory</span><br />
        <span class="">SDK Solutions</span><br />
    </div>

</body>
</html>
