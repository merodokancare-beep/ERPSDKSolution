@model SDKHRMS.Entities.ViewModels.SaleInvoiceVM
<div id="DataGrid">
    @if (Model.SaleInvoiceKeyViewList != null && Model.SaleInvoiceKeyViewList.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 invoice-items-table" id="saleinvtable">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 14%;">Invoice No</th>
                        <th style="width: 28%;">Client &amp; Project</th>
                        <th class="text-center" style="width: 14%;">Invoice Date</th>
                        <th class="text-center" style="width: 12%;">Status</th>
                        <th class="text-end" style="width: 18%;">Net Amount (&#8377;)</th>
                        <th class="text-center pe-3" style="width: 14%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SaleInvoiceKeyViewList)
                    {
                        var clientInitial = !string.IsNullOrEmpty(item.VenderName) ? item.VenderName.Substring(0, 1).ToUpper() : "C";
                        <tr>
                            <!-- Reference / Invoice Number -->
                            <td class="ps-3">
                                <a href="/Invoice/SaleInvoiceDetails?ID=@item.SaleInvoiceID" target="_blank" class="fw-bold text-primary text-decoration-none d-inline-flex align-items-center gap-1">
                                    <i class="fa-solid fa-hashtag fs-11 text-muted"></i>@item.ReferenceNo
                                </a>
                            </td>

                            <!-- Client & Project Info with Avatar -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 32px; height: 32px; background: rgba(2, 132, 199, 0.12); color: #0284c7; font-size: 0.82rem;">
                                        @clientInitial
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold text-truncate" style="max-width: 220px; font-size: 0.83rem; color: var(--erp-text-main, #f8fafc);">
                                            @item.VenderName
                                        </span>
                                        <span class="text-muted text-truncate" style="max-width: 220px; font-size: 0.72rem;">
                                            <i class="fa-solid fa-diagram-project me-1 text-primary"></i>@item.ProjectName
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <!-- Invoice Date -->
                            <td class="text-center">
                                <span class="text-muted fw-medium" style="font-size: 0.8rem;">
                                    <i class="fa-regular fa-calendar me-1 text-primary"></i>@item.InvoiceDate.ToString("dd MMM yyyy")
                                </span>
                            </td>

                            <!-- Status Badge -->
                            <td class="text-center">
                                @if (!item.IsCancelled)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>Cancelled
                                    </span>
                                }
                            </td>

                            <!-- Net Payable Amount -->
                            <td class="text-end pe-3">
                                <span class="fw-bold" style="font-size: 0.88rem; color: var(--erp-text-main, #f8fafc);">
                                    &#8377;@item.BalanceAmount.ToString("N2")
                                </span>
                            </td>

                            <!-- Kanakku Action Buttons -->
                            <td class="text-center pe-3">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Quick View -->
                                    <a href="/Invoice/SaleInvoiceDetails?ID=@item.SaleInvoiceID" target="_blank" class="btn btn-sm btn-outline-info rounded-circle d-inline-flex align-items-center justify-content-center p-0" style="width: 28px; height: 28px;" title="View Invoice">
                                        <i class="fa-solid fa-eye" style="font-size: 0.72rem;"></i>
                                    </a>

                                    <!-- Quick Download PDF -->
                                    <a href="/Invoice/ExportSaleInvoice?InvID=@item.SaleInvoiceID" class="btn btn-sm btn-outline-primary rounded-circle d-inline-flex align-items-center justify-content-center p-0" style="width: 28px; height: 28px;" title="Download PDF">
                                        <i class="fa-solid fa-download" style="font-size: 0.72rem;"></i>
                                    </a>

                                    <!-- Dropdown Menu for More Actions -->
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 28px; height: 28px;">
                                            <i class="fa-solid fa-ellipsis-vertical" style="font-size: 0.75rem;"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 0.8rem; border-radius: 10px;">
                                            <li>
                                                <a href="@Url.Action("EditSaleInvoice", new { InvID = item.SaleInvoiceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" class="dropdown-item d-flex align-items-center gap-2">
                                                    <i class="fa-solid fa-pen-to-square text-primary"></i> Edit Invoice
                                                </a>
                                            </li>
                                            <li>
                                                <a href="/Invoice/ExportSaleInvoice?InvID=@item.SaleInvoiceID" class="dropdown-item d-flex align-items-center gap-2">
                                                    <i class="fa-solid fa-file-pdf text-danger"></i> Export PDF
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <a href="@Url.Action("CancelledSaleInvoice", "Invoice", new {Area="", ID = item.SaleInvoiceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, ListCount = Model.SaleInvoiceKeyViewList.Count(), SearchTerm = @ViewBag.SearchTerm })" class="dropdown-item d-flex align-items-center gap-2 text-danger" data-record="@item.ReferenceNo">
                                                    @if (!@item.IsCancelled)
                                                    {
                                                        <i class="fa-solid fa-ban text-danger"></i> <span>Cancel Invoice</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-rotate-left text-success"></i> <span class="text-success">Re-activate</span>
                                                    }
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Section -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 border-top" style="border-color: var(--erp-border, rgba(255,255,255,0.06)) !important;">
            <div style="font-size: 0.78rem;" class="text-muted">
                Showing <span class="fw-bold text-primary">@Model.SaleInvoiceKeyViewList.Count()</span> of <span class="fw-bold">@Model.TotalRecords</span> invoices
            </div>
            <div class="ns-pagination">
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("SaleInvoiceList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <span class="avatar rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(2, 132, 199, 0.1); color: #38bdf8; font-size: 1.5rem;">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </span>
            </div>
            <h6 class="fw-bold mb-1" style="color: var(--erp-text-main, #f8fafc);">No Sales Invoices Found</h6>
            <p class="text-muted mb-3" style="font-size: 0.8rem;">No invoices match your current search filters or no records have been created yet.</p>
            <a href="@Url.Action("saleinvoice","invoice")" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-semibold">
                <i class="fa-solid fa-plus-circle me-1"></i> Create First Invoice
            </a>
        </div>
    }
</div>
