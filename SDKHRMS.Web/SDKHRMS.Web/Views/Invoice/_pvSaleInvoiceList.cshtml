@model SDKHRMS.Entities.ViewModels.SaleInvoiceVM
<div id="DataGrid" class="">
    @if (Model.SaleInvoiceKeyViewList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered" id="saleinvtable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Reference No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Invoice Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Client Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Project Name
                        </th> 
                        <th class="text-center" style="vertical-align: middle;">
                            Status
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Net Payable Amount (&#8377;)
                        </th>
                        <th class="text-center" style="vertical-align: middle;width:120px;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SaleInvoiceKeyViewList)
                    {


                        <tr>
                            <td class="text-center">
                                @if (!item.IsCancelled)
                                {
                                    <span class="badge badge-soft-success text-dark rounded-pill">  @item.ReferenceNo</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger text-dark rounded-pill">  @item.ReferenceNo</span>
                                }
                            </td>
                            <td class="text-center">
                                @item.InvoiceDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                @item.VenderName
                            </td>
                            <td class="text-center">
                                @item.ProjectName
                            </td>
                            <td class="text-center">
                                @if (!item.IsCancelled)
                                {
                                    <span class="badge badge-soft-success text-dark rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger text-dark rounded-pill">Cancelled</span>
                                }
                            </td>
                            <td class="text-center">
                                @item.BalanceAmount.ToString("0.00")
                            </td>
                            <td>
                                <div class="row">
                                    <div class="col-md-6">
                                        <a href="/Invoice/SaleInvoiceDetails?ID=@item.SaleInvoiceID" class="btn-action-icon bg-light-gray" title="View Sale Incoice Details" target="_blank">
                                            <i class="fe fe-eye "></i>
                                        </a>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="dropdown dropdown-action me-3 ">
                                            <a href="#"
                                               class="btn-action-icon bg-primary-light"
                                               data-bs-toggle="dropdown"
                                               aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <ul>
                                                    <li>
                                                        <a href="@Url.Action("EditSaleInvoice", new { InvID = item.SaleInvoiceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="Edit">
                                                            <i class="fe fe-edit-2 me-2"></i> Edit
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form action="/Invoice/CancelledSaleInvoice" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("ID", (string)item.SaleInvoiceID)
                                                            <a href="@Url.Action("CancelledSaleInvoice", "Invoice", new {Area="", ID = item.SaleInvoiceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, ListCount = Model.SaleInvoiceKeyViewList.Count(), SearchTerm = @ViewBag.SearchTerm })" class="RefCancel dropdown-item grid-button" data-toggle="tooltip" data-placement="bottom" title="Cancel/Active PO" data-record="@item.ReferenceNo">
                                                                @if (!@item.IsCancelled)
                                                                {
                                                                    <i class="fe fe-x me-2"></i>
                                                                    <span title="Cancelled reference No."> Cancel</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="fe fe-check me-2"></i>
                                                                    <span title="Cancelled reference No."> Active</span>
                                                                }
                                                            </a>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <a href="/Invoice/ExportSaleInvoice?InvID=@item.SaleInvoiceID" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="Generate Invoice">
                                                            <i class="fe fe-download me-2"></i> Download
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*<a href="@Url.Action("EditSaleInvoice", new { InvID = item.SaleInvoiceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray float-start me-1">
                                        <i class="fe fe-edit-2"></i>
                                    </a>
                                    <a href="javascript:void(0)" id="Key_@item.SaleInvoiceID" data-toggle="collapse" data-target="#item_@item.SaleInvoiceID" data-parent="#saleinvtable" data-placement="bottom" title="View" class="invno btn-action-icon bg-light-gray float-start me-1">
                                        <i class="fe fe-external-link text-primary"></i>
                                    </a>
                                    <a href="@Url.Action("ExportSaleInvoice", new { InvID = item.SaleInvoiceID })" data-toggle="tooltip" data-placement="bottom" title="Generate Invoice" class="btn-action-icon bg-light-gray float-start me-1">
                                        <i class="fe fe-download text-dark"></i>
                                    </a>*@
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/Invoice/SaleInvoiceList">
                <span class="badge bg-warning text-dark">Showing @Model.SaleInvoiceKeyViewList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("SaleInvoiceList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched record in not available..</span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
