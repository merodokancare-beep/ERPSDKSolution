@model SDKHRMS.Entities.ViewModels.InvoiceAddViewModel

@if (Model?.ProjectClientDtlsView != null)
{
    <input type="hidden" id="hdnWONo" value="@(Model.ProjectClientDtlsView.WONo ?? "")" />
    <input type="hidden" id="hdnWODate" value="@(Model.ProjectClientDtlsView.WODate ?? "")" />
    <input type="hidden" id="hdnVendorID" value="@Model.ProjectClientDtlsView.VendorID" />

    <div class="invoice-client-summary-card p-2.5 rounded-3 border mt-2">
        <div class="row g-2 align-items-start">
            <!-- Left: Client & Project Info -->
            <div class="col-sm-7 col-12">
                <div class="d-flex align-items-center gap-1.5 mb-1">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">Customer</span>
                    <h6 class="fw-bold text-success mb-0 text-truncate" style="font-size: 0.88rem;" title="@Model.ProjectClientDtlsView.VenderName">
                        <i class="fa-solid fa-building-user me-1"></i>@Model.ProjectClientDtlsView.VenderName
                    </h6>
                </div>
                <div class="small mb-1" style="font-size: 0.76rem; line-height: 1.35;">
                    <span class="text-muted">Project:</span>
                    <span class="fw-semibold client-project-name">@Model.ProjectClientDtlsView.ProjectName</span>
                </div>
            </div>

            <!-- Right: Project Cost & GST -->
            <div class="col-sm-5 col-12 text-sm-end text-start">
                <div class="mb-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 fw-bold" style="font-size: 0.76rem;">
                        Cost: &#8377; @Model.ProjectClientDtlsView.ProjValue.ToString("N2")
                    </span>
                </div>
                <div class="font-monospace" style="font-size: 0.72rem; word-break: break-all;">
                    <span class="text-muted">GST:</span>
                    <span class="text-info fw-bold">@(string.IsNullOrWhiteSpace(Model.ProjectClientDtlsView.GSTNo) ? "N/A" : Model.ProjectClientDtlsView.GSTNo)</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProjectClientDtlsView.VenderAddress))
        {
            <div class="pt-1.5 mt-1.5 border-top client-address-row" style="font-size: 0.74rem; line-height: 1.35;">
                <i class="fa-solid fa-location-dot me-1 text-success opacity-75"></i>@Model.ProjectClientDtlsView.VenderAddress
            </div>
        }
    </div>
}

