@model SDKHRMS.Entities.ViewModels.InvoiceAddViewModel

@if (@Model.ProjectClientDtlsView != null)
{
    <div class="row">
        <div class="col-xl-9 col-lg-9 col-sm-12 col-12 d-flex">
            <div class="card inovices-card w-100" style="padding:0px!important">
                <div class="card-body">
                    <div class="dash-widget-header">
                        <div class="dash-count">
                            <div class="dash-title">Project Name</div>
                            <div class="dash-counts">
                                <p>@Model.ProjectClientDtlsView.ProjectName</p>
                            </div>
                            <div class="dash-title">Client Name</div>
                            <div class="dash-counts">
                                <p>@Model.ProjectClientDtlsView.VenderName</p>
                            </div>
                            <div class="dash-title">Client Address:</div>
                            <div class="dash-counts">
                                <p>@Model.ProjectClientDtlsView.VenderAddress</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-sm-12 col-12 d-flex">
            <div class="card inovices-card w-100" style="padding:0px!important">
                <div class="card-body">
                    <div class="dash-widget-header">
                        <div class="dash-count">
                            <div class="dash-title">Project Cost</div>
                            <div class="dash-counts">
                                <p>@Model.ProjectClientDtlsView.ProjValue.ToString("0.00")</p>
                            </div>
                            <div class="dash-title">Client GST No.</div>
                            <div class="dash-counts">
                                <p>@Model.ProjectClientDtlsView.GSTNo</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

