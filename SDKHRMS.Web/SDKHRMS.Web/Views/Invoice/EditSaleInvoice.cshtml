            //Project Details
            var applyWorkOrderDetails = function (isUserChange) {
                var woNo = $('#hdnWONo').val() || '';
                var woDate = $('#hdnWODate').val() || '';
                var vendorID = $('#hdnVendorID').val() || '';

                var $clientInput = $('#ClientID, #SaleInvoiceKeyModel_VenderID, input[name$="VenderID"]');
                var $ordernoInput = $('#orderno, #SaleInvoiceKeyModel_OrderNo, input[name$="OrderNo"]');
                var $orderdtInput = $('#orderdt, #SaleInvoiceKeyModel_OrderDate, input[name$="OrderDate"]');

                if (vendorID) {
                    $clientInput.val(vendorID);
                }

                if (isUserChange === true || !$ordernoInput.val()) {
                    $ordernoInput.val(woNo);
                }

                if (isUserChange === true || !$orderdtInput.val()) {
                    $orderdtInput.val(woDate);
                }
            };

            var ddProject = function (isUserChange) {
                var selectVal = $('#proj').val();
                if (selectVal && selectVal != "0" && selectVal != "") {
                    $.ajax({
                        type: 'GET',
                        url: "/Invoice/GetProjectClientDetails",
                        data: { id: selectVal },
                        success: function (data) {
                            $('#DataGrid').html(data);
                            $('#DataGrid').removeClass("d-none hidden");
                            applyWorkOrderDetails(isUserChange);
                        }
                    });
                }
                else {
                    $('#DataGrid').addClass("d-none hidden");
                }
            };

            $('#proj').on('select2:select change', function () {
                ddProject(true);
            });
            $(document).on('change', '#proj', function () {
                ddProject(true);
            });
            ddProject(false);

        });

