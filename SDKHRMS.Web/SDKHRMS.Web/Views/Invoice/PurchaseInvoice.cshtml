@model SDKHRMS.Entities.ViewModels.PurchaseAddViewModel
@{
    ViewBag.Title = "Manage Purchase";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    int i = 1; int j = 0;
    List<string> POType = new List<string> { "With Purchase Order", "Without Purchase Order" };
}
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Add Procurement Details</h5>
    </div>
</div>

@using (Html.BeginForm("PurchaseInvoice", "Invoice", FormMethod.Post, new { id = "purchase", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                @*<div class="card-header">
                        <h5 class="card-title">New Purchase Invoice</h5>
                    </div>*@
                <div class="card-body card-buttons">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="control-label required">PO Type</label>
                                @Html.DropDownListFor(m => m.PurchaseInvoiceKeyModel.POType, new SelectList(POType), "--- Select PO Type---", new { @class = "form-control ddSelect2", @id = "potype" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.POType)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PurchaseInvoiceKeyModel.VenderID, new { @class = "control-label required" })
                                @Html.DropDownListFor(m => m.PurchaseInvoiceKeyModel.VenderID, new SelectList(@Model.VendorDDList, "VenderID", "VenderName"), "--- Select Vendor Name---", new { @class = "form-control ddSelect2", @id = "vendor", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.VenderID)
                            </div>

                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Project Name <span class="text-muted">(If Applicable)</span></label>
                                @Html.DropDownListFor(m => m.PurchaseInvoiceKeyModel.ProjectID, new SelectList(@Model.ProjectDDList, "ProjectID", "ProjectName"), "--- Select Project Name---", new { @class = "form-control ddSelect2", @id = "proj", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.ProjectID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PurchaseInvoiceKeyModel.PurchaseDate, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.PurchaseDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Purchase Date", @id = "purdt" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.PurchaseDate)
                            </div>

                        </div>
                        <div class="col-xl-6 d-none" id="div_billno">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PurchaseInvoiceKeyModel.BillNo, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.BillNo, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Bill No." })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.BillNo)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Ship To</label>
                                @Html.TextAreaFor(m => m.ShipTo, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ShipTo)
                            </div>
                        </div>
                        <div class="col-xl-6 d-none" id="upload_div">
                            <div class="form-group row">
                                <label class="control-label">Upload Bill: </label>
                                <input type="file" class="btn btn-primary" name="UploaBill" id="Bill" />
                                @Html.ValidationMessage("BillsError")
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PurchaseInvoiceKeyModel.Remarks, new { @class = "control-label required" })
                                @Html.TextAreaFor(m => m.PurchaseInvoiceKeyModel.Remarks, new { @class = "form-control", autocomplete = "off", @placeholder = "Remarks", @id = "rem" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.Remarks)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Terms Conditions </label>
                                @Html.TextAreaFor(m => m.PurchaseInvoiceKeyModel.TermsConditions, new { @class = "form-control", @placeholder = "Terms Conditions" })
                                @Html.ValidationMessageFor(m => m.PurchaseInvoiceKeyModel.TermsConditions)
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-xl-12"><button class="btn btn-dark btn-sm float-end" type="button" id="addnewitems"><i class="fe fe-plus-circle me-2"></i>Add New Row</button></div>
                    </div>
                    <div class="row">
                        <div class=" col-md-12 ">
                            <table class="table table-bordered table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th class="col-width-25 text-center" style="vertical-align:middle;width:4%">
                                            Sl
                                        </th>
                                        <th class="col-width-400 text-center" style="vertical-align: middle; width: 20%">
                                            Item Name
                                        </th>
                                        <th class="col-width-200 text-center" style="vertical-align: middle; width: 11%">
                                            HSN Code
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 6%">
                                            GST %
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 6%">
                                            IGST %
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 6%">
                                            CGST %
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 6%">
                                            SGST %
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 9%">
                                            Order Qty
                                        </th>
                                        <th class="col-width-200 text-center" style="vertical-align: middle; width: 13%">
                                            Rate
                                        </th>
                                        <th class="col-width-300 text-center" style="vertical-align: middle; width: 15%">
                                            Amount
                                        </th>
                                        <th class="col-width-25 text-center" style="vertical-align: middle; width: 4%">
                                            Action
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="itemtable">
                                    @if (@Model.CustomInvoiceItemList == null)
                                    {
                                        <tr class="member-data-row">
                                            <td class="slno text-center" style="vertical-align:middle;">1</td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextAreaFor(m => m.CustomInvoiceItemList[0].ItemName, new { @class = "form-control itemname", autocomplete = "off", @placeholder = "Item Name" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].ItemName)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].ItemHSNCode, new { @class = "form-control ItemHSNCode", autocomplete = "off", @placeholder = "HSN Code" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].ItemHSNCode)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].GSTPercentage, new { @class = "form-control gstper", autocomplete = "off", @placeholder = "Gst %" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].GSTPercentage)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].IGSTPercentage, new { @class = "form-control igst", autocomplete = "off", @placeholder = "IGST %" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].IGSTPercentage)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].CGSTPercentage, new { @class = "form-control cgst", autocomplete = "off", @placeholder = "CGST %" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].CGSTPercentage)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].SGSTPercentage, new { @class = "form-control sgst", autocomplete = "off", @placeholder = "SGST %" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].SGSTPercentage)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].Qty, new { @class = "form-control qty", autocomplete = "off", @placeholder = "Qty" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].Qty)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].Rate, new { @class = "form-control rate", autocomplete = "off", @placeholder = "Rate" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].Rate)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.CustomInvoiceItemList[0].Amount, new { @class = "form-control amount", autocomplete = "off", @placeholder = "Amount", @readonly = "readonly" })
                                                @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[0].Amount)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                <i class="fa fa-trash rowremove btn-sm btn-danger" title="Remove"></i>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in @Model.CustomInvoiceItemList)
                                        {
                                            <tr class="member-data-row">
                                                <td class="text-center slno" style="vertical-align:middle;">@i</td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextAreaFor(m => m.CustomInvoiceItemList[i - 1].ItemName, new { @class = "form-control itemname", autocomplete = "off", @placeholder = "Item Name" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].ItemName)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].ItemHSNCode, new { @class = "form-control ItemHSNCode", autocomplete = "off", @placeholder = "HSN Code" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].ItemHSNCode)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].GSTPercentage, new { @class = "form-control gstper", autocomplete = "off", @placeholder = "Gst %" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].GSTPercentage)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].IGSTPercentage, new { @class = "form-control igst", autocomplete = "off", @placeholder = "IGST %" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].IGSTPercentage)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].CGSTPercentage, new { @class = "form-control cgst", autocomplete = "off", @placeholder = "CGST %" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].CGSTPercentage)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].SGSTPercentage, new { @class = "form-control sgst", autocomplete = "off", @placeholder = "SGST %" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].SGSTPercentage)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].Qty, new { @class = "form-control qty", autocomplete = "off", @placeholder = "Qty", @data_index = @j })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].Qty)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].Rate, new { @class = "form-control rate", autocomplete = "off", @placeholder = "Rate", @data_index = @j })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].Rate)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.CustomInvoiceItemList[i - 1].Amount, new { @class = "form-control amount", autocomplete = "off", @placeholder = "Amount", @readonly = "readonly" })
                                                    @Html.ValidationMessageFor(m => m.CustomInvoiceItemList[i - 1].Amount)
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    <i class="rowremove btn-sm btn-danger glyphicon glyphicon-trash" title="Remove"></i>
                                                </td>
                                            </tr>
                                            i++; j++;
                                        }
                                    }
                                </tbody>
                                <tr class="TotalSec">
                                    <td colspan="9" class="text-right font-bold">Net Billing Amount</td>
                                    <td class="text-right font-bold">
                                        @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.ExcludingTaxAmt, new { @class = "form-control", @autocomplete = "off", @id = "EXcludeTax", @readonly = "readonly" })
                                    </td>
                                    <td class="text-center font-bold"><span>-</span></td>
                                </tr>
                                <tr class="TotalSec">
                                    <td colspan="9" class="text-right font-bold">IGST Amount</td>
                                    <td class="text-right font-bold">
                                        @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.IGSTAmount, new { @class = "form-control", @autocomplete = "off", @id = "IGSTAmt", @readonly = "readonly" })
                                    <td class="text-center font-bold"><span>-</span></td>
                                </tr>
                                <tr class="TotalSec">
                                    <td colspan="9" class="text-right font-bold">CGST Amount</td>
                                    <td class="text-right font-bold">
                                        @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.CGSTAmount, new { @class = "form-control", @autocomplete = "off", @id = "CGSTAmt", @readonly = "readonly" })
                                    </td>
                                    <td class="text-center font-bold"><span>-</span></td>
                                </tr>
                                <tr class="TotalSec">
                                    <td colspan="9" class="text-right font-bold">SGST Amount</td>
                                    <td class="text-right font-bold">
                                        @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.SGSTAmount, new { @class = "form-control", @autocomplete = "off", @style = "margin-bottom:2px;", @id = "SGSTAmt", @readonly = "readonly" })
                                    </td>
                                    <td class="text-center font-bold"><span>-</span></td>
                                </tr>
                                <tr class="TotalSec">
                                    <td colspan="9" class="text-right font-bold">Total Billing Amount</td>
                                    <td class="text-right font-bold">
                                        @Html.TextBoxFor(m => m.PurchaseInvoiceKeyModel.IncludingTaxAmt, new { @class = "form-control", @autocomplete = "off", @id = "GTAmt", @readonly = "readonly" })
                                    </td>
                                    <td class="text-center font-bold"><span>-</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>


                    <div class="text-end mt-3">
                        <button type="reset" onclick="location.href='@Url.Action("PurchaseInvoiceList")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Scripts/bootstrap-autocomplete.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#purdt').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            })
            var bindAutoComplete = function () {
                $('.member-data-row').each(function (index) {
                    $('#CustomInvoiceItemList_' + index + '__Qty').on('input', function () { calculateamount(this) })
                    $('#CustomInvoiceItemList_' + index + '__Rate').on('input', function () { calculateamount(this) })
                    $('#CustomInvoiceItemList_' + index + '__GSTPercentage').on('input', function () { calculateamount(this) })
                    $('#CustomInvoiceItemList_' + index + '__IGSTPercentage').on('input', function () { calculateamount(this) })
                    $('#CustomInvoiceItemList_' + index + '__CGSTPercentage').on('input', function () { calculateamount(this) })
                    $('#CustomInvoiceItemList_' + index + '__SGSTPercentage').on('input', function () { calculateamount(this) })
                })

            }
            bindAutoComplete();

            var totalcalculation = function () {
                var ETAmtSum = 0;
                var IGSTAmtSum = 0;
                var CGSTAmtSum = 0;
                var SGSTAmtSum = 0;
                var GTAmt = 0;
                var rowno = $(".member-data-row").length;
                var newrowno = rowno + 1;
                $('.amount').each(function (rowno) {
                    var indxetamt = parseFloat($('#CustomInvoiceItemList_' + rowno + '__Amount').val());
                    if ($('#CustomInvoiceItemList_' + rowno + '__IGSTPercentage').val() != 0) {
                        var indxigstamt = parseFloat($('#CustomInvoiceItemList_' + rowno + '__IGSTPercentage').val() / 100) * indxetamt;
                        IGSTAmtSum += indxigstamt;
                        ETAmtSum += indxetamt;
                    }
                    else if ($('#CustomInvoiceItemList_' + rowno + '__CGSTPercentage').val() != 0 && $('#CustomInvoiceItemList_' + rowno + '__SGSTPercentage').val() != 0) {
                        var indxcgstamt = parseFloat($('#CustomInvoiceItemList_' + rowno + '__CGSTPercentage').val() / 100) * indxetamt;
                        CGSTAmtSum += indxcgstamt;
                        var indxsgstamt = parseFloat($('#CustomInvoiceItemList_' + rowno + '__SGSTPercentage').val() / 100) * indxetamt;
                        SGSTAmtSum += indxsgstamt;
                        ETAmtSum += indxetamt;
                    }
                    else {
                        var nogst = 0;
                        IGSTAmtSum += nogst;
                        CGSTAmtSum += nogst
                        SGSTAmtSum += nogst
                        ETAmtSum += indxetamt;
                        //alert('Please Enter The IGST OR CGST & SGST Percentage according to ur transaction in ' + (rowno + 1) + ' Row');
                        //$('#CustomInvoiceItemList_' + rowno + '__Qty').val("")
                        //$('#CustomInvoiceItemList_' + rowno + '__Rate').val("")
                        //$('#CustomInvoiceItemList_' + rowno + '__Amount').val("")
                    }
                    ($('#EXcludeTax').val(ETAmtSum.toFixed(2)));
                    ($('#IGSTAmt').val(IGSTAmtSum.toFixed(2)));
                    ($('#CGSTAmt').val(CGSTAmtSum.toFixed(2)));
                    ($('#SGSTAmt').val(SGSTAmtSum.toFixed(2)));
                })
                GTAmt = parseFloat(ETAmtSum + IGSTAmtSum + CGSTAmtSum + SGSTAmtSum);
                ($('#GTAmt').val(GTAmt.toFixed(2)));

            };

            //Calculate Amount Based on Qty & Rate
            var calculateamount = function (index) {
                var id = $(index).attr("id").split("_");
                id = id[1];
                if (($('#CustomInvoiceItemList_' + id + '__Qty').val() != "") && ($('#CustomInvoiceItemList_' + id + '__Rate').val() != "")) {
                    var amount = (($('#CustomInvoiceItemList_' + id + '__Qty').val()) * ($('#CustomInvoiceItemList_' + id + '__Rate').val()));
                    $('#CustomInvoiceItemList_' + id + '__Amount').val(amount.toFixed(2));
                    totalcalculation();
                }
            }

            //Function for Add New Rows
            var addnewrows = function () {
                var count = $(".member-data-row").length;
                var index = count;
                var slno = count + 1;
                $("#itemtable").append('<tr class="member-data-row">' +
                    '<td class="text-center slno" style="vertical-align:middle;">' + slno + '</td>'
                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<textarea autocomplete="off" class="form-control itemname" cols="20" data-val="true" data-val-required="The ItemName field is required." id="CustomInvoiceItemList_' + index + '__ItemName" name="CustomInvoiceItemList[' + index + '].ItemName" placeholder="Item Name" rows="2"></textarea>'
                    + '<span class="field-validation-valid item-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].ItemName" data-valmsg-replace="true"></span>'
                    + '</td>'
                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<input autocomplete="off" class="form-control ItemHSNCode valid" data-val="true" data-val-required="The ItemHSNCode field is required." id="CustomInvoiceItemList_' + index + '__ItemHSNCode" name="CustomInvoiceItemList[' + index + '].ItemHSNCode" placeholder="HSN/SCA Code"  type="text" value=""/>'
                    + '<span class="field-validation-valid ItemHSNCode-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].ItemHSNCode" data-valmsg-replace="true"></span></td>'

                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<input autocomplete="off" class="form-control gstper" data-val="true" data-val-number="The field GSTPercentage must be a number." data-val-required="The GSTPercentage field is required." id="CustomInvoiceItemList_' + index + '__GSTPercentage" name="CustomInvoiceItemList[' + index + '].GSTPercentage" placeholder="Gst %"  type="text" value=""/>'
                    + '<span class="field-validation-valid gstper-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].GSTPercentage" data-valmsg-replace="true"></span></td>'

                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<input autocomplete="off" class="form-control igst" data-val="true" data-val-number="The field IGST Amount must be a number." data-val-required="The IGSTPercentage field is required." id="CustomInvoiceItemList_' + index + '__IGSTPercentage" name="CustomInvoiceItemList[' + index + '].IGSTPercentage" placeholder="IGST %"  type="text" value="0"/>'
                    + '<span class="field-validation-valid igst-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].IGSTPercentage" data-valmsg-replace="true"></span></td>'

                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<input autocomplete="off" class="form-control cgst" data-val="true" data-val-number="The field CGST Amount must be a number." data-val-required="The CGSTPercentage field is required." id="CustomInvoiceItemList_' + index + '__CGSTPercentage" name="CustomInvoiceItemList[' + index + '].CGSTPercentage" placeholder="CGST %"  type="text" value="0"/>'
                    + '<span class="field-validation-valid cgst-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].CGSTPercentage" data-valmsg-replace="true"></span></td>'

                    + '<td class="text-center" style="vertical-align:middle;">'
                    + '<input autocomplete="off" class="form-control sgst" data-val="true" data-val-number="The field SGST Amount must be a number." data-val-required="The SGSTPercentage field is required." id="CustomInvoiceItemList_' + index + '__SGSTPercentage" name="CustomInvoiceItemList[' + index + '].SGSTPercentage" placeholder="SGST %"  type="text" value="0"/>'
                    + '<span class="field-validation-valid sgst-span" data-valmsg-for="CustomInvoiceItemList[' + index + '].SGSTPercentage" data-valmsg-replace="true"></span></td>'
                    + '<td class="text-center" style="vertical-align:middle;">'
