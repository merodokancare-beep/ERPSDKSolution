            //Hide and show the billno div
            function hidebillno() {
                if ($('#potype').val() != "") {
                    var POType = $("#potype").find('option:selected').val();
                    //alert(POType);
                    if (POType == "Without Purchase Order") {
                        $('#div_billno').removeClass('d-none');
                        $('#upload_div').removeClass('d-none');
                    }
                    else {
                        $('#div_billno').addClass('d-none');
                        $('#upload_div').addClass('d-none');
                    }
                }
                else {
                    $('#div_billno').addClass('d-none');
                    $('#upload_div').addClass('d-none');
                }
            }
