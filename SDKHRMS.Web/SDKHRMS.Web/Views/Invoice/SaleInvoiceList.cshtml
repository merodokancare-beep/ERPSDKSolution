@model SDKHRMS.Entities.ViewModels.SaleInvoiceVM
@{
    ViewBag.Title = "Sales Invoices";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var totalInvoicesCount = Model.SaleInvoiceKeyViewList != null ? Model.SaleInvoiceKeyViewList.Count() : 0;
    var activeInvoicesCount = Model.SaleInvoiceKeyViewList != null ? Model.SaleInvoiceKeyViewList.Count(x => !x.IsCancelled) : 0;
    var cancelledInvoicesCount = Model.SaleInvoiceKeyViewList != null ? Model.SaleInvoiceKeyViewList.Count(x => x.IsCancelled) : 0;
    var totalAmountSum = Model.SaleInvoiceKeyViewList != null ? Model.SaleInvoiceKeyViewList.Sum(x => x.BalanceAmount) : 0;
}

<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />

<!-- Kanakku Page Header & Breadcrumb -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size: 0.76rem;">
                <li class="breadcrumb-item"><a href="/home/newdashboard" class="text-muted"><i class="fa-solid fa-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a href="#" class="text-muted">Sales &amp; Invoicing</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Invoices</li>
            </ol>
        </nav>
        <h4 class="mb-0 fw-bold" style="font-size: 1.3rem;">
            <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Invoices
        </h4>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1 shadow-sm" href="@Url.Action("saleinvoice","invoice")">
            <i class="fa-solid fa-plus-circle"></i> Create New Invoice
        </a>
    </div>
</div>

<!-- Kanakku 4 Top KPI Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 rounded-4 shadow-sm h-100" style="background: var(--erp-bg-card, #131825); border: 1px solid var(--erp-border, rgba(255,255,255,0.08)) !important;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <span class="text-muted fw-semibold" style="font-size: 0.76rem;">Total Invoices</span>
                        <h5 class="fw-bold mb-0 mt-1" style="color: var(--erp-text-main, #f8fafc);">&#8377;@totalAmountSum.ToString("N2")</h5>
                    </div>
                    <span class="avatar rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(2, 132, 199, 0.15); color: #38bdf8; font-size: 1.15rem;">
                        <i class="fa-solid fa-receipt"></i>
                    </span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: var(--erp-border, rgba(255,255,255,0.06)) !important; font-size: 0.72rem;">
                    <span class="text-muted">Filtered Records</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@totalInvoicesCount Invoices</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 rounded-4 shadow-sm h-100" style="background: var(--erp-bg-card, #131825); border: 1px solid var(--erp-border, rgba(255,255,255,0.08)) !important;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <span class="text-muted fw-semibold" style="font-size: 0.76rem;">Active Invoices</span>
                        <h5 class="fw-bold text-success mb-0 mt-1">@activeInvoicesCount</h5>
                    </div>
                    <span class="avatar rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 1.15rem;">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: var(--erp-border, rgba(255,255,255,0.06)) !important; font-size: 0.72rem;">
                    <span class="text-muted">Status</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active / Generated</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 rounded-4 shadow-sm h-100" style="background: var(--erp-bg-card, #131825); border: 1px solid var(--erp-border, rgba(255,255,255,0.08)) !important;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <span class="text-muted fw-semibold" style="font-size: 0.76rem;">Cancelled Invoices</span>
                        <h5 class="fw-bold text-danger mb-0 mt-1">@cancelledInvoicesCount</h5>
                    </div>
                    <span class="avatar rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-size: 1.15rem;">
                        <i class="fa-solid fa-ban"></i>
                    </span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: var(--erp-border, rgba(255,255,255,0.06)) !important; font-size: 0.72rem;">
                    <span class="text-muted">Status</span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Cancelled</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 rounded-4 shadow-sm h-100" style="background: var(--erp-bg-card, #131825); border: 1px solid var(--erp-border, rgba(255,255,255,0.08)) !important;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <span class="text-muted fw-semibold" style="font-size: 0.76rem;">Total Records in DB</span>
                        <h5 class="fw-bold text-warning mb-0 mt-1">@Model.TotalRecords</h5>
                    </div>
                    <span class="avatar rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.15); color: #f59e0b; font-size: 1.15rem;">
                        <i class="fa-solid fa-database"></i>
                    </span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: var(--erp-border, rgba(255,255,255,0.06)) !important; font-size: 0.72rem;">
                    <span class="text-muted">Repository Total</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">All Time</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Table Card with Kanakku Search Toolbar -->
<div class="row">
    <div class="col-sm-12">
        <div class="invoice-section-card">
            <div class="card-header py-3">
                <form method="get" action="@Url.Action("SaleInvoicelist")" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid" id="sForm" class="w-100">
                    <div class="row g-2 align-items-center">
                        <div class="col-xl-4 col-lg-4 col-md-12">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border text-primary" id="basic-addon1"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text"
                                       id="inputsearch"
                                       class="form-control invoice-input-pill"
                                       placeholder="Search invoice no, client..."
                                       aria-label="Search"
                                       name="searchTerm"
                                       aria-describedby="basic-addon1" />
                                <button class="btn btn-primary btn-sm px-3" id="search-btn" type="submit">
                                    Search
                                </button>
                                <button onclick="location.href='@Url.Action("SaleInvoicelist")'" type="button" class="btn btn-secondary btn-sm d-none" id="clearSearchBtn">Clear</button>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4 col-6">
                            @Html.DropDownList("YearNo", new SelectList(Model.SaleYearDD, "YearNo", "YearNo", @ViewBag.YearNo), "--- Select Year ---", new { @class = "form-control ddSelect2 invoice-input-pill", id = "yr" })
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4 col-6">
                            @Html.DropDownList("MonNo", new List<SelectListItem>{
                                new SelectListItem{Text="January", Value="1"},
                                new SelectListItem{Text="February", Value="2"},
                                new SelectListItem{Text="March", Value="3"},
                                new SelectListItem{Text="April", Value="4"},
                                new SelectListItem{Text="May", Value="5"},
                                new SelectListItem{Text="June", Value="6"},
                                new SelectListItem{Text="July", Value="7"},
                                new SelectListItem{Text="August", Value="8"},
                                new SelectListItem{Text="September", Value="9"},
                                new SelectListItem{Text="October", Value="10"},
                                new SelectListItem{Text="November", Value="11"},
                                new SelectListItem{Text="December", Value="12"}, }, "--- Select Month ---", new { @class = "form-control ddSelect2 invoice-input-pill", Value = @ViewBag.MonNo, @id = "month" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-4 col-12">
                            @Html.DropDownList("Client", new SelectList(Model.ClientDDList, "VenderID", "VenderName", @ViewBag.Client), "--- Filter By Client ---", new { @class = "form-control ddSelect2 invoice-input-pill", id = "Client" })
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                @Html.Partial("_pvSaleInvoiceList", Model)
            </div>
        </div>
    </div>
</div>


@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $("#search-btn").on("click", function (e) {
                if ($("#inputsearch").val() != "") {
                    $("#clearSearchBtn").removeClass("d-none");
                    $("#search-btn").addClass("d-none");
                }
                else {
                    $("#clearSearchBtn").addClass("d-none");
                    $("#search-btn").removeClass("d-none");

                }
            });
            var ExpandinvRow = function () {
                var trval = $(this).attr("id");
                var InvNO = trval.split('_');
                //alert('#' + InvNO[1])
                $.ajax({
                    url: "/Invoice/InvoiceItemListByID",
                    type: 'GET',
                    data: { InvID: InvNO[1] },
                    success: function (data) {
                        $('#' + InvNO[1]).html(data);
                    }
                });
            }
            $(document).on('click', '.invno', ExpandinvRow);

            $(document).on('change', '#yr', function () {
                $('#sForm').submit();
                //clearbtn();
            })
            $(document).on('change', '#month', function () {
                $('#sForm').submit();
                //clearbtn();
            })
            $(document).on('change', '#Client', function () {
                $('#sForm').submit();
                //clearbtn();
            })
        });
    </script>
}

