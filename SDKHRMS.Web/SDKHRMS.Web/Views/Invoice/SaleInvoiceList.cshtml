@model SDKHRMS.Entities.ViewModels.SaleInvoiceVM
@{
    ViewBag.Title = "SaleInvoiceList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        <h5>Sales Invoice List</h5>
        <div class="list-btn">
            <ul class="filter-list">
                <li>
                    <a class="btn btn-primary" href="@Url.Action("saleinvoice","invoice")">
                        <i class="fa fa-plus-circle me-2" aria-hidden="true"></i>Add Sales Invoice
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header card-buttons">
                <form method="get" action="@Url.Action("SaleInvoicelist")" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid" id="sForm">
                    <div class="form-group mb-0 row">
                        <div class="col-md-5">
                            <div class="input-group mb-3">
                                <span class="input-group-text" id="basic-addon1"><i class="fe fe-search"></i></span>
                                <input type="text"
                                       id="inputsearch"
                                       class="form-control"
                                       placeholder="Search"
                                       aria-label="Search"
                                       name="searchTerm"
                                       aria-describedby="basic-addon1" />
                                <button class="btn btn-primary" id="search-btn" type="submit">
                                    Search
                                </button>
                                <button onclick="location.href='@Url.Action("SaleInvoicelist")'" type="button" class="btn btn-primary d-none" id="clearSearchBtn">Clear Results</button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("YearNo", new SelectList(Model.SaleYearDD, "YearNo", "YearNo", @ViewBag.YearNo), "----Select Year----", new { @class = "form-control ddSelect2", id = "yr" })
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("MonNo", new List<SelectListItem>{
                                new SelectListItem{Text="January", Value="1"},
                                new SelectListItem{Text="February", Value="2"},
                                new SelectListItem{Text="March", Value="3"},
                                new SelectListItem{Text="April", Value="4"},
                                new SelectListItem{Text="May", Value="5"},
                                new SelectListItem{Text="June", Value="6"},
                                new SelectListItem{Text="July", Value="7"},
                                new SelectListItem{Text="August", Value="8"},
                                new SelectListItem{Text="September", Value="9"},
                                new SelectListItem{Text="October", Value="10"},
                                new SelectListItem{Text="November", Value="11"},
                                new SelectListItem{Text="December", Value="12"}, }, "--- Select Month ---", new { @class = "form-control ddSelect2", Value = @ViewBag.MonNo, @id = "month" })
                        </div>
                        <div class="col-md-3">
                            @Html.DropDownList("Client", new SelectList(Model.ClientDDList, "VenderID", "VenderName", @ViewBag.Client), "----Select Client----", new { @class = "form-control ddSelect2", id = "Client" })
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body">
                @Html.Partial("_pvSaleInvoiceList", Model)
            </div>
        </div>
    </div>
</div>


@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $("#search-btn").on("click", function (e) {
                if ($("#inputsearch").val() != "") {
                    $("#clearSearchBtn").removeClass("d-none");
                    $("#search-btn").addClass("d-none");
                }
                else {
                    $("#clearSearchBtn").addClass("d-none");
                    $("#search-btn").removeClass("d-none");

                }
            });
            var ExpandinvRow = function () {
                var trval = $(this).attr("id");
                var InvNO = trval.split('_');
                //alert('#' + InvNO[1])
                $.ajax({
                    url: "/Invoice/InvoiceItemListByID",
                    type: 'GET',
                    data: { InvID: InvNO[1] },
                    success: function (data) {
                        $('#' + InvNO[1]).html(data);
                    }
                });
            }
            $(document).on('click', '.invno', ExpandinvRow);

            $(document).on('change', '#yr', function () {
                $('#sForm').submit();
                //clearbtn();
            })
            $(document).on('change', '#month', function () {
                $('#sForm').submit();
                //clearbtn();
            })
            $(document).on('change', '#Client', function () {
                $('#sForm').submit();
                //clearbtn();
            })
        });
    </script>
}

