@model SDKHRMS.Entities.ViewModels.POPaymentSettleVM
@{
    ViewBag.Title = " Procurement Payment";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    List<string> modes = new List<string>() { "Cash", "Cheque", "Netbanking", "Others" };
    var POID = Model.POPaymentDtls.PurchaseInvoiceID;
    string mode = Model.PaymentReleased != null ? Model.PaymentReleased.PaymentMode : "";
}

<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Procurement's Payment Details</h5>
        <div class="list-btn">
            <ul class="filter-list">
                <li>
                    <a class="btn btn-primary" href="/POPayment/PODetails?id=@POID">
                        <i class="fe fe-file-text" aria-hidden="true"></i>View PO
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Ref./Bill NO.</div>
                        <div class="dash-counts">
                            <p>@(Model.POPaymentDtls.PORefNo ?? Model.POPaymentDtls.BillNo)</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">PO Type</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.POType</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Date</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.PurchaseDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Vendor Name</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.VenderName</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Remarks</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.Remarks</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Project</div>
                        <div class="dash-counts">
                            <p>@(Model.POPaymentDtls.ProjectName ?? "Not Linked")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-success-light">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Total Amount</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.IncludingTaxAmt.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-info-light">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Payment</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.AmountPaid.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-danger-light">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Balance</div>
                        <div class="dash-counts">
                            <p>@Model.POPaymentDtls.BalanceAmount.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Procurement's Payment Release</h5>
            </div>
            <div class="card-body card-buttons" id="paymenttrans">

            </div>

        </div>
    </div>
</div>
@if (Model.POPaymentDtls.BalanceAmount >= 1)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Procurement's Payment Release</h5>
                </div>

                <div class="card-body card-buttons">
                    @using (Html.BeginForm("POSettlement", "POPayment", FormMethod.Post, new { data_toggle = "validator", @novalidate = true, enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(m => m.POID)
                        <input type="hidden" name="BalanceAmt" value="@Model.POPaymentDtls.BalanceAmount" />
                        <div class="row">
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="required">Payment Release Date</label>
                                    @Html.TextBoxFor(m => m.PaymentReleased.PaymentDate, new { @class = "form-control", @id = "txtdate" })
                                    @Html.ValidationMessageFor(m => m.PaymentReleased.PaymentDate)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="required">Payment Release Amount</label>
                                    @Html.TextBoxFor(m => m.PaymentReleased.PaymentAmt, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.PaymentReleased.PaymentAmt)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group row">
                                    <label class="required">Payment Release Mode</label>
                                    @Html.DropDownListFor(m => m.PaymentReleased.PaymentMode, new SelectList(modes), "-- Select Mode --", new { @class = "form-control ddSelect2", @id = "ddMode" })
                                    @Html.ValidationMessageFor(model => model.PaymentReleased.PaymentMode)
                                </div>
                            </div>

                            @*<div class="col-xl-3">
                                    <div class="form-group row">
                                        <label class="required">Total Amount Release</label>
                                        <input type="text" id="tamt" class="form-control" readonly="readonly" />
                                    </div>
                                </div>*@
                            <div class="d-none row" id="bankdiv">
                                <div class="col-xl-4">
                                    <div class="form-group row">
                                        <label class="control-label required">Bank Name <i class="fe fe-info" title="Amount Transfer From"></i></label>
                                        @Html.DropDownListFor(model => model.PaymentReleased.BankID, new SelectList(Model.BankDD, "BankID", "BankName"), "-- Select Bank --", new { @class = "form-control ddSelect2", @id = "txtbank" })
                                        @Html.ValidationMessageFor(model => model.PaymentReleased.BankID)
                                    </div>
                                </div>
                                <div class="col-xl-4">
                                    <div class="form-group row">
                                        <label class="control-label required">Cheque/Transaction No.</label>
                                        @Html.TextBoxFor(model => model.PaymentReleased.PaymentTransNo, new { @class = "form-control", @id = "txttransno" })
                                        @Html.ValidationMessageFor(model => model.PaymentReleased.PaymentTransNo)
                                    </div>
                                </div>
                                <div class="col-xl-4">
                                    <div class="form-group row">
                                        <label class="control-label">Upload File <small>.jpeg/.png/.pdf</small></label>
                                        @Html.TextBoxFor(m => m.UploadFile, new { @class = "btn btn-sm btn-primary", type = "file", @id = "txtfile" })
                                        @Html.ValidationMessageFor(m => m.UploadFile)
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-12">
                                <div class="form-group row">
                                    <label class="required">Payment Release Remarks</label>
                                    @Html.TextAreaFor(m => m.PaymentReleased.Remarks, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.PaymentReleased.Remarks)
                                </div>
                            </div>
                            @*<div class="col-xl-3">
                                <div class="form-group row">
                                    <a href="#" class="btn btn-sm btn-primary mt-4"><i class="fe fe-file-text"></i> View PO</a>
                                </div>
                            </div>*@
                        </div>
                        <div class="text-end">
                            <button type="reset" onclick="location.href='@Url.Action("index")'" class="btn btn-primary cancel me-2">Cancel</button>
                            <input type="submit" value="Save" id="save" class="btn btn-primary" />
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    @*<script src="~/Scripts/bootstrap-autocomplete.js"></script>*@
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#txtdate').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            });

            var loadpayment = function () {
                $('#paymenttrans').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif" /><h2>Please wait....</h2></div>');
            $.ajax({
                type: 'GET',
                url: '/POPayment/GetPaymentTransByProjID',
                data: { ID: '@POID' },
                success: function (data) {
                    $('#paymenttrans').empty().append(data);
                },
                error: function () {
                    $('#paymenttrans').empty().append('<div class="panel-body"><img src="/Content/Images/img-warning.png" height="50" width="50"/><b>Could not load data. Please click here to reload...</b><button id="btnpayment"> <i class="fa fa-refresh"></i> Reload</button></div>');
                    //$('#gstinv').empty().append('<div class="margin-top-15"><b>Could not load data. Please click here to reload...</b><button id="btngstinv">Reload</button></div>');
                }
            });
        }
            $(document).on('click', "#btnpayment", loadpayment);
            loadpayment();
            loadPaySection('@mode');
            $('#ddMode').on('change', function () {
                loadPaySection($(this).val());
            });
            function loadPaySection(value) {
                if (value == 'Cash') {
                    $('#txtbank').val('');
                    $('#txttransno').val('');
                    $('#txtfile').val();
                    $('#bankdiv').addClass('d-none');
                } else if (value == '') {
                    $('#bankdiv').addClass('d-none');
                } else {
                    $('#bankdiv').removeClass('d-none');
                }
            }
        });

    </script>
}
