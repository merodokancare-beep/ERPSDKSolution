@model SDKHRMS.Entities.ViewModels.POPaymentView
@{
    ViewBag.Title = " Procurement Details";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    //List<string> modes = new List<string>() { "Cash", "Cheque", "Netbanking", "Others" };
    var POID = Model.PurchaseInvoiceID;
    //string mode = Model.PaymentReleased != null ? Model.PaymentReleased.PaymentMode : "";
}

<div class="page-header">
    <div class="content-page-header">
        <h5>Procurement's Details</h5>
    </div>
</div>

<div class="row">
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Date</div>
                        <div class="dash-counts">
                            <p>@Model.PurchaseDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-primary-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Total GST Input</div>
                        <div class="dash-counts">
                            <p>@Model.TotalGSTInput.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-success-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Total Amount</div>
                        <div class="dash-counts">
                            <p>@Model.IncludingTaxAmt.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-info-light">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Payment</div>
                        <div class="dash-counts">
                            <p>@Model.AmountPaid.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body bg-danger-light">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Balance</div>
                        <div class="dash-counts">
                            <p>@Model.BalanceAmount.ToString("0.00")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <div class="col-xl-4 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Ref./Bill NO.</div>
                        <div class="dash-counts">
                            <p>@(Model.PORefNo ?? Model.BillNo)</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">PO Type</div>
                        <div class="dash-counts">
                            <p>@Model.POType</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Vendor Name</div>
                        <div class="dash-counts">
                            <p>@Model.VenderName</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Remarks</div>
                        <div class="dash-counts">
                            <p>@Model.Remarks</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Status</div>
                        <div class="dash-counts">
                            @if (!@Model.IsPOCancelled)
                            {
                                <p>PO Status: <span class="badge badge-soft-success">Active</span></p>
                            }
                            else
                            {
                                <p>PO Status: <span class="badge badge-soft-danger">Cancelled</span></p>
                            }
                            @if (@Model.HasMarkForPayment)
                            {
                                <p>Mark For Payment: <span class="badge badge-soft-success">Yes</span></p>
                            }
                            else
                            {
                                <p>Mark For Payment: <span class="badge badge-soft-danger">No</span></p>
                            }
                            @if (!string.IsNullOrEmpty(@Model.UploadBill))
                            {
                                <p>Bill Attachment: <a href="~/UploadFile/UploadBill/@Model.UploadBill" target="_blank"> View Uploaded Bills</a></p>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Project</div>
                        <div class="dash-counts">
                            <p>@(Model.ProjectName ?? "Not Linked")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-6 col-lg-6 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title"> Ship To:</div>
                        <div class="dash-counts">
                            <p>
                                <pre>@Model.ShipTo</pre>
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-6 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title"> Terms &amp; Conditions:</div>
                        <div class="dash-counts">
                            <p>
                                <pre>@Model.TermsConditions</pre>
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Procurement's Item</h5>
            </div>
            <div class="card-body card-buttons" id="items">

            </div>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Procurement's Payment Release</h5>
            </div>
            <div class="card-body card-buttons" id="paymenttrans">

            </div>


        </div>
    </div>
</div>


@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            var loadpayment = function () {
                $('#paymenttrans').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif" /><h2>Please wait....</h2></div>');
            $.ajax({
                type: 'GET',
                url: '/POPayment/GetPaymentTransByProjID',
                data: { ID: '@POID' },
                success: function (data) {
                    $('#paymenttrans').empty().append(data);
                },
                error: function () {
                    $('#paymenttrans').empty().append('<div class="panel-body"><img src="/Content/Images/img-warning.png" height="50" width="50"/><b>Could not load data. Please click here to reload...</b><button id="btnpayment"> <i class="fa fa-refresh"></i> Reload</button></div>');
                    //$('#gstinv').empty().append('<div class="margin-top-15"><b>Could not load data. Please click here to reload...</b><button id="btngstinv">Reload</button></div>');
                }
            });
        }
            $(document).on('click', "#btnpayment", loadpayment);
            loadpayment();

            //Load PO Items
            var loaditems = function () {
                $('#items').empty().append('<div class="panel-body text-center margin-top-15"><img src="/Content/Images/loading.gif" /><h2>Please wait....</h2></div>');
            $.ajax({
                type: 'GET',
                url: '/POPayment/GetPOItemsByID',
                data: { ID: '@POID' },
                success: function (data) {
                    $('#items').empty().append(data);
                },
                error: function () {
                    $('#items').empty().append('<div class="panel-body"><img src="/Content/Images/img-warning.png" height="50" width="50"/><b>Could not load data. Please click here to reload...</b><button id="btnitems"> <i class="fa fa-refresh"></i> Reload</button></div>');
                    //$('#gstinv').empty().append('<div class="margin-top-15"><b>Could not load data. Please click here to reload...</b><button id="btngstinv">Reload</button></div>');
                }
            });
        }
            $(document).on('click', "#btnitems", loaditems);
            loaditems();
        });

    </script>
}
