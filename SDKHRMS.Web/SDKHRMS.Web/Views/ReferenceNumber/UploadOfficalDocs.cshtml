@model SDKHRMS.Entities.ViewModels.OfficalLetterVM
@{
    ViewBag.Title = "UploadOfficalDocs";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<div class="row">
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Ref No.</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceDetails.RefNumber</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Ref. Issuance Date</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceDetails.RefDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Letter To</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceDetails.LetterTO</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-sm-6 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">

                    <div class="dash-count">
                        <div class="dash-title">Ref Type</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceDetails.RefType</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-8 col-sm-12 col-12 d-flex">
        <div class="card inovices-card w-100">
            <div class="card-body">
                <div class="dash-widget-header">
                    <div class="dash-count">
                        <div class="dash-title">Remarks</div>
                        <div class="dash-counts">
                            <p>@Model.ReferenceDetails.DescORSubject</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="card customer-details-group">
    <div class="card-body">
        @using (Html.BeginForm("UploadOfficalDocs", "ReferenceNumber", FormMethod.Post, new { id = "docs", role = "form", enctype = "multipart/form-data" }))
        {
            <div class="row align-items-center">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
                @Html.HiddenFor(m => m.RefNoID)

                <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                    <div class="customer-details">
                        <div class="d-flex align-items-center">
                            @Html.TextBoxFor(model => model.OfficalLetterAdd.DocName, new { @class = "form-control", @placeholder = "Docs Name", @id = "name", @autocomplete = "off" })
                            @Html.ValidationMessageFor(model => model.OfficalLetterAdd.DocName)
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                    <div class="customer-details">
                        <div class="d-flex align-items-center">
                            @Html.TextBoxFor(m => m.UploadFile, new { @type = "file", @accept = ".pdf,.jpg,.png,.jpeg", @class = "btn btn-warning" })
                            @Html.ValidationMessageFor(m => m.UploadFile)
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                    <div class="customer-details">
                        <div class="d-flex align-items-center">
                            <button type="reset" onclick="location.href='@Url.Action("ReferenceNumberList")'" class="btn btn-primary cancel me-2">Cancel</button>
                            <input type="submit" value="Save" id="save" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>




