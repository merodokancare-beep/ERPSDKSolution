@model SDKHRMS.Entities.ViewModels.ReferenceNumberViewModel
<div id="DataGrid" class="">
    @if (Model.ReferenceModelList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered" id="reftable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle;">
                            Date
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Reference No.
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Reference Type
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Letter To
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Client Name
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Description
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                        @*<th class="text-center" style="vertical-align: middle;">
                                Action
                            </th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReferenceModelList)
                    {
                        <tr>
                            <td class="text-center" style="vertical-align: middle;">
                                @item.RefDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                @if (@item.IsCancelled == "Yes")
                                {
                                    <span class="badge rounded-pill bg-danger">@item.RefNumber</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-success">@item.RefNumber</span>
                                }
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                @item.RefType
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                @item.LetterTO
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                @item.ClientName
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                @item.DescORSubject
                            </td>
                            <td class="text-center pt-4" style="width: 120px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        <div class="dropdown dropdown-action me-3 ">
                                            <a href="#"
                                               class="btn-action-icon bg-primary-light"
                                               data-bs-toggle="dropdown"
                                               aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <ul>
                                                    @if (item.IsCancelled == "No")
                                                    {

                                                        <li>
                                                            <a href="@Url.Action("AddReferenceNumber", new { ID = item.ReferenceID })" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="Edit"> <i class="fe fe-edit-2 me-2"></i>Edit</a>
                                                        </li>
                                                        <li>

                                                            <a href="@Url.Action("UploadOfficalDocs", new { ID = item.ReferenceID })" class="dropdown-item" data-toggle="tooltip" data-placement="bottom"> <i class="fe fe-file-text me-2"></i>Uploads</a>
                                                        </li>
                                                    }
                                                    <li>
                                                        <form action="/ReferenceNumber/CancelledRefNo" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                                            @Html.AntiForgeryToken()
                                                            <a href="@Url.Action("CancelledRefNo", "ReferenceNumber", new { ID = item.ReferenceID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.ReferenceModelList.Count() })" class="RefCancel dropdown-item grid-button" data-toggle="tooltip" data-placement="bottom" data-record="@item.RefNumber">
                                                                @if (@item.IsCancelled == "No")
                                                                {
                                                                    <i class="fe fe-x me-2"></i>
                                                                    <span title="Cancelled reference No.">Cancel</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="fe fe-check me-1"></i>
                                                                    <span title="Active reference No.">Active</span>
                                                                }
                                                            </a>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <a href="javascript:void(0)" class="btn-action-icon bg-light-gray text-dark mb-3 RefID" id="Key_@item.ReferenceID" data-bs-toggle="collapse" data-bs-target="#item_@item.ReferenceID" data-bs-parent="#reftable" data-bs-placement="bottom" title="view">
                                            <i class="fe fe-maximize"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                           
                        </tr>
                        <tr class="collapse" id="item_@item.ReferenceID">
                            <td colspan="7" class="hiddenRow">
                                <div class="no-padding" id="@item.ReferenceID">
                                    @*@item.InvoiceNo*@
                                    @*Partial view*@
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.ReferenceModelList.Count() of @Model.TotalRecords Record(s)

                </div>
                <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/ReferenceNumber/ReferenceNumberList">
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("ReferenceNumberList", new { PageNo = x }))
                </div>*@

            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/configuration/ReferenceNumberList">
                <span class="badge bg-warning text-dark">Showing @Model.ReferenceModelList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("ReferenceNumberList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched </span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
