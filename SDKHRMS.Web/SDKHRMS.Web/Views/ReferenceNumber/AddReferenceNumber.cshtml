@model  SDKHRMS.Entities.ViewModels.ReferenceNumberViewModel
@{
    ViewBag.Title = "AddReferenceNumber";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@{
    List<string> RefType = new List<string> { "Challan", "Letter", "Proforma Invoice", "Purchase Order" };
}
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        <h5>Reference Number</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Configure Reference Number</h5>
            </div>
            <div class="card-body card-buttons">
                @using (Html.BeginForm("addreferencenumber", "referencenumber", FormMethod.Post, new { data_toggle = "validator", @novalidate = true }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    if (@Model.ReferenceDetails != null)
                    {
                        @Html.HiddenFor(m => m.ReferenceDetails.ReferenceID)
                    }
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ReferenceDetails.RefType, new { @class = "control-label required" })
                                @if (@ViewBag.ID != 0)
                                {
                                    @Html.DropDownListFor(m => m.ReferenceDetails.RefType, new SelectList(RefType), "----Select Type----", new { @class = "form-control ddSelect2", @Disabled = "Disabled" })
                                    @Html.HiddenFor(m => m.ReferenceDetails.RefType)
                                }
                                else
                                {
                                    @Html.DropDownListFor(m => m.ReferenceDetails.RefType, new SelectList(RefType), "----Select Type----", new { @class = "form-control ddSelect2" })
                                }
                                @Html.ValidationMessageFor(m => m.ReferenceDetails.RefType)
                            </div>
                        </div>
                        <div class="col-xl-4">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ReferenceDetails.LetterTO, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.ReferenceDetails.LetterTO, new { @class = "form-control datetime-style", autocomplete = "off", @placeholder = "Letter To", @id = "LTo" })
                                @Html.ValidationMessageFor(m => m.ReferenceDetails.LetterTO)
                            </div>
                        </div>
                        <div class="col-xl-4">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ReferenceDetails.RefDate, new { @class = "control-label required" })
                                @if (@ViewBag.ID != 0)
                                {
                                    @Html.TextBoxFor(m => m.ReferenceDetails.RefDate, new { @class = "form-control datetime-style", autocomplete = "off", @placeholder = "Select Date To", @id = "RefDt", @Value = @Model.ReferenceDetails.RefDate.ToString("dd MMM yyyy") })
                                }
                                else
                                {
                                    @Html.TextBoxFor(m => m.ReferenceDetails.RefDate, new { @class = "form-control datetime-style", autocomplete = "off", @placeholder = "Select Date To", @id = "RefDt" })
                                }
                                @Html.ValidationMessageFor(m => m.ReferenceDetails.RefDate)
                            </div>
                        </div>
                        <div class="col-xl-4">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ReferenceDetails.VendorID, new { @class = "control-label required" })
                                @Html.DropDownListFor(m => m.ReferenceDetails.VendorID, new SelectList(@Model.VendorDDList, "VenderID", "VenderName"), "--- Select Client/Vendor Name. ---", new { @class = "form-control ddSelect2", @id = "clientName", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.ReferenceDetails.VendorID)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.ReferenceDetails.DescORSubject, new { @class = "control-label required" })
                                @Html.TextAreaFor(m => m.ReferenceDetails.DescORSubject, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter Reference Description", @style = "resize:none" })
                                @Html.ValidationMessageFor(m => m.ReferenceDetails.DescORSubject)
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("ReferenceNumberList")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#RefDt').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            })
        });
    </script>
}




