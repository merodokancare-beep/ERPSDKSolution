@model SDKHRMS.Entities.ViewModels.PaymentViewModel
<div id="DataGrid">
    @if (Model.PaymentViewList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed ">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align: middle; ">
                            Date
                        </th>
                        <th style="vertical-align: middle; text-align: left; ">
                            Particulars
                        </th>
                        <th  style="vertical-align: middle; text-align: left;">
                            Payment Mode
                        </th>
                        <th class="text-center" style="vertical-align: middle;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PaymentViewList)
                    {
                        <tr>
                            <td class="text-center">
                                @item.PaymentDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <table class="table">
                                    <tbody>
                                        <tr>
                                            <td>
                                                Expense Type:<span class="text-primary"> @item.ExpenseType</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Project:<span class="text-primary"> @item.ProjectName</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Client/Vendor:<span class="text-primary"> @item.VendorName</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Remarks:<span class="text-primary"> @item.Remarks</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td>
                                <table class="table">
                                    <tbody>
                                        <tr>
                                            <td>
                                                Amount:<span class="text-primary"> @item.PaymentAmt.ToString("0.00")</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Mode:<span class="text-primary"> @item.PaymentMode</span>
                                            </td>
                                        </tr>
                                        @if (@item.PaymentMode != "Cash")
                                        {
                                            <tr>
                                                <td>
                                                    Chq/Trans No.:<span class="text-primary"> @item.ChequeTransNo</span>
                                                </td>
                                            </tr>

                                        }

                                    </tbody>
                                </table>
                            </td>


                            @*<td class="text-center">
                                    <a href="@Url.Action("EditPayment", new { PaymentID = item.PaymentID })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray">
                                        <i class="fe fe-edit-2"></i>
                                    </a>
                                </td>*@
                            <td class="text-center" style="width: 100px;">
                                <div style="float: right;">
                                    <div style="float:left; padding-right: 8px;">
                                        @if (@item.PaymentMode != "Cash")
                                        {
                                            if (!string.IsNullOrEmpty(@item.PaymentFile))
                                            {
                                                <a href="~/UploadFile/Payments/@item.PaymentFile" target="_blank" class="btn-action-icon bg-light-gray text-danger"> <i class="fe fe-file"></i></a>
                                            }
                                        }
                                    </div>
                                    <div style="float:left; padding-right: 10px;">
                                        <a href="@Url.Action("EditPayment", new { PaymentID = item.PaymentID, PageNo = Model.PagingInfo.CurrentPage, PageSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm })" data-toggle="tooltip" data-placement="bottom" title="Edit" class="btn-action-icon bg-light-gray text-primary">
                                            <i class="fe fe-edit-2"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            @*<div class="hidden-xs col-md-3 col-sm-3">
                    Showing @Model.PaymentViewList.Count() of @Model.TotalRecords Record(s)

                </div>*@
            @if (@ViewBag.Type == "Received")
            {
                @*<div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/payment/PaymentList">
                        @Html.PageLinks(Model.PagingInfo, x => Url.Action("PaymentList", new { PageNo = x }))
                    </div>*@

                <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/payment/PaymentList">
                    <span class="badge bg-warning text-dark">Showing @Model.PaymentViewList.Count() of @Model.TotalRecords Record(s)</span>
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("PaymentList", new { PageNo = x }))
                </div>
            }
            else
            {
                @*<div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/payment/PaymentReleasedList">
                        @Html.PageLinks(Model.PagingInfo, x => Url.Action("PaymentReleasedList", new { PageNo = x }))
                    </div>*@
                <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/payment/PaymentReleasedList">
                    <span class="badge bg-warning text-dark">Showing @Model.PaymentViewList.Count() of @Model.TotalRecords Record(s)</span>
                    @Html.PageLinks(Model.PagingInfo, x => Url.Action("PaymentReleasedList", new { PageNo = x }))
                </div>
            }



        </div>
    }
    else
    {
        <h3>No record found...</h3>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
