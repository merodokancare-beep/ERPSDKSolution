@model SDKHRMS.Entities.ViewModels.PaymentAdd
@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@{
    List<string> Mode = new List<string> { "Cash", "Cheque", "Netbanking" };
    string mode = @Model.PaymentDetail != null ? @Model.PaymentDetail.PaymentMode : "";
}
@*<link href="~/Content/Plugins/Select2/select2.min.css" rel="stylesheet" />*@
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />

<div class="page-header">
    <div class="content-page-header">
        <h5>Configure Payment</h5>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-body card-buttons">
                @using (Html.BeginForm("EditPayment", "Payment", FormMethod.Post, new { id = "pay", role = "form", enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(m => m.PaymentDetail.PaymentID)
                    @Html.HiddenFor(m => m.PaymentDetail.PaymentType)

                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PaymentDetail.ExpenseTypeID, new { @class = "control-label required" })
                                @Html.DropDownListFor(m => m.PaymentDetail.ExpenseTypeID, new SelectList(Model.ExpenseTypeDDList, "ExpenseTypeID", "ExpenseType"), "----Select Expenses Type----", new { @class = "form-control ddSelect2", id = "exptyp" })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.ExpenseTypeID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Project Name <span class="text-muted">(If Applicable)</span></label>
                                @Html.DropDownListFor(m => m.PaymentDetail.ProjectID, new SelectList(Model.ProjectDDList, "ProjectID", "ProjectName"), "----Select Project Name----", new { @class = "form-control ddSelect2", id = "proj" })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.ProjectID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Client/Vendor Name <span class="text-muted">(If Applicable)</span></label>
                                @Html.DropDownListFor(m => m.PaymentDetail.VendorID, new SelectList(Model.VendorDDList, "VenderID", "VenderName"), "----Select Client/Vendor Name----", new { @class = "form-control ddSelect2", id = "vendor" })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.VendorID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PaymentDetail.PaymentDate, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.PaymentDetail.PaymentDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select Date", @id = "Dt", @Value = @Model.PaymentDetail.PaymentDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.PaymentDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PaymentDetail.PaymentAmt, new { @class = "control-label required" })
                                @Html.TextBoxFor(m => m.PaymentDetail.PaymentAmt, new { @class = "form-control", @autocomplete = "off", @placeholder = "Enter Payment Amount", @Value = @Model.PaymentDetail.PaymentAmt.ToString("0.00") })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.PaymentAmt)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PaymentDetail.PaymentMode, new { @class = "control-label required" })
                                @Html.DropDownListFor(m => m.PaymentDetail.PaymentMode, new SelectList(Mode), "----Select Mode----", new { @class = "form-control ddSelect2", id = "ddmode" })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.PaymentMode)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                @Html.LabelFor(m => m.PaymentDetail.Remarks, new { @class = "control-label required" })
                                @Html.TextAreaFor(m => m.PaymentDetail.Remarks, new { @class = "form-control", autocomplete = "off", @placeholder = "Enter  Payments Remarks", @style = "resize:none" })
                                @Html.ValidationMessageFor(m => m.PaymentDetail.Remarks)
                            </div>
                        </div>
                        <div class="d-none row" id="bankdiv">
                            <div class="col-xl-4">
                                <div class="form-group">
                                    <label class="control-label required">Bank</label>
                                    @Html.DropDownListFor(model => model.PaymentDetail.BankID, new SelectList(Model.BankDDList, "BankID", "BankName"), "-- Select Bank --", new { @class = "form-control auto-focus ddSelect2", @placeholder = "", @autocomplete = "off", @id = "txtbank" })
                                    @Html.ValidationMessageFor(model => model.PaymentDetail.BankID)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group">
                                    <label class="control-label required">Cheque/Transaction No.</label>
                                    @Html.TextBoxFor(model => model.PaymentDetail.ChequeTransNo, new { @class = "form-control auto-focus", @placeholder = "", @autocomplete = "off", @id = "txttransno" })
                                    @Html.ValidationMessageFor(model => model.PaymentDetail.ChequeTransNo)
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.UploadFile, new { @class = "control-label" })<br />
                                    @Html.TextBoxFor(m => m.UploadFile, new { @type = "file", @accept = ".pdf,.jpg,.png,.jpeg", @class = "btn btn-sm btn-primary", @id = "PCC" })
                                    @Html.ValidationMessageFor(m => m.UploadFile)
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="text-end">
                        <button type="reset" onclick="location.href='@Url.Action("PaymentList")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>



