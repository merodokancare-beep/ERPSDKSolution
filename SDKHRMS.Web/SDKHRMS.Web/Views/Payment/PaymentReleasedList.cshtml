@model SDKHRMS.Entities.ViewModels.PaymentViewModel
@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<div class="page-header">
    <div class="content-page-header">
        <h5>Payment Manager</h5>
        <div class="list-btn">
            <ul class="filter-list">
                <li>
                    <a class="btn btn-primary" href="@Url.Action("AddPayment","Payment",new{PayType="Received"})">
                        <i class="fa fa-plus-circle me-2" aria-hidden="true"></i>Add Payment Released
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="card ribbon-wrapper">
            <div class="card-header card-buttons">
                <div class="ribbon ribbon-danger ribbon-left"> Payment Released List <i class="fe fe-arrow-up-right"></i></div>
                <div class="form-group mb-0 row">
                    <div class="col-md-10">
                        <form method="get" action="@Url.Action("PaymentReleasedList")" data-search="true" data-otf-ajax="true" data-otf-target="#DataGrid">
                            <div class="input-group mb-3">
                                <span class="input-group-text" id="basic-addon1"><i class="fe fe-search"></i></span>
                                <input type="text"
                                       id="inputsearch"
                                       class="form-control"
                                       placeholder="Search"
                                       aria-label="Search"
                                       name="searchTerm"
                                       aria-describedby="basic-addon1" />
                                <button class="btn btn-primary" id="search-btn" type="submit">
                                    Search
                                </button>
                                <button onclick="location.href='@Url.Action("PaymentReleasedList")'" type="button" class="btn btn-primary d-none" id="clearSearchBtn">Clear Results</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @Html.Partial("_pvPaymentList", Model)
            </div>
        </div>
    </div>
</div>




