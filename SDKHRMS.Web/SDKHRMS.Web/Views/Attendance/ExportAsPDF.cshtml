@model System.Data.DataTable
@{
    int total_rows = Model.Rows.Count;
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="~/Content/Images/smalllogo.png">
    <title>ExportAsPDF</title>
    <style type="text/css">
        .highlight {
            background-color: #fff;
        }
        /*Table scroll */
        #table-scroll {
            position: relative;
            /*max-width: 600px;*/
            margin: auto;
            overflow: hidden;
            border: 1px solid #d9d9d9;
        }

        #table-wrap {
            width: 100%;
            overflow: auto;
        }

        #table-scroll table {
            width: 100%;
            margin: auto;
            border-collapse: separate;
            border-spacing: 0.5px;
        }

        #table-scroll .colhead {
            padding: 2px 4px;
            border: 1px solid #d9d9d9;
            background: #fff;
            white-space: nowrap;
            vertical-align: top;
            background-color: #d9d9d9;
            border-radius: 0px;
        }

        #table-scroll th, #table-scroll td {
            padding: 2px 4px;
            border: 1px solid #d9d9d9;
            background: #fff;
            white-space: nowrap;
            vertical-align: top;
            border-radius: 0px;
        }

        #table-scroll thead, #table-scroll tfoot {
            background: #f9f9f9;
        }
    </style>
</head>
<body>
    <div class="text-center" style="margin-bottom:15px;">
        <img src="~/Content/Images/LOGOSDK.png" alt="SDK Logo"  width="218px"/>
    </div>
    <div class="col-md-12" style="margin-bottom:15px;">
        <strong class="">Attendance Report for @ViewBag.MonthName, @ViewBag.Year</strong>
    </div>
    <div class="col-md-12 no-padding">

        @if (total_rows != 0)
        {
            <div id="table-scroll" class="table-scroll table-responsive table-bordered">
                <div class="table-wrap">
                    <table class="main-table">
                        <thead>
                            <tr>
                                @foreach (System.Data.DataColumn col in Model.Columns)
                                {
                                    if (col.ColumnName.ToString() == "EmpName")
                                    {
                                <th class="fixed-side text-center" scope="col">Employee Name</th>
                                    }
                                    else
                                    {
                                <th class="colhead text-center" scope="col" style="vertical-align: middle; white-space: nowrap">@col.ColumnName</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow item in Model.Rows)
                            {
                            <tr>
                                @foreach (System.Data.DataColumn col in Model.Columns)
                                    {
                                        if (item[col.ColumnName].ToString() == "H")
                                        {
                                <td class="highlight text-center" style="vertical-align: middle; white-space: nowrap; color: #ff6a00;">H</td>
                                        }
                                        else if (item[col.ColumnName].ToString() == "S")
                                        {
                                <td class="highlight text-center" style="vertical-align: middle; white-space: nowrap; color: #ff6a00;">S</td>
                                        }
                                        else if (col.ColumnName.ToString() == "EmpName")
                                        {
                                <th class="highlight text-left" style="vertical-align: middle; white-space: nowrap;">@item[col.ColumnName]</th>
                                        }
                                        else if (item[col.ColumnName].ToString() == "NR")
                                        {
                                <td class="highlight text-center" style="vertical-align: middle; white-space: nowrap;">NR</td>
                                        }
                                        else if (item[col.ColumnName].ToString() == "Ab")
                                        {
                                <td class="highlight text-center" style="vertical-align: middle; white-space: nowrap;color: #ff0000;">Ab</td>
                                        }
                                        else if (item[col.ColumnName].ToString() == "P")
                                        {
                                <td class="highlight text-center" style="vertical-align: middle; white-space: nowrap;color: #06D94B;">P</td>
                                        }
                                        else
                                        {
                                <td class="text-center" style="vertical-align: middle; white-space: nowrap;color:#97E80C; ">@item[col.ColumnName]</td>
                                        }
                                    }
                            </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12" style="margin-top:20px;">
                <table class="table-condensed">
                    <tr>
                        <td>
                            <strong>Legends: </strong>
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color: #ff0000; "><span style="padding:12px;">AB</span></strong> Absent,
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color: #ff6a00; "><span style="padding:12px;">H</span></strong> Holiday, 
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color: #97E80C"><span style="padding:12px;">Hw</span></strong> Holiday Work, 
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color:#06D94B"><span style="padding:12px;">P</span></strong> Present, 
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc;"><span style="padding:12px;">NR</span></strong>Not Reported, 
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color: #ff6a00; "><span style="padding:12px;">S</span></strong> Sunday, 
                        </td>
                        <td>
                            <strong style="border: 1px solid #cccccc; color: #97E80C; "><span style="padding:12px;">Sw</span></strong> Sunday Work
                        </td>
                    </tr>
                    @*<tr>
                        
                    </tr>*@
                </table>
            </div>
            <div class="col-md-3" style="margin-top:30px;">
                <p>_______________________</p>
                <strong>Authorized Signature</strong>
            </div>
        }
        else
        {
            <h3 class="text-center">No record found...</h3>
        }
    </div>
</body>
</html>
