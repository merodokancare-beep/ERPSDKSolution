@model SDKHRMS.Entities.ViewModels.EmpAttendanceViewModel
@{
    ViewBag.Title = "DateWise Attendance";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/datepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<link href="~/Content/TimePicker/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        <div class="page-title-icon">
            <i class="glyphicon glyphicon-calendar"></i>
        </div>
        <div>
            <div class="page-title-main-text linebreak">
                Attendance Management
            </div>
            <div class="page-title-sub-text">Date-Wise Attendance</div>
        </div>
    </div>
    <div class="page-title-actions">
        @*<div class="btn btn-primary">
                Menu
            </div>*@
    </div>
</div>
<div class="page-content clearfix">
    <div class="col-md-12 well well-sm">
        <div class="col-md-1" style="margin-top:9px;"><strong>Date:</strong></div>
        <div class="col-md-3">
            <input type='text' class="form-control" id="dtpDate" style="color: #555;align-content:center;" value="@ViewBag.AttendanceDate.ToString("dd MMM yyyy")" />
        </div>
        <div class=" col-md-2 pull-right">
            @Html.ActionLink("Monthly Attendance", "MonthwiseAttendanceList", "Attendance", null, new { area = "", @class = "btn btn-sm btn-primary" })
        </div>
    </div>
    <div class=" no-margin-bottom col-md-12 col-lg-12 margin-top20">
        <div class="form-horizontal">
            @Html.Partial("_pvEmpDatewiseAttendance", Model)
        </div>
    </div>

</div>
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datepicker/bootstrap-datetimepicker.min.js"></script>
    <script src="~/Content/TimePicker/bootstrap-timepicker.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $('#dtpDate').datetimepicker({
            format: "dd M yyyy",
            weekStart: 1,
            todayBtn: 1,
            autoclose: 1,
            todayHighlight: 1,
            startView: 2,
            minView: 2,
            forceParse: 0
        })
        $(document).ready(function () {
            //Script for Get Attendance List Based On Date Selected
            $(document).on('change', '#dtpDate', function () {    // for on change
                $('#DataGrid').show();
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("DateWiseAttendance", "Attendance", new { Area = "" })',
                    data: { AttendanceDate: $('#dtpDate').val() },
                    success: function (data) {
                        $('#DataGrid').empty().append(data);
                    }
                })
            })
        });
        $(document).ready(function () {
            for (var i = 0; i < '@Model.ViewEmpAttendanceList.Count()'; i++) {
                $('#editInTime_' + i).hide("fast", "linear");
                $('#editOutTime_' + i).hide("fast", "linear");
                $('#editRemarks_' + i).hide("fast", "linear");
                $('#SaveBtn_' + i).hide("fast", "linear");
                $('#CancelEdit_' + i).hide("fast", "linear");
            }
        });

        $(document).on('click', '.SaveEdit', function (e) {
            e.preventDefault();

            var id = this.id;
            var valID = id.split('_');
            //alert($('#EId_' + valID[1]).val());
            var Url = '@Url.Action("UpdateAttendance", "Attendance", new { Area = "" })';
            var url = Url + "?AttendanceID=" + $('#AId_' + valID[1]).val() + "&EmpID=" + $('#EId_' + valID[1]).val() + "&InTime=" + $('#InTime_' + valID[1]).val() + "&OutTime=" + $('#OutTime_' + valID[1]).val() + "&Remarks=" + $('#Remarks_' + valID[1]).val() + "&AttndDate=" + $('#dtpDate').val();
            window.location = url;
        })

        $(document).on('click', '.editBtn', function () {
            var id = this.id;
            var valID = id.split('_');
            $('#labelInTime_' + valID[1]).attr("display", "none").hide();
            $('#labelOutTime_' + valID[1]).attr("display", "none").hide();
            $('#labelRemarks_' + valID[1]).attr("display", "none").hide();
            $('#edtBtn_' + valID[1]).attr("display", "none").hide();
            $('#editInTime_' + valID[1]).attr("display", "inline-block").show();
            $('#editOutTime_' + valID[1]).attr("display", "inline-block").show();
            $('#editRemarks_' + valID[1]).attr("display", "inline-block").show();

            $('#SaveBtn_' + valID[1]).attr("display", "inline-block").show();
            //$('#SaveBtn_' + valID[1]).show();
            $('#CancelEdit_' + valID[1]).attr("display", "inline-block").show();
        })


        $(document).on('click', '.cancelEdit', function () {
            var id = this.id;
            var valID = id.split('_');

            $('#editInTime_' + valID[1]).attr("display", "none").hide();
            $('#editOutTime_' + valID[1]).attr("display", "none").hide();
            $('#editRemarks_' + valID[1]).attr("display", "none").hide();

            $('#SaveBtn_' + valID[1]).attr("display", "none").hide();
            $('#CancelEdit_' + valID[1]).attr("display", "none").hide();

            $('#labelInTime_' + valID[1]).attr("display", "inline-block").show();
            $('#labelOutTime_' + valID[1]).attr("display", "inline-block").show();
            $('#labelRemarks_' + valID[1]).attr("display", "inline-block").show();
            $('#edtBtn_' + valID[1]).attr("display", "inline-block").show();
        })
        //Datetime Picker
        $('.InTime').timepicker({
            minuteStep: 1,
            secondStep: 1,
            showSeconds: true,
            showMeridian: false,
            defaultTime: false
        });

        $('.OutTime').timepicker({
            minuteStep: 1,
            secondStep: 1,
            showSeconds: true,
            showMeridian: false,
            defaultTime: false
        });
    </script>
}




