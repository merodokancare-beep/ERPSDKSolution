@model List<SDKHRMS.Entities.ViewModels.ChallanItemView>
<div id="DataGrid" class="">
    @if (@Model.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-bordered" style="width:100%" id="ItemTable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align:middle; width:8%">SlNo</th>
                        <th class="text-center" style="vertical-align:middle; width:67%">Item Name</th>
                        <th class="text-center" style="vertical-align: middle; width:25%">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1; }
                    @foreach (var item in @Model)
                    {
                        <tr>
                            <td class="text-center" style="vertical-align:middle">@i</td>
                            <td class="" style="vertical-align:middle">@item.ItemName</td>
                            <td class="text-center" style="vertical-align:middle">@item.Quantity @item.UnitName </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    { 
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched record in not available..</span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
