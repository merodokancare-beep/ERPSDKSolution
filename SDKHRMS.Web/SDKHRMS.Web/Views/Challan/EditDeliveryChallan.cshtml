@model SDKHRMS.Entities.ViewModels.ChallanAdd
@{
    ViewBag.Title = "Delivery Challan";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    int i = 1; int j = 0;
}
<link href="~/Content/Plugins/Select2/newselect2.css" rel="stylesheet" />
<link href="~/Content/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
<div class="page-header">
    <div class="content-page-header">
        <h5>Edit Delivery Challan</h5>
    </div>
</div>

@using (Html.BeginForm("EditDeliveryChallan", "Challan", FormMethod.Post, new { id = "Challan", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(m => m.ChallanKeyModel.ChallanID)
    @Html.HiddenFor(m => m.ChallanKeyModel.CHRefNo)
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body card-buttons">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="control-label">Challan Reference No.: <b>@Model.ChallanKeyModel.CHRefNo</b></label>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Challan Date</label>
                                @Html.TextBoxFor(m => m.ChallanKeyModel.CHDate, new { @class = "form-control", autocomplete = "off", @placeholder = "Select  Date", @id = "chdt", @Value = @Model.ChallanKeyModel.CHDate.ToString("dd MMM yyyy") })
                                @Html.ValidationMessageFor(m => m.ChallanKeyModel.CHDate)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Client Name</label>
                                @Html.DropDownListFor(m => m.ChallanKeyModel.VenderID, new SelectList(@Model.ClientDDList, "VenderID", "VenderName"), "--- Select Client Name---", new { @class = "form-control ddSelect2", @id = "vendor", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.ChallanKeyModel.VenderID)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label required">Consignee To,</label>
                                @Html.TextBoxFor(m => m.ChallanKeyModel.CHToName, new { @class = "form-control", @placeholder = "Enter Designation Name" })
                                @Html.ValidationMessageFor(m => m.ChallanKeyModel.CHToName)
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="control-label">Project Name <span class="text-muted">(If Applicable)</span></label>
                                @Html.DropDownListFor(m => m.ChallanKeyModel.ProjectID, new SelectList(@Model.ProjectDDList, "ProjectID", "ProjectName"), "--- Select Project Name---", new { @class = "form-control ddSelect2", @id = "proj", autocomplete = "false" })
                                @Html.ValidationMessageFor(m => m.ChallanKeyModel.ProjectID)
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group row">
                                <label class="control-label required">Consignee Address </label>
                                @Html.TextAreaFor(m => m.ChallanKeyModel.ClientAddress, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ChallanKeyModel.ClientAddress)
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="form-group col-xl-12"><button class="btn btn-dark btn-sm float-end" type="button" id="addnewitems"><i class="fe fe-plus-circle me-2"></i>Add New Row</button></div>
                    </div>
                    <div class="row">
                        <div class=" col-md-12 ">
                            <table class="table table-bordered table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th class="col-width-25 text-center" style="vertical-align:middle;width:4%">
                                            Sl
                                        </th>
                                        <th class="col-width-400 text-center" style="vertical-align: middle; width: 20%">
                                            Item Name
                                        </th>
                                        <th class="col-width-100 text-center" style="vertical-align: middle; width: 9%">
                                            Quantity
                                        </th>
                                        <th class="col-width-200 text-center" style="vertical-align: middle; width: 13%">
                                            Unit
                                        </th>
                                        <th class="col-width-25 text-center" style="vertical-align: middle; width: 4%">
                                            Action
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="itemtable">
                                    @if (@Model.ChallanItemList == null)
                                    {
                                        <tr class="member-data-row">
                                            <td class="slno text-center" style="vertical-align:middle;">1</td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextAreaFor(m => m.ChallanItemList[0].ItemName, new { @class = "form-control itemname", autocomplete = "off", @placeholder = "Item Name" })
                                                @Html.ValidationMessageFor(m => m.ChallanItemList[0].ItemName)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                @Html.TextBoxFor(m => m.ChallanItemList[0].Quantity, new { @class = "form-control qty", autocomplete = "off", @placeholder = "Quantity" })
                                                @Html.ValidationMessageFor(m => m.ChallanItemList[0].Quantity)
                                            </td>
                                            <td class="align-middle text-center">
                                                @Html.DropDownListFor(model => model.ChallanItemList[0].UnitID, new SelectList(Model.UnitDDList, "UnitID", "UnitName"), "--Select Unit--", new { @class = "form-control unit" })
                                                @Html.ValidationMessageFor(m => m.ChallanItemList[0].UnitID)
                                            </td>
                                            <td class="text-center" style="vertical-align:middle;">
                                                <i class="fa fa-trash rowremove btn-sm btn-danger" title="Remove"></i>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in @Model.ChallanItemList)
                                        {
                                            <tr class="member-data-row">
                                                <td class="text-center slno" style="vertical-align:middle;">@i</td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextAreaFor(m => m.ChallanItemList[i - 1].ItemName, new { @class = "form-control itemname", autocomplete = "off", @placeholder = "Item Name" })
                                                    @Html.ValidationMessageFor(m => m.ChallanItemList[i - 1].ItemName, null, new { @class = "item-span" })
                                                </td>

                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.TextBoxFor(m => m.ChallanItemList[i - 1].Quantity, new { @class = "form-control qty", autocomplete = "off", @placeholder = "Quantity", @data_index = @j })
                                                    @Html.ValidationMessageFor(m => m.ChallanItemList[i - 1].Quantity, null, new { @class = "qty-span" })
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    @Html.DropDownListFor(model => model.ChallanItemList[i - 1].UnitID, new SelectList(Model.UnitDDList, "UnitID", "UnitName", @Model.ChallanItemList[i - 1].UnitID), "--Select Unit--", new { @class = "form-control unit" })
                                                    @Html.ValidationMessageFor(m => m.ChallanItemList[i - 1].UnitID, null, new { @class = "unit-span" })
                                                </td>
                                                <td class="text-center slno" style="vertical-align:middle;">
                                                    <i class="fa fa-trash rowremove btn-sm btn-danger" title="Remove"></i>
                                                </td>
                                            </tr>
                                            i++; j++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xl-12">
                        <div class="form-group row">
                            <label class="control-label required">Remarks </label>
                            @Html.TextAreaFor(m => m.ChallanKeyModel.Remarks, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ChallanKeyModel.Remarks)
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="reset" onclick="location.href='@Url.Action("DeliveryChallanList")'" class="btn btn-primary cancel me-2">Cancel</button>
                        <input type="submit" value="Save" id="save" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
@section Scripts{
    <script src="~/Content/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script src="~/Scripts/bootstrap-autocomplete.js"></script>
    <script src="~/Content/Plugins/Select2/select2.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            $('.ddSelect2').select2({ width: '100%' });
            $('#chdt').datetimepicker({
                theme: 'light',
                format: 'd M Y',
                timepicker: false,
                scrollInput: false
                /*minDate: 0*/
            })
            var GetUnitDD = function (indexval) {
                //alert(indexval);
                $.ajax({
                    type: 'GET',
                    url: '/Challan/GetUnitDDList',
                    datatype: 'json',
                    success: function (data) {
                        $('#ChallanItemList_' + indexval + '__UnitID').empty();
                        $('#ChallanItemList_' + indexval + '__UnitID').append('<option value="">---Select Unit---</option>');
                        $.each(data, function (i, item) {
                            $('#ChallanItemList_' + indexval + '__UnitID').append('<option value="' + item.UnitID + '">' + item.UnitName + '</option>');
                        });
                        $('#ChallanItemList_' + indexval + '__UnitID').val("");
                    },
                    //error: function (ex) {
                    //    alert('Failed to retrieve data.' + ex);
                    //}
                })
            }
            //Function for Add New Rows
            var addotherrows = function () {
                var count = $(".member-data-row").length;
                var index = count;
                var slno = count + 1;
                $("#itemtable").append('<tr class="member-data-row">' +
                    '<td class="align-middle text-center slno">' + slno + '</td>'

                    + '<td>'
                    + '<textarea autocomplete="off" class="form-control item" cols="20" data-val="true" data-val-required="The Item Name field is required." id="ChallanItemList_' + index + '__ItemName" name="ChallanItemList[' + index + '].ItemName" placeholder="Item Name" rows="2"></textarea>'
                    + '<span class="field-validation-valid item-span" data-valmsg-for="ChallanItemList[' + index + '].ItemName" data-valmsg-replace="true"></span>'
                    + '</td>'


                    + '<td class="align-middle text-center">'
                    + '<input autocomplete="off" class="form-control qty" data-val="true" data-val-number="The field Qty must be a number." data-val-required="The Qty field is required." id="ChallanItemList_' + index + '__Quantity" name="ChallanItemList[' + index + '].Quantity" placeholder="Quantity" type="text" value=""/>'
                    + '<span class="field-validation-valid qty-span" data-valmsg-for="ChallanItemList[' + index + '].Quantity" data-valmsg-replace="true"></span>'
                    + '</td>'

                    + '<td class="align-middle text-center">'
                    + '<select class="form-control unit" data-val="true" data-val-number="The field Unit Name must be a number." data-val-required="The Unit Name field is required." id="ChallanItemList_' + index + '__UnitID" name="ChallanItemList[' + index + '].UnitID"></select>'
                    + '<span class="unit-span field-validation-valid" data-valmsg-for="ChallanItemList[' + index + '].UnitID" data-valmsg-replace="true"></span>'
                    + '</td>'

                    + '<td class="align-middle text-center">'
                    + '<i class="fa fa-trash rowremove btn-sm btn-danger" title="Remove"></i>'
                    + '</td >'
                )

                var $form = $("form");
                $form.unbind();
                $form.data("validator", null);
                $.validator.unobtrusive.parse(document);
                GetUnitDD(index);
            };
            $(document).on('click', '#addnewitems', addotherrows);
            //Function For Remove Row
            $(document).on("click", ".rowremove", function () {
                $(this).closest("tr").remove();
                var new_index = 0;
                //var add_new_index = new_index + 1;
                $('.member-data-row').each(function () {
                    $(this).find('td.slno').html(new_index + 1);

                    $(this).find('textarea.item').attr('id', 'ChallanItemList_' + new_index + '__ItemName');
                    $(this).find('textarea.item').attr('name', 'ChallanItemList[' + new_index + '].ItemName');
                    $(this).find('span.item-span').attr('data-valmsg-for', 'ChallanItemList[' + new_index + '].ItemName');

                    $(this).find('input.qty').attr('id', 'ChallanItemList_' + new_index + '__Quantity');
                    $(this).find('input.qty').attr('name', 'ChallanItemList[' + new_index + '].Quantity');
                    $(this).find('span.qty-span').attr('data-valmsg-for', 'ChallanItemList[' + new_index + '].Quantity');

                    $(this).find('select.unit').attr('id', 'ChallanItemList_' + new_index + '__UnitID');
                    $(this).find('select.unit').attr('name', 'ChallanItemList[' + new_index + '].UnitID');
                    $(this).find('span.unit-span').attr('data-valmsg-for', 'ChallanItemList[' + new_index + '].UnitID');
                    new_index++;
                    //add_new_index++;
                })
            });
        });

    </script>
}