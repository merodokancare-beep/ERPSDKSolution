@model SDKHRMS.Entities.ViewModels.DeliveryChallanVM
<div id="DataGrid" class="">
    @if (Model.ChallanKeyList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed table-bordered" id="purtable">
                <thead>
                    <tr>
                        <th class="text-center" style="vertical-align:middle;width:55%">
                            Challan Details
                        </th>
                        <th class="text-center" style="vertical-align:middle;width:35%">
                            Consignee Details
                        </th>
                        <th class="text-center" style="vertical-align:middle;width:10%">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ChallanKeyList)
                    {
                        <tr>
                            <td class="">
                                <div class="row">
                                    <div class="col-md-9">
                                        @if (!item.IsCancel)
                                        {
                                            <span class="badge badge-soft-success text-dark rounded-pill">Reference No.: <b>@item.CHRefNo</b></span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-danger text-dark rounded-pill">Reference No.: <b>@item.CHRefNo</b></span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        Date: <b>@item.CHDate.ToString("dd MMM yyyy")</b>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        Client Name: <b>@item.VendorName</b>
                                    </div>
                                    <div class="col-md-6">
                                        Project Name: @if (string.IsNullOrEmpty(item.ProjectName))
                                        {
                                            <b class="text-danger"> Not Linked</b>
                                        }
                                        else
                                        {
                                            <b> @item.ProjectName</b>
                                        }
                                    </div>
                                </div>
                                Remarks: <b>@item.Remarks</b>
                            </td>
                            <td class="">
                                <b>To,</b><br />
                                <b>@item.CHToName</b><br />
                                <b>@item.ClientAddress</b>
                            </td>
                            <td class="text-center" style="vertical-align:middle;">
                                <div class="row">
                                    <div class="col-md-6">
                                        <a href="/challan/ViewDeliveryChallan?id=@item.ChallanID" class="btn-action-icon bg-light-gray" title="View Challan Details" target="_blank">
                                            <i class="fe fe-eye"></i>
                                        </a>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="dropdown dropdown-action me-3 ">
                                            <a href="#"
                                               class="btn-action-icon bg-primary-light"
                                               data-bs-toggle="dropdown"
                                               aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <ul>
                                                    <li>
                                                        <a href="@Url.Action("EditDeliveryChallan", new { id = item.ChallanID})" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="Edit">
                                                            <i class="fe fe-edit-2 me-2"></i> Edit
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form action="/challan/CancelledChallan" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("id", (string)item.ChallanID)
                                                            <a href="@Url.Action("CancelledChallan", "challan", new {Area="", ID = item.ChallanID })" class="RefCancel dropdown-item grid-button" data-toggle="tooltip" data-placement="bottom" title="Cancel/Active Challan" data-record="@item.CHRefNo">
                                                                @if (!@item.IsCancel)
                                                                {
                                                                    <i class="fe fe-x me-2"></i>
                                                                    <span title="Cancelled reference No."> Cancel</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="fe fe-check me-2"></i>
                                                                    <span title="Cancelled reference No."> Active</span>
                                                                    <i class="fe fe-check text-success"></i>
                                                                }
                                                            </a>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <a href="/challan/PrintDeliveryChallan?id=@item.ChallanID" class="dropdown-item " data-toggle="tooltip" data-placement="bottom" title="Generate Challan">
                                                            <i class="fe fe-download me-2"></i> Download
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="visible-lg visible-md visible-sm visible-xs col-lg-12 col-sm-12 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/challan/DeliveryChallanList">
                <span class="badge bg-warning text-dark">Showing @Model.ChallanKeyList.Count() of @Model.TotalRecords Record(s)</span>
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("DeliveryChallanList", new { PageNo = x }))
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <img src="~/Content/Images/no_record.png" /><br />
            <span class="text-muted">No records available or your searched record in not available..</span>
        </div>
    }
    @*error message*@
    <div id="ErrMsg" style="display:none;">
        <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
    </div>
</div>
