    <!-- Sidebar Toggle: Direct DOM control to ensure collapse works regardless of CSS specificity -->
    <script>
    (function () {
        var SIDEBAR_FULL = 240;
        var SIDEBAR_MINI = 80;
        var isCollapsed = false;

        function isMobile() {
            return window.innerWidth < 992;
        }

        /* ── Desktop sidebar collapse/expand ── */
        function collapseSidebar() {
            if (isMobile()) return;  // let mobile_btn / script.js handle mobile

            var sidebar = document.getElementById('sidebar');
            var pageWrapper = document.querySelector('.page-wrapper');
            var headerLeft = document.querySelector('.header-left');
            var logoNormal = document.querySelector('.logo-normal');
            var logoSmall = document.querySelector('.logo-small');
            var toggleIcon = document.querySelector('#toggle_btn i');

            if (!sidebar) return;

            if (!isCollapsed) {
                // Collapse to icon strip
                sidebar.style.left   = '';
                sidebar.style.width  = SIDEBAR_MINI + 'px';
                if (pageWrapper) pageWrapper.style.marginLeft = SIDEBAR_MINI + 'px';
                if (headerLeft) {
                    headerLeft.style.width    = SIDEBAR_MINI + 'px';
                    headerLeft.style.minWidth = SIDEBAR_MINI + 'px';
                    headerLeft.style.maxWidth = SIDEBAR_MINI + 'px';
                    headerLeft.style.padding  = '0 12px';
                    headerLeft.style.borderRight = 'none';
                }
                if (logoNormal) logoNormal.style.display = 'none';
                if (logoSmall)  logoSmall.style.display  = 'block';
                if (toggleIcon) toggleIcon.style.transform = 'rotate(90deg)';

                document.querySelectorAll('.sidebar-menu ul li a span:not(.menu-arrow)').forEach(function(el){ el.style.display = 'none'; });
                document.querySelectorAll('.sidebar-menu .menu-title').forEach(function(el){ el.style.display = 'none'; });

                document.body.classList.add('mini-sidebar');
                isCollapsed = true;
            } else {
                // Expand to full width
                sidebar.style.left   = '';
                sidebar.style.width  = SIDEBAR_FULL + 'px';
                if (pageWrapper) pageWrapper.style.marginLeft = SIDEBAR_FULL + 'px';
                if (headerLeft) {
                    headerLeft.style.width       = '240px';
                    headerLeft.style.minWidth    = '240px';
                    headerLeft.style.maxWidth    = '240px';
                    headerLeft.style.padding     = '0 14px 0 16px';
                    headerLeft.style.borderRight = '1px solid rgba(255,255,255,0.08)';
                }
                if (logoNormal) logoNormal.style.display = 'block';
                if (logoSmall)  logoSmall.style.display  = 'none';
                if (toggleIcon) toggleIcon.style.transform = 'rotate(0deg)';

                document.querySelectorAll('.sidebar-menu ul li a span:not(.menu-arrow)').forEach(function(el){ el.style.display = ''; });
                document.querySelectorAll('.sidebar-menu .menu-title').forEach(function(el){ el.style.display = ''; });

                document.body.classList.remove('mini-sidebar');
                isCollapsed = false;
            }
        }

        /* ── On window resize: reset inline styles if crossing 992px ── */
        window.addEventListener('resize', function () {
            var sidebar     = document.getElementById('sidebar');
            var pageWrapper = document.querySelector('.page-wrapper');
            var headerLeft  = document.querySelector('.header-left');
            var logoNormal  = document.querySelector('.logo-normal');
            var logoSmall   = document.querySelector('.logo-small');

            if (isMobile()) {
                // Reset everything — CSS media query takes over
                if (sidebar) { sidebar.style.width = ''; sidebar.style.left = ''; }
                if (pageWrapper) pageWrapper.style.marginLeft = '';
                if (headerLeft) { headerLeft.style.width = ''; headerLeft.style.minWidth = ''; headerLeft.style.maxWidth = ''; headerLeft.style.padding = ''; headerLeft.style.borderRight = ''; }
                if (logoNormal) logoNormal.style.display = '';
                if (logoSmall)  logoSmall.style.display  = '';
                isCollapsed = false;
                document.body.classList.remove('mini-sidebar');
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            /* Apply transitions AFTER initial layout settles */
            setTimeout(function () {
                var sidebar     = document.getElementById('sidebar');
                var pageWrapper = document.querySelector('.page-wrapper');
                var headerLeft  = document.querySelector('.header-left');
                if (!isMobile()) {
                    if (sidebar) sidebar.style.transition = 'width 0.25s cubic-bezier(0.4, 0, 0.2, 1), left 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                    if (pageWrapper) pageWrapper.style.transition = 'margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1)';
                    if (headerLeft) headerLeft.style.transition = 'width 0.25s cubic-bezier(0.4, 0, 0.2, 1)';
                }
            }, 50);

            /* Desktop: collapse/expand on toggle_btn click */
            var toggleBtn = document.getElementById('toggle_btn');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (!isMobile()) collapseSidebar();
                });
            }

            /* Desktop hover expand */
            var sidebar = document.getElementById('sidebar');
            if (sidebar) {
                sidebar.addEventListener('mouseenter', function () {
                    if (isMobile() || !isCollapsed) return;
                    sidebar.style.width = SIDEBAR_FULL + 'px';
                    document.querySelectorAll('.sidebar-menu ul li a span:not(.menu-arrow)').forEach(function(el){ el.style.display = ''; });
                    document.querySelectorAll('.sidebar-menu .menu-title').forEach(function(el){ el.style.display = ''; });
                });
                sidebar.addEventListener('mouseleave', function () {
                    if (isMobile() || !isCollapsed) return;
                    sidebar.style.width = SIDEBAR_MINI + 'px';
                    document.querySelectorAll('.sidebar-menu ul li a span:not(.menu-arrow)').forEach(function(el){ el.style.display = 'none'; });
                    document.querySelectorAll('.sidebar-menu .menu-title').forEach(function(el){ el.style.display = 'none'; });
                });
            }
        });
    })();
    </script>
</body>
</html>
