                                <img src="@Model.utblEmpPersonalInfoKey.PhotoThumb" class="img-circle img-thumbnail img-preview" style="width: 140px; height: 140px;" />
                            }
                            else
                            {
                                <img src="~/Content/image/no-dp.png" class="img-circle img-thumbnail img-preview" style="width: 140px; height: 140px;" />
                            }
