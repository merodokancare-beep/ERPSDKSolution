@model SDKHRMS.Entities.ViewModels.EmpManageViewModel
@{
    List<string> Gender = new List<string> { "Male", "Female", "Transgender" };
    List<string> MaritalStatus = new List<string> { "Single", "Married", "Divorced" };
    List<string> BloodGroup = new List<string> { "A+(ve)", "A-(ve)", "B+(ve)", "B-(ve)", "O+(ve)", "O-(ve)", "AB+(ve)", "AB-(ve)" };
    List<string> Nationality = new List<string> { "Indian", "Nepalese", "Bhutanese", "Other" };
    List<string> Religion = new List<string> { "Buddhism", "Christianity", "Hinduism", "Islam", "Jainism", "Sikhism" };

    ViewBag.Title = "Employee:Edit Employee";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<link href="~/Content/Plugins/Cropper/cropper.min.css" rel="stylesheet" />
<link href="~/Content/datepicker/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<div class="page-title-wrapper">
    <div class="page-title-heading text-primary">
        <div class="page-title-icon">
            <i class="glyphicon glyphicon-user"></i>
        </div>
        <div>
            <div class="page-title-main-text linebreak">
                Employee Manage
            </div>
            <div class="page-title-sub-text">Employee Edit Details</div>
        </div>
    </div>
    <div class="page-title-actions">
    </div>
</div>
@using (Html.BeginForm())
    {
<div class="page-content clearfix">
   
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        @Html.HiddenFor(m=>m.utblEmpPersonalInfoKey.EmployeeID)
        @*@Html.HiddenFor(m => m.utblEmpPersonalInfoKey.PhotoNormal)
        @Html.HiddenFor(m => m.utblEmpPersonalInfoKey.PhotoThumb)*@
        <div class="">
