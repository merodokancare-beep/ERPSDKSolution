@model SDKHRMS.Entities.ViewModels.EmpManageVM
<div id="DataGrid" class="col-md-12">
    @if (Model.empList.Count() > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-condensed">
                <tbody>
                    @foreach (var item in Model.empList)
                    {
                        <tr>
                            <td>
                                <div class="pull-left">
                                    @if (!string.IsNullOrEmpty(@item.PhotoThumb))
                                    {
                                        <img src="@item.PhotoThumb" class="img-rounded image-thumb" style="width: 80px; height: 95px;" />
                                    }
                                    else
                                    {
                                        <img src="~/Content/Images/NoIcon.jpg" class="img-rounded image-thumb" style="width: 80px; height: 95px;" />
                                    }
                                </div>
                                <div class="pull-left grid-user-info">
                                    <strong class="page-title-main-text">@Html.DisplayFor(modelItem => item.EmpName)</strong><br />
                                    User Name / Email: @Html.DisplayFor(modelItem => item.Email) <br />
                                    Phone No: @Html.DisplayFor(modelItem => item.PhoneNumber)<br />
                                    @*User Role: @Html.DisplayFor(modelItem => item.Gender)*@
                                    Gender: @Html.DisplayFor(modelItem => item.Gender)<br />
                                    @if (item.IsActive == true)
                                    {
                                        <span class="page-title-main-text">User is Active</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">User is Disabled</span>
                                    }
                                </div>
                            </td>
                            <td class="text-center gird-action">
                                <div class="pull-right">
                                    <div>
                                        <form method="get" action="@Url.Action("EmpEdit", "EmpManage")" data-otf-ajax="true" data-otf-target="#DataGrid" style="display:inline-block">
                                            @Html.Hidden("EmployeeID", item.EmployeeID)
                                            <a class="btn btn-default btn-xs grid-button" title="Edit Details" name="@item.EmpName" href="@Url.Action("EmpEdit", "EmpManage", new { EmployeeID = item.EmployeeID })">
                                                <small> <i class="glyphicon glyphicon-edit text-primary"></i>&nbsp; Edit</small>
                                            </a>
                                        </form>
                                    </div>
                                    <div>
                                        <br />
                                        @*<form action="Account/Delete" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                                @Html.AntiForgeryToken()
                                                <a href="@Url.Action("Delete", new { id = item.Id, PgNo = Model.PagingInfo.CurrentPage, PgSize = Model.PagingInfo.ItemsPerPage, SearchTerm=ViewBag.SearchTerm, ListCount = Model.UserList.Count() })" class="delete btn btn-default btn-xs grid-button" data-toggle="tooltip" data-placement="bottom" title="Delete" data-record="@item.ProfileName">
                                                    <i class="glyphicon glyphicon-trash text-danger"></i> Delete
                                                </a>
                                            </form>*@
                                    </div>
                                    <div>
                                        <form action="EmpManage/DisableUser" method="post" data-otf-ajax="true" data-otf-target="#DataGrid">
                                            @Html.AntiForgeryToken()
                                            <a href="@Url.Action("DisableUser", new { id = item.UserID, PgNo = Model.PagingInfo.CurrentPage, PgSize = Model.PagingInfo.ItemsPerPage, SearchTerm = ViewBag.SearchTerm, ListCount = Model.empList.Count() })" class="disable btn btn-default btn-xs grid-button" data-toggle="tooltip" data-placement="bottom" title="Disable User" data-record="@item.EmpName">
                                                @if (item.IsActive)
                                                {
                                                    <i class="glyphicon glyphicon-lock text-success"></i>
                                                    <span>Disable</span>
                                                }
                                                else
                                                {
                                                    <i class="glyphicon glyphicon-lock text-danger"></i>
                                                    <span>Enable</span>
                                                }
                                            </a>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ns-grid-pager" data-otf-target="#DataGrid">
            <div class="hidden-xs col-md-3 col-sm-3">
                @Model.PagingInfo.TotalItems Record(s)
            </div>
            <div class="visible-lg visible-md visible-sm visible-xs col-md-9 col-sm-9 ns-pagination" data-otf-target="#DataGrid" data-otf-actionlink="/EmpManage/EmpList">
                @Html.PageLinks(Model.PagingInfo, x => Url.Action("EmpList", "EmpManage", new { PageNo = x, PageSize = Model.PagingInfo.ItemsPerPage }))
            </div>
        </div>
    }
    else
    {
        <h3>No record(s) found...</h3>
    }
</div>

@*error message*@
<div id="ErrMsg" style="display:none;">
    <input type="hidden" id="ErrMsgHiddenField" name="ErrMsg" value="@TempData["ErrMsg"]" />
</div>
